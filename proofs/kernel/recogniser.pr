all [b0, cs, b1, b2]: succeeds r_opaque_short_path_t_(?b0, ?cs, ?b1) &
 succeeds r_opaque_short_path_t_(?b0, ?cs, ?b2) => ?b1 = ?b2,
assume(succeeds r_opaque_short_path_t_(?b0, ?cs, ?b1) &
  succeeds r_opaque_short_path_t_(?b0, ?cs, ?b2),
 [def succeeds r_opaque_short_path_t_(?b0, ?cs, ?b1) by completion,
  def succeeds r_opaque_short_path_t_(?b0, ?cs, ?b2) by completion,
  cases([
   case(?b0 = true & succeeds r_segment_truth(?cs, ?b1),
     [cases([
      case(?b0 = true & succeeds r_segment_truth(?cs, ?b2),
        [succeeds r_segment_truth(?cs, ?b1) &
        succeeds r_segment_truth(?cs, ?b2) =>
        ?b1 = ?b2 by lemma(segment_truth:functional),
         ?b1 = ?b2]),
      case(?b0 = false & ?b2 = false,
        [ff])],
      ?b1 = ?b2)]),
   case(?b0 = false & ?b1 = false,
     [cases([
      case(?b0 = true & succeeds r_segment_truth(?cs, ?b2),
        [ff]),
      case(?b0 = false & ?b2 = false,
        [?b1 = ?b2])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* opaque_short_path_t/2 itself, which dispatches on the path rather than on
   a verdict: the empty path is no redirector token, and anything else is
   decided by its first character and the segment behind it. */

:- lemma(opaque_short_path:boolean,
all [path, b]: succeeds r_opaque_short_path_t(?path, ?b) =>
 ?b = true \/ ?b = false,
assume(succeeds r_opaque_short_path_t(?path, ?b),
 [def succeeds r_opaque_short_path_t(?path, ?b) by completion,
  cases(?path = [] & ?b = false,
   [?b = true \/ ?b = false],
   ex [c, cs, s]: ?path = [?c|?cs] & succeeds r_cond_t(slash, ?c, ?s) &
     succeeds r_opaque_short_path_t_(?s, ?cs, ?b),
   [exist([c, cs, s], ?path = [?c|?cs] & succeeds r_cond_t(slash, ?c, ?s) &
      succeeds r_opaque_short_path_t_(?s, ?cs, ?b),
     [?b = true \/ ?b = false by lemma(opaque_short_path_t_:boolean)],
     ?b = true \/ ?b = false)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(opaque_short_path:functional,
all [path, b1, b2]: succeeds r_opaque_short_path_t(?path, ?b1) &
 succeeds r_opaque_short_path_t(?path, ?b2) => ?b1 = ?b2,
assume(succeeds r_opaque_short_path_t(?path, ?b1) &
  succeeds r_opaque_short_path_t(?path, ?b2),
 [def succeeds r_opaque_short_path_t(?path, ?b1) by completion,
  def succeeds r_opaque_short_path_t(?path, ?b2) by completion,
  cases(?path = [] & ?b1 = false,
   [cases(?path = [] & ?b2 = false,
     [?b1 = ?b2],
     ex [c, cs, s]: ?path = [?c|?cs] & succeeds r_cond_t(slash, ?c, ?s) &
       succeeds r_opaque_short_path_t_(?s, ?cs, ?b2),
     [exist([c2, cs2, s2], ?path = [?c2|?cs2] &
        succeeds r_cond_t(slash, ?c2, ?s2) &
        succeeds r_opaque_short_path_t_(?s2, ?cs2, ?b2),
       [ff],
       ?b1 = ?b2)],
     ?b1 = ?b2)],
   ex [c, cs, s]: ?path = [?c|?cs] & succeeds r_cond_t(slash, ?c, ?s) &
     succeeds r_opaque_short_path_t_(?s, ?cs, ?b1),
   [exist([c1, cs1, s1], ?path = [?c1|?cs1] &
      succeeds r_cond_t(slash, ?c1, ?s1) &
      succeeds r_opaque_short_path_t_(?s1, ?cs1, ?b1),
     [cases(?path = [] & ?b2 = false,
       [ff],
       ex [c, cs, s]: ?path = [?c|?cs] & succeeds r_cond_t(slash, ?c, ?s) &
         succeeds r_opaque_short_path_t_(?s, ?cs, ?b2),
       [exist([c2, cs2, s2], ?path = [?c2|?cs2] &
          succeeds r_cond_t(slash, ?c2, ?s2) &
          succeeds r_opaque_short_path_t_(?s2, ?cs2, ?b2),
         [?c1 = ?c2,
          ?cs1 = ?cs2,
          succeeds r_cond_t(slash, ?c1, ?s2),
          succeeds r_cond_t(slash, ?c1, ?s1) &
            succeeds r_cond_t(slash, ?c1, ?s2) =>
            ?s1 = ?s2 by lemma(cond:functional),
          ?s1 = ?s2,
          succeeds r_opaque_short_path_t_(?s1, ?cs1, ?b2),
          succeeds r_opaque_short_path_t_(?s1, ?cs1, ?b1) &
            succeeds r_opaque_short_path_t_(?s1, ?cs1, ?b2) =>
            ?b1 = ?b2 by lemma(opaque_short_path_t_:functional),
          ?b1 = ?b2],
         ?b1 = ?b2)],
       ?b1 = ?b2)],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* The two named sets of hosts: the services everyone shortens through, and
   the `l.' and `go.' subdomains a publisher runs its own redirector on. The
   long table is quoted here exactly as the mirror holds it, which is how the
   proof is made to speak about the table the code reads rather than about a
   copy of it. */

:- lemma(generic_host:boolean,
all [host, b]: succeeds r_generic_host_t(?host, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_generic_host_t(?host, ?b),
 [def succeeds r_generic_host_t(?host, ?b) by completion,
  ?b = true \/ ?b = false by lemma(memb:boolean)],
 ?b = true \/ ?b = false)
).

:- lemma(generic_host:functional,
all [host, b1, b2]: succeeds r_generic_host_t(?host, ?b1) &
 succeeds r_generic_host_t(?host, ?b2) => ?b1 = ?b2,
assume(succeeds r_generic_host_t(?host, ?b1) &
  succeeds r_generic_host_t(?host, ?b2),
 [def succeeds r_generic_host_t(?host, ?b1) by completion,
  def succeeds r_generic_host_t(?host, ?b2) by completion,
  succeeds r_memb(?host,
        [
        [0x62,0x69,0x74,0x2e,0x6c,0x79],               % bit.ly
        [0x62,0x75,0x66,0x66,0x2e,0x6c,0x79],          % buff.ly
        [0x64,0x6c,0x76,0x72,0x2e,0x69,0x74],          % dlvr.it
        [0x66,0x2e,0x6d,0x74,0x72,0x2e,0x63,0x6f,0x6f,0x6c], % f.mtr.cool
        [0x69,0x66,0x74,0x2e,0x74,0x74],               % ift.tt
        [0x6c,0x6e,0x6b,0x64,0x2e,0x69,0x6e],          % lnkd.in
        [0x6f,0x77,0x2e,0x6c,0x79],                    % ow.ly
        [0x70,0x75,0x6c,0x73,0x65,0x2e,0x6c,0x79],     % pulse.ly
        [0x73,0x68,0x6f,0x72,0x74,0x75,0x72,0x6c,0x2e,0x61,0x74], % shorturl.at
        [0x74,0x2e,0x63,0x6f],                         % t.co
        [0x74,0x69,0x6e,0x79,0x75,0x72,0x6c,0x2e,0x63,0x6f,0x6d], % tinyurl.com
        [0x74,0x72,0x69,0x62,0x2e,0x61,0x6c],          % trib.al
        [0x74,0x77,0x70,0x2e,0x61,0x69],               % twp.ai
        [0x75,0x72,0x6c,0x7a,0x2e,0x66,0x72],          % urlz.fr
        [0x79,0x6f,0x75,0x74,0x75,0x2e,0x62,0x65]      % youtu.be
       ], ?b1) &
        succeeds r_memb(?host,
        [
        [0x62,0x69,0x74,0x2e,0x6c,0x79],               % bit.ly
        [0x62,0x75,0x66,0x66,0x2e,0x6c,0x79],          % buff.ly
        [0x64,0x6c,0x76,0x72,0x2e,0x69,0x74],          % dlvr.it
        [0x66,0x2e,0x6d,0x74,0x72,0x2e,0x63,0x6f,0x6f,0x6c], % f.mtr.cool
        [0x69,0x66,0x74,0x2e,0x74,0x74],               % ift.tt
        [0x6c,0x6e,0x6b,0x64,0x2e,0x69,0x6e],          % lnkd.in
        [0x6f,0x77,0x2e,0x6c,0x79],                    % ow.ly
        [0x70,0x75,0x6c,0x73,0x65,0x2e,0x6c,0x79],     % pulse.ly
        [0x73,0x68,0x6f,0x72,0x74,0x75,0x72,0x6c,0x2e,0x61,0x74], % shorturl.at
        [0x74,0x2e,0x63,0x6f],                         % t.co
        [0x74,0x69,0x6e,0x79,0x75,0x72,0x6c,0x2e,0x63,0x6f,0x6d], % tinyurl.com
        [0x74,0x72,0x69,0x62,0x2e,0x61,0x6c],          % trib.al
        [0x74,0x77,0x70,0x2e,0x61,0x69],               % twp.ai
        [0x75,0x72,0x6c,0x7a,0x2e,0x66,0x72],          % urlz.fr
        [0x79,0x6f,0x75,0x74,0x75,0x2e,0x62,0x65]      % youtu.be
       ], ?b2) =>
        ?b1 = ?b2 by lemma(memb:functional),
       ?b1 = ?b2],
 ?b1 = ?b2)
).

:- lemma(branded_redirector_t_:boolean,
all [b0, host, b]: succeeds r_branded_redirector_t_(?b0, ?host, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_branded_redirector_t_(?b0, ?host, ?b),
 [def succeeds r_branded_redirector_t_(?b0, ?host, ?b) by completion,
  cases([
   case(?b0 = true & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false]),
   case(?b0 = false & succeeds r_prefix_t([0x67,0x6f,0x2e], ?host, ?b),
     [?b = true \/ ?b = false by lemma(prefix:boolean)])],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(branded_redirector_t_:functional,
all [b0, host, b1, b2]: succeeds r_branded_redirector_t_(?b0, ?host, ?b1) &
 succeeds r_branded_redirector_t_(?b0, ?host, ?b2) => ?b1 = ?b2,
assume(succeeds r_branded_redirector_t_(?b0, ?host, ?b1) &
  succeeds r_branded_redirector_t_(?b0, ?host, ?b2),
 [def succeeds r_branded_redirector_t_(?b0, ?host, ?b1) by completion,
  def succeeds r_branded_redirector_t_(?b0, ?host, ?b2) by completion,
  cases([
   case(?b0 = true & ?b1 = true,
     [cases([
      case(?b0 = true & ?b2 = true,
        [?b1 = ?b2]),
      case(?b0 = false & succeeds r_prefix_t([0x67,0x6f,0x2e], ?host, ?b2),
        [ff])],
      ?b1 = ?b2)]),
   case(?b0 = false & succeeds r_prefix_t([0x67,0x6f,0x2e], ?host, ?b1),
     [cases([
      case(?b0 = true & ?b2 = true,
        [ff]),
      case(?b0 = false & succeeds r_prefix_t([0x67,0x6f,0x2e], ?host, ?b2),
        [succeeds r_prefix_t([0x67,0x6f,0x2e], ?host, ?b1) &
        succeeds r_prefix_t([0x67,0x6f,0x2e], ?host, ?b2) =>
        ?b1 = ?b2 by lemma(prefix:functional),
         ?b1 = ?b2])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(branded_redirector:boolean,
all [host, b]: succeeds r_branded_redirector_t(?host, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_branded_redirector_t(?host, ?b),
 [def succeeds r_branded_redirector_t(?host, ?b) by completion,
  exist(ell, succeeds r_prefix_t([0x6c,0x2e], ?host, ?ell) &
     succeeds r_branded_redirector_t_(?ell, ?host, ?b),
     [?b = true \/ ?b = false by lemma(branded_redirector_t_:boolean)],
     ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(branded_redirector:functional,
all [host, b1, b2]: succeeds r_branded_redirector_t(?host, ?b1) &
 succeeds r_branded_redirector_t(?host, ?b2) => ?b1 = ?b2,
assume(succeeds r_branded_redirector_t(?host, ?b1) &
  succeeds r_branded_redirector_t(?host, ?b2),
 [def succeeds r_branded_redirector_t(?host, ?b1) by completion,
  def succeeds r_branded_redirector_t(?host, ?b2) by completion,
  exist(ell1, succeeds r_prefix_t([0x6c,0x2e], ?host, ?ell1) &
     succeeds r_branded_redirector_t_(?ell1, ?host, ?b1),
      [exist(ell2, succeeds r_prefix_t([0x6c,0x2e], ?host, ?ell2) &
     succeeds r_branded_redirector_t_(?ell2, ?host, ?b2),
        [succeeds r_prefix_t([0x6c,0x2e], ?host, ?ell1) &
         succeeds r_prefix_t([0x6c,0x2e], ?host, ?ell2) =>
         ?ell1 = ?ell2 by lemma(prefix:functional),
         ?ell1 = ?ell2,
         succeeds r_branded_redirector_t_(?ell1, ?host, ?b2),
         succeeds r_branded_redirector_t_(?ell1, ?host, ?b1) &
         succeeds r_branded_redirector_t_(?ell1, ?host, ?b2) =>
         ?b1 = ?b2 by lemma(branded_redirector_t_:functional),
         ?b1 = ?b2],
        ?b1 = ?b2)],
      ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* And the three rungs of shortened_url_t/2 itself: a listed service, then a
   publisher's own redirector, then the opaque single segment path. */

:- lemma(shortened_url_t2:boolean,
all [b0, path, b]: succeeds r_shortened_url_t2(?b0, ?path, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_shortened_url_t2(?b0, ?path, ?b),
 [def succeeds r_shortened_url_t2(?b0, ?path, ?b) by completion,
  cases([
   case(?b0 = true & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false]),
   case(?b0 = false & succeeds r_opaque_short_path_t(?path, ?b),
     [?b = true \/ ?b = false by lemma(opaque_short_path:boolean)])],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(shortened_url_t2:functional,
all [b0, path, b1, b2]: succeeds r_shortened_url_t2(?b0, ?path, ?b1) &
 succeeds r_shortened_url_t2(?b0, ?path, ?b2) => ?b1 = ?b2,
assume(succeeds r_shortened_url_t2(?b0, ?path, ?b1) &
  succeeds r_shortened_url_t2(?b0, ?path, ?b2),
 [def succeeds r_shortened_url_t2(?b0, ?path, ?b1) by completion,
  def succeeds r_shortened_url_t2(?b0, ?path, ?b2) by completion,
  cases([
   case(?b0 = true & ?b1 = true,
     [cases([
      case(?b0 = true & ?b2 = true,
        [?b1 = ?b2]),
      case(?b0 = false & succeeds r_opaque_short_path_t(?path, ?b2),
        [ff])],
      ?b1 = ?b2)]),
   case(?b0 = false & succeeds r_opaque_short_path_t(?path, ?b1),
     [cases([
      case(?b0 = true & ?b2 = true,
        [ff]),
      case(?b0 = false & succeeds r_opaque_short_path_t(?path, ?b2),
        [succeeds r_opaque_short_path_t(?path, ?b1) &
        succeeds r_opaque_short_path_t(?path, ?b2) =>
        ?b1 = ?b2 by lemma(opaque_short_path:functional),
         ?b1 = ?b2])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(shortened_url_t1:boolean,
all [b0, host, path, b]: succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b),
 [def succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b) by completion,
  cases([
   case(?b0 = true & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false]),
   case(ex branded: ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?branded) &
     succeeds r_shortened_url_t2(?branded, ?path, ?b),
     [exist(branded, ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?branded) &
     succeeds r_shortened_url_t2(?branded, ?path, ?b),
     [?b = true \/ ?b = false by lemma(shortened_url_t2:boolean)],
     ?b = true \/ ?b = false)])],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(shortened_url_t1:functional,
all [b0, host, path, b1, b2]: succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b1) &
 succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b2) => ?b1 = ?b2,
assume(succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b1) &
  succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b2),
 [def succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b1) by completion,
  def succeeds r_shortened_url_t1(?b0, ?host, ?path, ?b2) by completion,
  cases([
   case(?b0 = true & ?b1 = true,
     [cases([
      case(?b0 = true & ?b2 = true,
        [?b1 = ?b2]),
      case(ex branded: ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?branded) &
     succeeds r_shortened_url_t2(?branded, ?path, ?b2),
        [exist(brandedx, ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?brandedx) &
     succeeds r_shortened_url_t2(?brandedx, ?path, ?b2),
        [ff],
        ?b1 = ?b2)])],
      ?b1 = ?b2)]),
   case(ex branded: ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?branded) &
     succeeds r_shortened_url_t2(?branded, ?path, ?b1),
     [cases([
      case(?b0 = true & ?b2 = true,
        [exist(brandedy, ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?brandedy) &
     succeeds r_shortened_url_t2(?brandedy, ?path, ?b1),
       [ff],
       ?b1 = ?b2)]),
      case(ex branded: ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?branded) &
     succeeds r_shortened_url_t2(?branded, ?path, ?b2),
        [exist(branded1, ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?branded1) &
     succeeds r_shortened_url_t2(?branded1, ?path, ?b1),
      [exist(branded2, ?b0 = false &
     succeeds r_branded_redirector_t(?host, ?branded2) &
     succeeds r_shortened_url_t2(?branded2, ?path, ?b2),
        [succeeds r_branded_redirector_t(?host, ?branded1) &
         succeeds r_branded_redirector_t(?host, ?branded2) =>
         ?branded1 = ?branded2 by lemma(branded_redirector:functional),
         ?branded1 = ?branded2,
         succeeds r_shortened_url_t2(?branded1, ?path, ?b2),
         succeeds r_shortened_url_t2(?branded1, ?path, ?b1) &
         succeeds r_shortened_url_t2(?branded1, ?path, ?b2) =>
         ?b1 = ?b2 by lemma(shortened_url_t2:functional),
         ?b1 = ?b2],
        ?b1 = ?b2)],
      ?b1 = ?b2)])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* The host and the path an address splits into are determined by the
   address, which is what makes shortened_url_t/2 a function rather than
   merely two-valued: the same address cannot be read as two different hosts
   and so be classified twice over.

   url_after_scheme/2 answers only for an address that begins with one of the
   two schemes -- strip_prefix/3 fails on anything else -- so these are
   statements about the addresses urls_in_text/2 yields, which are the only
   ones the module ever passes in. */

:- lemma(url_after_scheme_:functional,
all [b0, url, r1, r2]: succeeds r_url_after_scheme_(?b0, ?url, ?r1) &
 succeeds r_url_after_scheme_(?b0, ?url, ?r2) => ?r1 = ?r2,
assume(succeeds r_url_after_scheme_(?b0, ?url, ?r1) &
  succeeds r_url_after_scheme_(?b0, ?url, ?r2),
 [def succeeds r_url_after_scheme_(?b0, ?url, ?r1) by completion,
  def succeeds r_url_after_scheme_(?b0, ?url, ?r2) by completion,
  cases(?b0 = true & succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?r1),
   [cases(?b0 = true & succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?r2),
     [succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?r1) &
        succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?r2) =>
        ?r1 = ?r2 by lemma(strip_prefix:functional),
      ?r1 = ?r2],
     ?b0 = false & succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?url, ?r2),
     [ff],
     ?r1 = ?r2)],
   ?b0 = false & succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?url, ?r1),
   [cases(?b0 = true & succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?r2),
     [ff],
     ?b0 = false & succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?url, ?r2),
     [succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?url, ?r1) &
        succeeds r_strip_prefix([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?url, ?r2) =>
        ?r1 = ?r2 by lemma(strip_prefix:functional),
      ?r1 = ?r2],
     ?r1 = ?r2)],
   ?r1 = ?r2)],
 ?r1 = ?r2)
).

:- lemma(url_after_scheme:functional,
all [url, r1, r2]: succeeds r_url_after_scheme(?url, ?r1) &
 succeeds r_url_after_scheme(?url, ?r2) => ?r1 = ?r2,
assume(succeeds r_url_after_scheme(?url, ?r1) &
  succeeds r_url_after_scheme(?url, ?r2),
 [def succeeds r_url_after_scheme(?url, ?r1) by completion,
  def succeeds r_url_after_scheme(?url, ?r2) by completion,
  exist(h1,
   succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?h1) &
    succeeds r_url_after_scheme_(?h1, ?url, ?r1),
   [exist(h2,
     succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?h2) &
      succeeds r_url_after_scheme_(?h2, ?url, ?r2),
     [succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?h1) &
        succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?url, ?h2) =>
        ?h1 = ?h2 by lemma(prefix:functional),
      ?h1 = ?h2,
      succeeds r_url_after_scheme_(?h1, ?url, ?r2),
      succeeds r_url_after_scheme_(?h1, ?url, ?r1) &
        succeeds r_url_after_scheme_(?h1, ?url, ?r2) =>
        ?r1 = ?r2 by lemma(url_after_scheme_:functional),
      ?r1 = ?r2],
     ?r1 = ?r2)],
   ?r1 = ?r2)],
 ?r1 = ?r2)
).

:- lemma(host_and_path:functional,
all [split, rest, h1, p1, h2, p2]:
 succeeds r_host_and_path(?split, ?rest, ?h1, ?p1) &
 succeeds r_host_and_path(?split, ?rest, ?h2, ?p2) => ?h1 = ?h2 & ?p1 = ?p2,
assume(succeeds r_host_and_path(?split, ?rest, ?h1, ?p1) &
  succeeds r_host_and_path(?split, ?rest, ?h2, ?p2),
 [def succeeds r_host_and_path(?split, ?rest, ?h1, ?p1) by completion,
  def succeeds r_host_and_path(?split, ?rest, ?h2, ?p2) by completion,
  cases(?split = not_split & ?h1 = ?rest & ?p1 = [0x2f],
   [cases(?split = not_split & ?h2 = ?rest & ?p2 = [0x2f],
     [?h1 = ?h2 & ?p1 = ?p2],
     ex after: ?split = split(?h2, ?after) &
       succeeds r_append([0x2f], ?after, ?p2),
     [exist(after2, ?split = split(?h2, ?after2) &
        succeeds r_append([0x2f], ?after2, ?p2),
       [ff],
       ?h1 = ?h2 & ?p1 = ?p2)],
     ?h1 = ?h2 & ?p1 = ?p2)],
   ex after: ?split = split(?h1, ?after) &
     succeeds r_append([0x2f], ?after, ?p1),
   [exist(after1, ?split = split(?h1, ?after1) &
      succeeds r_append([0x2f], ?after1, ?p1),
     [cases(?split = not_split & ?h2 = ?rest & ?p2 = [0x2f],
       [ff],
       ex after: ?split = split(?h2, ?after) &
         succeeds r_append([0x2f], ?after, ?p2),
       [exist(after2, ?split = split(?h2, ?after2) &
          succeeds r_append([0x2f], ?after2, ?p2),
         [?h1 = ?h2,
          ?after1 = ?after2,
          succeeds r_append([0x2f], ?after1, ?p2),
          succeeds r_append([0x2f], ?after1, ?p1) &
            succeeds r_append([0x2f], ?after1, ?p2) =>
            ?p1 = ?p2 by lemma(append:functional),
          ?p1 = ?p2,
          ?h1 = ?h2 & ?p1 = ?p2],
         ?h1 = ?h2 & ?p1 = ?p2)],
       ?h1 = ?h2 & ?p1 = ?p2)],
     ?h1 = ?h2 & ?p1 = ?p2)],
   ?h1 = ?h2 & ?p1 = ?p2)],
 ?h1 = ?h2 & ?p1 = ?p2)
).

:- lemma(strip_query:functional,
all [chars, p1, p2]: succeeds r_strip_query(?chars, ?p1) &
 succeeds r_strip_query(?chars, ?p2) => ?p1 = ?p2,
assume(succeeds r_strip_query(?chars, ?p1) &
  succeeds r_strip_query(?chars, ?p2),
 [def succeeds r_strip_query(?chars, ?p1) by completion,
  def succeeds r_strip_query(?chars, ?p2) by completion,
  exist(rest1,
   succeeds r_take_while_not(query, ?chars, ?p1, ?rest1),
   [exist(rest2,
     succeeds r_take_while_not(query, ?chars, ?p2, ?rest2),
     [succeeds r_take_while_not(query, ?chars, ?p1, ?rest1) &
        succeeds r_take_while_not(query, ?chars, ?p2, ?rest2) =>
        ?p1 = ?p2 & ?rest1 = ?rest2 by corollary(take_while_not:functional),
      ?p1 = ?p2 & ?rest1 = ?rest2,
      ?p1 = ?p2],
     ?p1 = ?p2)],
   ?p1 = ?p2)],
 ?p1 = ?p2)
).

:- lemma(url_host_path:functional,
all [url, h1, p1, h2, p2]: succeeds r_url_host_path(?url, ?h1, ?p1) &
 succeeds r_url_host_path(?url, ?h2, ?p2) => ?h1 = ?h2 & ?p1 = ?p2,
assume(succeeds r_url_host_path(?url, ?h1, ?p1) &
  succeeds r_url_host_path(?url, ?h2, ?p2),
 [def succeeds r_url_host_path(?url, ?h1, ?p1) by completion,
  def succeeds r_url_host_path(?url, ?h2, ?p2) by completion,
  exist([rest1, split1, wq1],
   succeeds r_url_after_scheme(?url, ?rest1) &
    succeeds r_split_at(slash, ?rest1, ?split1) &
    succeeds r_host_and_path(?split1, ?rest1, ?h1, ?wq1) &
    succeeds r_strip_query(?wq1, ?p1),
   [exist([rest2, split2, wq2],
     succeeds r_url_after_scheme(?url, ?rest2) &
      succeeds r_split_at(slash, ?rest2, ?split2) &
      succeeds r_host_and_path(?split2, ?rest2, ?h2, ?wq2) &
      succeeds r_strip_query(?wq2, ?p2),
     [succeeds r_url_after_scheme(?url, ?rest1) &
        succeeds r_url_after_scheme(?url, ?rest2) =>
        ?rest1 = ?rest2 by lemma(url_after_scheme:functional),
      ?rest1 = ?rest2,
      succeeds r_split_at(slash, ?rest1, ?split2),
      succeeds r_split_at(slash, ?rest1, ?split1) &
        succeeds r_split_at(slash, ?rest1, ?split2) =>
        ?split1 = ?split2 by corollary(split_at:functional),
      ?split1 = ?split2,
      succeeds r_host_and_path(?split1, ?rest1, ?h2, ?wq2),
      succeeds r_host_and_path(?split1, ?rest1, ?h1, ?wq1) &
        succeeds r_host_and_path(?split1, ?rest1, ?h2, ?wq2) =>
        ?h1 = ?h2 & ?wq1 = ?wq2 by lemma(host_and_path:functional),
      ?h1 = ?h2 & ?wq1 = ?wq2,
      succeeds r_strip_query(?wq1, ?p2),
      succeeds r_strip_query(?wq1, ?p1) & succeeds r_strip_query(?wq1, ?p2) =>
        ?p1 = ?p2 by lemma(strip_query:functional),
      ?p1 = ?p2,
      ?h1 = ?h2 & ?p1 = ?p2],
     ?h1 = ?h2 & ?p1 = ?p2)],
   ?h1 = ?h2 & ?p1 = ?p2)],
 ?h1 = ?h2 & ?p1 = ?p2)
).

/* Obligation A9, on the half of it these proofs reach: an address
   shortened_url_t/2 answers for is classified true or false, and classified
   once. The other half -- that it always answers, never fails -- is not
   proven here; see the note on A9 in obligations.tsv. */

:- lemma(shortened_url:boolean,
all [url, b]: succeeds r_shortened_url_t(?url, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_shortened_url_t(?url, ?b),
 [def succeeds r_shortened_url_t(?url, ?b) by completion,
  exist([host, path, generic],
   succeeds r_url_host_path(?url, ?host, ?path) &
    succeeds r_generic_host_t(?host, ?generic) &
    succeeds r_shortened_url_t1(?generic, ?host, ?path, ?b),
   [?b = true \/ ?b = false by lemma(shortened_url_t1:boolean)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(shortened_url:functional,
all [url, b1, b2]: succeeds r_shortened_url_t(?url, ?b1) &
 succeeds r_shortened_url_t(?url, ?b2) => ?b1 = ?b2,
assume(succeeds r_shortened_url_t(?url, ?b1) &
  succeeds r_shortened_url_t(?url, ?b2),
 [def succeeds r_shortened_url_t(?url, ?b1) by completion,
  def succeeds r_shortened_url_t(?url, ?b2) by completion,
  exist([host1, path1, generic1],
   succeeds r_url_host_path(?url, ?host1, ?path1) &
    succeeds r_generic_host_t(?host1, ?generic1) &
    succeeds r_shortened_url_t1(?generic1, ?host1, ?path1, ?b1),
   [exist([host2, path2, generic2],
     succeeds r_url_host_path(?url, ?host2, ?path2) &
      succeeds r_generic_host_t(?host2, ?generic2) &
      succeeds r_shortened_url_t1(?generic2, ?host2, ?path2, ?b2),
     [succeeds r_url_host_path(?url, ?host1, ?path1) &
        succeeds r_url_host_path(?url, ?host2, ?path2) =>
        ?host1 = ?host2 & ?path1 = ?path2
        by lemma(url_host_path:functional),
      ?host1 = ?host2 & ?path1 = ?path2,
      succeeds r_generic_host_t(?host1, ?generic2),
      succeeds r_generic_host_t(?host1, ?generic1) &
        succeeds r_generic_host_t(?host1, ?generic2) =>
        ?generic1 = ?generic2 by lemma(generic_host:functional),
      ?generic1 = ?generic2,
      succeeds r_shortened_url_t1(?generic1, ?host1, ?path1, ?b2),
      succeeds r_shortened_url_t1(?generic1, ?host1, ?path1, ?b1) &
        succeeds r_shortened_url_t1(?generic1, ?host1, ?path1, ?b2) =>
        ?b1 = ?b2 by lemma(shortened_url_t1:functional),
      ?b1 = ?b2],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* The conditions permalink/2 filters its query parameters with. `amp' is
   matched whole, the campaign markers by prefix, and the sense is then
   flipped: a parameter is functional exactly when it is not a tracking one.

   r_tracking_prefixes/1 holds the table of markers, and its one clause is a
   fact, so its functionality is read straight off the completion -- the
   table does not have to be written out here to be known unique. */

:- lemma(tracking_prefixes:functional,
all [l1, l2]: succeeds r_tracking_prefixes(?l1) &
 succeeds r_tracking_prefixes(?l2) => ?l1 = ?l2,
assume(succeeds r_tracking_prefixes(?l1) & succeeds r_tracking_prefixes(?l2),
 [def succeeds r_tracking_prefixes(?l1) by completion,
  def succeeds r_tracking_prefixes(?l2) by completion,
  ?l1 = ?l2],
 ?l1 = ?l2)
).

:- lemma(any_prefix:boolean:sim,
(all [ps, param, b]: succeeds r_any_prefix_t(?ps, ?param, ?b) =>
  ?b = true \/ ?b = false) &
(all [b0, ps, param, b]: succeeds r_any_prefix_t_(?b0, ?ps, ?param, ?b) =>
  ?b = true \/ ?b = false),
induction(
 [all [ps, param, b]: succeeds r_any_prefix_t(?ps, ?param, ?b) =>
   ?b = true \/ ?b = false,
  all [b0, ps, param, b]: succeeds r_any_prefix_t_(?b0, ?ps, ?param, ?b) =>
   ?b = true \/ ?b = false],
 [step([param],
   [],
   [],
   false = true \/ false = false),
  step([p, ps, param, b, here],
   [?b = true \/ ?b = false,
    succeeds r_prefix_t(?p, ?param, ?here),
    succeeds r_any_prefix_t_(?here, ?ps, ?param, ?b)],
   [],
   ?b = true \/ ?b = false),
  step([ps, param],
   [],
   [],
   true = true \/ true = false),
  step([ps, param, b],
   [?b = true \/ ?b = false,
    succeeds r_any_prefix_t(?ps, ?param, ?b)],
   [],
   ?b = true \/ ?b = false)])
).

:- lemma(any_prefix:functional:sim,
(all [ps, param, b1]: succeeds r_any_prefix_t(?ps, ?param, ?b1) =>
  (all b2: succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2)) &
(all [b0, ps, param, b1]: succeeds r_any_prefix_t_(?b0, ?ps, ?param, ?b1) =>
  (all b2: succeeds r_any_prefix_t_(?b0, ?ps, ?param, ?b2) => ?b1 = ?b2)),
induction(
 [all [ps, param, b1]: succeeds r_any_prefix_t(?ps, ?param, ?b1) =>
   (all b2: succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2),
  all [b0, ps, param, b1]: succeeds r_any_prefix_t_(?b0, ?ps, ?param, ?b1) =>
   (all b2: succeeds r_any_prefix_t_(?b0, ?ps, ?param, ?b2) => ?b1 = ?b2)],
 [step([param],
   [],
   assume(succeeds r_any_prefix_t([], ?param, ?b2),
    [def succeeds r_any_prefix_t([], ?param, ?b2) by completion,
     ?b2 = false],
    false = ?b2),
   all b2: succeeds r_any_prefix_t([], ?param, ?b2) => false = ?b2),
  step([p, ps, param, b1, here],
   [all b2: succeeds r_any_prefix_t_(?here, ?ps, ?param, ?b2) => ?b1 = ?b2,
    succeeds r_prefix_t(?p, ?param, ?here),
    succeeds r_any_prefix_t_(?here, ?ps, ?param, ?b1)],
   assume(succeeds r_any_prefix_t([?p|?ps], ?param, ?b2),
    [def succeeds r_any_prefix_t([?p|?ps], ?param, ?b2) by completion,
     exist(v2,
      succeeds r_prefix_t(?p, ?param, ?v2) &
       succeeds r_any_prefix_t_(?v2, ?ps, ?param, ?b2),
      [succeeds r_prefix_t(?p, ?param, ?here) &
         succeeds r_prefix_t(?p, ?param, ?v2) =>
         ?here = ?v2 by lemma(prefix:functional),
       ?here = ?v2,
       succeeds r_any_prefix_t_(?here, ?ps, ?param, ?b2),
       succeeds r_any_prefix_t_(?here, ?ps, ?param, ?b2) => ?b1 = ?b2,
       ?b1 = ?b2],
      ?b1 = ?b2)],
    ?b1 = ?b2),
   all b2: succeeds r_any_prefix_t([?p|?ps], ?param, ?b2) => ?b1 = ?b2),
  step([ps, param],
   [],
   assume(succeeds r_any_prefix_t_(true, ?ps, ?param, ?b2),
    [def succeeds r_any_prefix_t_(true, ?ps, ?param, ?b2) by completion,
     ?b2 = true],
    true = ?b2),
   all b2: succeeds r_any_prefix_t_(true, ?ps, ?param, ?b2) => true = ?b2),
  step([ps, param, b1],
   [all b2: succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2,
    succeeds r_any_prefix_t(?ps, ?param, ?b1)],
   assume(succeeds r_any_prefix_t_(false, ?ps, ?param, ?b2),
    [def succeeds r_any_prefix_t_(false, ?ps, ?param, ?b2) by completion,
     succeeds r_any_prefix_t(?ps, ?param, ?b2),
     succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2,
     ?b1 = ?b2],
    ?b1 = ?b2),
   all b2: succeeds r_any_prefix_t_(false, ?ps, ?param, ?b2) => ?b1 = ?b2)])
).

:- corollary(any_prefix:boolean,
all [ps, param, b]: succeeds r_any_prefix_t(?ps, ?param, ?b) =>
 ?b = true \/ ?b = false,
assume(succeeds r_any_prefix_t(?ps, ?param, ?b),
 [(all [ps, param, b]: succeeds r_any_prefix_t(?ps, ?param, ?b) =>
    ?b = true \/ ?b = false) by lemma(any_prefix:boolean:sim),
  succeeds r_any_prefix_t(?ps, ?param, ?b) => ?b = true \/ ?b = false,
  ?b = true \/ ?b = false],
 ?b = true \/ ?b = false)
).

:- corollary(any_prefix:functional,
all [ps, param, b1, b2]: succeeds r_any_prefix_t(?ps, ?param, ?b1) &
 succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2,
assume(succeeds r_any_prefix_t(?ps, ?param, ?b1) &
  succeeds r_any_prefix_t(?ps, ?param, ?b2),
 [(all [ps, param, b1]: succeeds r_any_prefix_t(?ps, ?param, ?b1) =>
    (all b2: succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2))
    by lemma(any_prefix:functional:sim),
  succeeds r_any_prefix_t(?ps, ?param, ?b1) =>
   (all b2: succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2),
  all b2: succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2,
  succeeds r_any_prefix_t(?ps, ?param, ?b2) => ?b1 = ?b2,
  ?b1 = ?b2],
 ?b1 = ?b2)
).

:- lemma(negate:boolean,
all [b0, b]: succeeds r_negate(?b0, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_negate(?b0, ?b),
 [def succeeds r_negate(?b0, ?b) by completion,
  cases([
   case(?b0 = true & ?b = false,
     [?b = false,
      ?b = true \/ ?b = false]),
   case(?b0 = false & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false])],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(negate:functional,
all [b0, b1, b2]: succeeds r_negate(?b0, ?b1) &
 succeeds r_negate(?b0, ?b2) => ?b1 = ?b2,
assume(succeeds r_negate(?b0, ?b1) &
  succeeds r_negate(?b0, ?b2),
 [def succeeds r_negate(?b0, ?b1) by completion,
  def succeeds r_negate(?b0, ?b2) by completion,
  cases([
   case(?b0 = true & ?b1 = false,
     [cases([
      case(?b0 = true & ?b2 = false,
        [?b1 = ?b2]),
      case(?b0 = false & ?b2 = true,
        [ff])],
      ?b1 = ?b2)]),
   case(?b0 = false & ?b1 = true,
     [cases([
      case(?b0 = true & ?b2 = false,
        [ff]),
      case(?b0 = false & ?b2 = true,
        [?b1 = ?b2])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(tracking_param_t_:boolean,
all [b0, param, b]: succeeds r_tracking_param_t_(?b0, ?param, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_tracking_param_t_(?b0, ?param, ?b),
 [def succeeds r_tracking_param_t_(?b0, ?param, ?b) by completion,
  cases([
   case(?b0 = true & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false]),
   case(ex prefixes: ?b0 = false &
     succeeds r_tracking_prefixes(?prefixes) &
     succeeds r_any_prefix_t(?prefixes, ?param, ?b),
     [exist(prefixes, ?b0 = false &
     succeeds r_tracking_prefixes(?prefixes) &
     succeeds r_any_prefix_t(?prefixes, ?param, ?b),
     [?b = true \/ ?b = false by corollary(any_prefix:boolean)],
     ?b = true \/ ?b = false)])],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(tracking_param_t_:functional,
all [b0, param, b1, b2]: succeeds r_tracking_param_t_(?b0, ?param, ?b1) &
 succeeds r_tracking_param_t_(?b0, ?param, ?b2) => ?b1 = ?b2,
assume(succeeds r_tracking_param_t_(?b0, ?param, ?b1) &
  succeeds r_tracking_param_t_(?b0, ?param, ?b2),
 [def succeeds r_tracking_param_t_(?b0, ?param, ?b1) by completion,
  def succeeds r_tracking_param_t_(?b0, ?param, ?b2) by completion,
  cases([
   case(?b0 = true & ?b1 = true,
     [cases([
      case(?b0 = true & ?b2 = true,
        [?b1 = ?b2]),
      case(ex prefixes: ?b0 = false &
     succeeds r_tracking_prefixes(?prefixes) &
     succeeds r_any_prefix_t(?prefixes, ?param, ?b2),
        [exist(prefixesx, ?b0 = false &
     succeeds r_tracking_prefixes(?prefixesx) &
     succeeds r_any_prefix_t(?prefixesx, ?param, ?b2),
        [ff],
        ?b1 = ?b2)])],
      ?b1 = ?b2)]),
   case(ex prefixes: ?b0 = false &
     succeeds r_tracking_prefixes(?prefixes) &
     succeeds r_any_prefix_t(?prefixes, ?param, ?b1),
     [cases([
      case(?b0 = true & ?b2 = true,
        [exist(prefixesy, ?b0 = false &
     succeeds r_tracking_prefixes(?prefixesy) &
     succeeds r_any_prefix_t(?prefixesy, ?param, ?b1),
       [ff],
       ?b1 = ?b2)]),
      case(ex prefixes: ?b0 = false &
     succeeds r_tracking_prefixes(?prefixes) &
     succeeds r_any_prefix_t(?prefixes, ?param, ?b2),
        [exist(prefixes1, ?b0 = false &
     succeeds r_tracking_prefixes(?prefixes1) &
     succeeds r_any_prefix_t(?prefixes1, ?param, ?b1),
      [exist(prefixes2, ?b0 = false &
     succeeds r_tracking_prefixes(?prefixes2) &
     succeeds r_any_prefix_t(?prefixes2, ?param, ?b2),
        [succeeds r_tracking_prefixes(?prefixes1) &
         succeeds r_tracking_prefixes(?prefixes2) =>
         ?prefixes1 = ?prefixes2 by lemma(tracking_prefixes:functional),
         ?prefixes1 = ?prefixes2,
         succeeds r_any_prefix_t(?prefixes1, ?param, ?b2),
         succeeds r_any_prefix_t(?prefixes1, ?param, ?b1) &
         succeeds r_any_prefix_t(?prefixes1, ?param, ?b2) =>
         ?b1 = ?b2 by corollary(any_prefix:functional),
         ?b1 = ?b2],
        ?b1 = ?b2)],
      ?b1 = ?b2)])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(tracking_param:boolean,
all [param, b]: succeeds r_tracking_param_t(?param, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_tracking_param_t(?param, ?b),
 [def succeeds r_tracking_param_t(?param, ?b) by completion,
  exist(exact, succeeds r_memb(?param, [[0x61,0x6d,0x70]], ?exact) &
     succeeds r_tracking_param_t_(?exact, ?param, ?b),
     [?b = true \/ ?b = false by lemma(tracking_param_t_:boolean)],
     ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(tracking_param:functional,
all [param, b1, b2]: succeeds r_tracking_param_t(?param, ?b1) &
 succeeds r_tracking_param_t(?param, ?b2) => ?b1 = ?b2,
assume(succeeds r_tracking_param_t(?param, ?b1) &
  succeeds r_tracking_param_t(?param, ?b2),
 [def succeeds r_tracking_param_t(?param, ?b1) by completion,
  def succeeds r_tracking_param_t(?param, ?b2) by completion,
  exist(exact1, succeeds r_memb(?param, [[0x61,0x6d,0x70]], ?exact1) &
     succeeds r_tracking_param_t_(?exact1, ?param, ?b1),
      [exist(exact2, succeeds r_memb(?param, [[0x61,0x6d,0x70]], ?exact2) &
     succeeds r_tracking_param_t_(?exact2, ?param, ?b2),
        [succeeds r_memb(?param, [[0x61,0x6d,0x70]], ?exact1) &
         succeeds r_memb(?param, [[0x61,0x6d,0x70]], ?exact2) =>
         ?exact1 = ?exact2 by lemma(memb:functional),
         ?exact1 = ?exact2,
         succeeds r_tracking_param_t_(?exact1, ?param, ?b2),
         succeeds r_tracking_param_t_(?exact1, ?param, ?b1) &
         succeeds r_tracking_param_t_(?exact1, ?param, ?b2) =>
         ?b1 = ?b2 by lemma(tracking_param_t_:functional),
         ?b1 = ?b2],
        ?b1 = ?b2)],
      ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(functional_param:boolean,
all [param, b]: succeeds r_functional_param_t(?param, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_functional_param_t(?param, ?b),
 [def succeeds r_functional_param_t(?param, ?b) by completion,
  exist(tracking, succeeds r_tracking_param_t(?param, ?tracking) &
     succeeds r_negate(?tracking, ?b),
     [?b = true \/ ?b = false by lemma(negate:boolean)],
     ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(functional_param:functional,
all [param, b1, b2]: succeeds r_functional_param_t(?param, ?b1) &
 succeeds r_functional_param_t(?param, ?b2) => ?b1 = ?b2,
assume(succeeds r_functional_param_t(?param, ?b1) &
  succeeds r_functional_param_t(?param, ?b2),
 [def succeeds r_functional_param_t(?param, ?b1) by completion,
  def succeeds r_functional_param_t(?param, ?b2) by completion,
  exist(tracking1, succeeds r_tracking_param_t(?param, ?tracking1) &
     succeeds r_negate(?tracking1, ?b1),
      [exist(tracking2, succeeds r_tracking_param_t(?param, ?tracking2) &
     succeeds r_negate(?tracking2, ?b2),
        [succeeds r_tracking_param_t(?param, ?tracking1) &
         succeeds r_tracking_param_t(?param, ?tracking2) =>
         ?tracking1 = ?tracking2 by lemma(tracking_param:functional),
         ?tracking1 = ?tracking2,
         succeeds r_negate(?tracking1, ?b2),
         succeeds r_negate(?tracking1, ?b1) &
         succeeds r_negate(?tracking1, ?b2) =>
         ?b1 = ?b2 by lemma(negate:functional),
         ?b1 = ?b2],
        ?b1 = ?b2)],
      ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* dif_t/3, the condition the duplicate filter is given. Two clauses over
   one equality, which is the shape every reified equality in this module
   has once if_/3 is gone. */

:- lemma(dif:boolean,
all [x, y, b]: succeeds r_dif_t(?x, ?y, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_dif_t(?x, ?y, ?b),
 [def succeeds r_dif_t(?x, ?y, ?b) by completion,
  cases(?y = ?x & ?b = false,
   [?b = true \/ ?b = false],
   ?b = true & ?x <> ?y,
   [?b = true \/ ?b = false],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(dif:functional,
all [x, y, b1, b2]: succeeds r_dif_t(?x, ?y, ?b1) &
 succeeds r_dif_t(?x, ?y, ?b2) => ?b1 = ?b2,
assume(succeeds r_dif_t(?x, ?y, ?b1) & succeeds r_dif_t(?x, ?y, ?b2),
 [def succeeds r_dif_t(?x, ?y, ?b1) by completion,
  def succeeds r_dif_t(?x, ?y, ?b2) by completion,
  cases(?y = ?x & ?b1 = false,
   [cases(?y = ?x & ?b2 = false,
     [?b1 = ?b2],
     ?b2 = true & ?x <> ?y,
     [?x = ?y,
      ff],
     ?b1 = ?b2)],
   ?b1 = true & ?x <> ?y,
   [cases(?y = ?x & ?b2 = false,
     [?x = ?y,
      ff],
     ?b2 = true & ?x <> ?y,
     [?b1 = ?b2],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* What follows is list algebra, and it is here for one obligation: A8, that
   trim_trailing/2 removes only a suffix of the address and only punctuation
   from it. The shipped predicate reverses, drops a punctuation prefix, and
   reverses back, so the law about its SUFFIX is a law about a prefix one
   reversal away -- and nothing about reversal is available to LPTP that is
   not proven here first. A reverse that is not undone, or a dropped
   character that was part of the path, silently shortens an address. */

:- lemma(append:nil,
all xs: succeeds r_list(?xs) => succeeds r_append(?xs, [], ?xs),
induction(
 [all xs: succeeds r_list(?xs) => succeeds r_append(?xs, [], ?xs)],
 [step([],
   [],
   [succeeds r_append([], [], [])],
   succeeds r_append([], [], [])),
  step([x, xs],
   [succeeds r_append(?xs, [], ?xs),
    succeeds r_list(?xs)],
   [succeeds r_append([?x|?xs], [], [?x|?xs])],
   succeeds r_append([?x|?xs], [], [?x|?xs]))])
).

:- lemma(append:list,
all [as, bs, cs]: succeeds r_append(?as, ?bs, ?cs) =>
 (succeeds r_list(?bs) => succeeds r_list(?cs)),
induction(
 [all [as, bs, cs]: succeeds r_append(?as, ?bs, ?cs) =>
   (succeeds r_list(?bs) => succeeds r_list(?cs))],
 [step([ys],
   [],
   [assume(succeeds r_list(?ys),
     [],
     succeeds r_list(?ys))],
   succeeds r_list(?ys) => succeeds r_list(?ys)),
  step([x, xs, ys, zs],
   [succeeds r_list(?ys) => succeeds r_list(?zs),
    succeeds r_append(?xs, ?ys, ?zs)],
   [assume(succeeds r_list(?ys),
     [succeeds r_list(?zs),
      succeeds r_list([?x|?zs])],
     succeeds r_list([?x|?zs]))],
   succeeds r_list(?ys) => succeeds r_list([?x|?zs]))])
).

:- lemma(append:total,
all xs: succeeds r_list(?xs) =>
 (all ys: (ex zs: succeeds r_append(?xs, ?ys, ?zs))),
induction(
 [all xs: succeeds r_list(?xs) =>
   (all ys: (ex zs: succeeds r_append(?xs, ?ys, ?zs)))],
 [step([],
   [],
   [succeeds r_append([], ?ys, ?ys),
    ex zs: succeeds r_append([], ?ys, ?zs)],
   all ys: (ex zs: succeeds r_append([], ?ys, ?zs))),
  step([x, xs],
   [all ys: (ex zs: succeeds r_append(?xs, ?ys, ?zs)),
    succeeds r_list(?xs)],
   [ex zs: succeeds r_append(?xs, ?ys, ?zs),
    exist(z, succeeds r_append(?xs, ?ys, ?z),
     [succeeds r_append([?x|?xs], ?ys, [?x|?z]),
      ex zs: succeeds r_append([?x|?xs], ?ys, ?zs)],
     ex zs: succeeds r_append([?x|?xs], ?ys, ?zs))],
   all ys: (ex zs: succeeds r_append([?x|?xs], ?ys, ?zs)))])
).

:- lemma(append:assoc,
all [as, bs, ab]: succeeds r_append(?as, ?bs, ?ab) =>
 (all [cs, bc, abc]: succeeds r_append(?bs, ?cs, ?bc) &
   succeeds r_append(?ab, ?cs, ?abc) => succeeds r_append(?as, ?bc, ?abc)),
induction(
 [all [as, bs, ab]: succeeds r_append(?as, ?bs, ?ab) =>
   (all [cs, bc, abc]: succeeds r_append(?bs, ?cs, ?bc) &
     succeeds r_append(?ab, ?cs, ?abc) => succeeds r_append(?as, ?bc, ?abc))],
 [step([ys],
   [],
   [assume(succeeds r_append(?ys, ?cs, ?bc) &
      succeeds r_append(?ys, ?cs, ?abc),
     [succeeds r_append(?ys, ?cs, ?bc) & succeeds r_append(?ys, ?cs, ?abc) =>
        ?bc = ?abc by lemma(append:functional),
      ?bc = ?abc,
      succeeds r_append([], ?bc, ?bc),
      succeeds r_append([], ?bc, ?abc)],
     succeeds r_append([], ?bc, ?abc))],
   all [cs, bc, abc]: succeeds r_append(?ys, ?cs, ?bc) &
    succeeds r_append(?ys, ?cs, ?abc) => succeeds r_append([], ?bc, ?abc)),
  step([x, xs, ys, zs],
   [all [cs, bc, abc]: succeeds r_append(?ys, ?cs, ?bc) &
      succeeds r_append(?zs, ?cs, ?abc) => succeeds r_append(?xs, ?bc, ?abc),
    succeeds r_append(?xs, ?ys, ?zs)],
   [assume(succeeds r_append(?ys, ?cs, ?bc) &
      succeeds r_append([?x|?zs], ?cs, ?abc),
     [def succeeds r_append([?x|?zs], ?cs, ?abc) by completion,
      exist(zs2,
       ?abc = [?x|?zs2] & succeeds r_append(?zs, ?cs, ?zs2),
       [succeeds r_append(?ys, ?cs, ?bc) & succeeds r_append(?zs, ?cs, ?zs2)
          => succeeds r_append(?xs, ?bc, ?zs2),
        succeeds r_append(?xs, ?bc, ?zs2),
        succeeds r_append([?x|?xs], ?bc, [?x|?zs2]),
        succeeds r_append([?x|?xs], ?bc, ?abc)],
       succeeds r_append([?x|?xs], ?bc, ?abc))],
     succeeds r_append([?x|?xs], ?bc, ?abc))],
   all [cs, bc, abc]: succeeds r_append(?ys, ?cs, ?bc) &
    succeeds r_append([?x|?zs], ?cs, ?abc) =>
    succeeds r_append([?x|?xs], ?bc, ?abc))])
).

:- lemma(all_punct:list,
all xs: succeeds r_all_punct(?xs) => succeeds r_list(?xs),
induction(
 [all xs: succeeds r_all_punct(?xs) => succeeds r_list(?xs)],
 [step([],
   [],
   [succeeds r_list([])],
   succeeds r_list([])),
  step([c, cs],
   [succeeds r_list(?cs),
    succeeds r_cond_t(punct, ?c, true),
    succeeds r_all_punct(?cs)],
   [succeeds r_list([?c|?cs])],
   succeeds r_list([?c|?cs]))])
).

:- lemma(all_punct:append,
all [as, bs, cs]: succeeds r_append(?as, ?bs, ?cs) =>
 (succeeds r_all_punct(?as) & succeeds r_all_punct(?bs) =>
   succeeds r_all_punct(?cs)),
induction(
 [all [as, bs, cs]: succeeds r_append(?as, ?bs, ?cs) =>
   (succeeds r_all_punct(?as) & succeeds r_all_punct(?bs) =>
     succeeds r_all_punct(?cs))],
 [step([ys],
   [],
   [assume(succeeds r_all_punct([]) & succeeds r_all_punct(?ys),
     [succeeds r_all_punct(?ys)],
     succeeds r_all_punct(?ys))],
   succeeds r_all_punct([]) & succeeds r_all_punct(?ys) =>
    succeeds r_all_punct(?ys)),
  step([x, xs, ys, zs],
   [succeeds r_all_punct(?xs) & succeeds r_all_punct(?ys) =>
      succeeds r_all_punct(?zs),
    succeeds r_append(?xs, ?ys, ?zs)],
   [assume(succeeds r_all_punct([?x|?xs]) & succeeds r_all_punct(?ys),
     [def succeeds r_all_punct([?x|?xs]) by completion,
      succeeds r_cond_t(punct, ?x, true),
      succeeds r_all_punct(?xs),
      succeeds r_all_punct(?xs) & succeeds r_all_punct(?ys),
      succeeds r_all_punct(?zs),
      succeeds r_all_punct([?x|?zs])],
     succeeds r_all_punct([?x|?zs]))],
   succeeds r_all_punct([?x|?xs]) & succeeds r_all_punct(?ys) =>
    succeeds r_all_punct([?x|?zs]))])
).

:- lemma(reverse:list,
all [xs, ys]: succeeds r_reverse(?xs, ?ys) => succeeds r_list(?ys),
induction(
 [all [xs, ys]: succeeds r_reverse(?xs, ?ys) => succeeds r_list(?ys)],
 [step([],
   [],
   [succeeds r_list([])],
   succeeds r_list([])),
  step([x, xs, ys, rs],
   [succeeds r_list(?rs),
    succeeds r_reverse(?xs, ?rs),
    succeeds r_append(?rs, [?x], ?ys)],
   [succeeds r_list([]),
    succeeds r_list([?x]),
    succeeds r_append(?rs, [?x], ?ys) =>
      (succeeds r_list([?x]) => succeeds r_list(?ys)) by lemma(append:list),
    succeeds r_list([?x]) => succeeds r_list(?ys),
    succeeds r_list(?ys)],
   succeeds r_list(?ys))])
).

:- lemma(reverse:total,
all xs: succeeds r_list(?xs) => (ex ys: succeeds r_reverse(?xs, ?ys)),
induction(
 [all xs: succeeds r_list(?xs) => (ex ys: succeeds r_reverse(?xs, ?ys))],
 [step([],
   [],
   [succeeds r_reverse([], []),
    ex ys: succeeds r_reverse([], ?ys)],
   ex ys: succeeds r_reverse([], ?ys)),
  step([x, xs],
   [ex ys: succeeds r_reverse(?xs, ?ys),
    succeeds r_list(?xs)],
   [exist(r, succeeds r_reverse(?xs, ?r),
     [succeeds r_reverse(?xs, ?r) => succeeds r_list(?r)
        by lemma(reverse:list),
      succeeds r_list(?r),
      succeeds r_list(?r) =>
        (all ys: (ex zs: succeeds r_append(?r, ?ys, ?zs)))
        by lemma(append:total),
      all ys: (ex zs: succeeds r_append(?r, ?ys, ?zs)),
      ex zs: succeeds r_append(?r, [?x], ?zs),
      exist(z, succeeds r_append(?r, [?x], ?z),
       [succeeds r_reverse([?x|?xs], ?z),
        ex ys: succeeds r_reverse([?x|?xs], ?ys)],
       ex ys: succeeds r_reverse([?x|?xs], ?ys))],
     ex ys: succeeds r_reverse([?x|?xs], ?ys))],
   ex ys: succeeds r_reverse([?x|?xs], ?ys))])
).

/* Reversing a concatenation reverses the pieces and swaps them. This is the
   one law that carries a statement about the FRONT of the reversed address
   back to a statement about the END of the address, and the whole of A8
   turns on it. */

:- lemma(reverse:append,
all [as, bs, ab]: succeeds r_append(?as, ?bs, ?ab) =>
 (all [ras, rbs, rab]: succeeds r_reverse(?as, ?ras) &
   succeeds r_reverse(?bs, ?rbs) & succeeds r_reverse(?ab, ?rab) =>
   succeeds r_append(?rbs, ?ras, ?rab)),
induction(
 [all [as, bs, ab]: succeeds r_append(?as, ?bs, ?ab) =>
   (all [ras, rbs, rab]: succeeds r_reverse(?as, ?ras) &
     succeeds r_reverse(?bs, ?rbs) & succeeds r_reverse(?ab, ?rab) =>
     succeeds r_append(?rbs, ?ras, ?rab))],
 [step([ys],
   [],
   [assume(succeeds r_reverse([], ?ras) & succeeds r_reverse(?ys, ?rbs) &
      succeeds r_reverse(?ys, ?rab),
     [def succeeds r_reverse([], ?ras) by completion,
      ?ras = [],
      succeeds r_reverse(?ys, ?rbs) & succeeds r_reverse(?ys, ?rab) =>
        ?rbs = ?rab by lemma(reverse:functional),
      ?rbs = ?rab,
      succeeds r_reverse(?ys, ?rbs) => succeeds r_list(?rbs)
        by lemma(reverse:list),
      succeeds r_list(?rbs),
      succeeds r_list(?rbs) => succeeds r_append(?rbs, [], ?rbs)
        by lemma(append:nil),
      succeeds r_append(?rbs, [], ?rbs),
      succeeds r_append(?rbs, ?ras, ?rab)],
     succeeds r_append(?rbs, ?ras, ?rab))],
   all [ras, rbs, rab]: succeeds r_reverse([], ?ras) &
    succeeds r_reverse(?ys, ?rbs) & succeeds r_reverse(?ys, ?rab) =>
    succeeds r_append(?rbs, ?ras, ?rab)),
  step([x, xs, ys, zs],
   [all [ras, rbs, rab]: succeeds r_reverse(?xs, ?ras) &
      succeeds r_reverse(?ys, ?rbs) & succeeds r_reverse(?zs, ?rab) =>
      succeeds r_append(?rbs, ?ras, ?rab),
    succeeds r_append(?xs, ?ys, ?zs)],
   [assume(succeeds r_reverse([?x|?xs], ?ras) &
      succeeds r_reverse(?ys, ?rbs) & succeeds r_reverse([?x|?zs], ?rab),
     [def succeeds r_reverse([?x|?xs], ?ras) by completion,
      exist(r1,
       succeeds r_reverse(?xs, ?r1) & succeeds r_append(?r1, [?x], ?ras),
       [def succeeds r_reverse([?x|?zs], ?rab) by completion,
        exist(r2,
         succeeds r_reverse(?zs, ?r2) & succeeds r_append(?r2, [?x], ?rab),
         [succeeds r_reverse(?xs, ?r1) & succeeds r_reverse(?ys, ?rbs) &
            succeeds r_reverse(?zs, ?r2) => succeeds r_append(?rbs, ?r1, ?r2),
          succeeds r_append(?rbs, ?r1, ?r2),
          succeeds r_append(?rbs, ?r1, ?r2) =>
            (all [cs, bc, abc]: succeeds r_append(?r1, ?cs, ?bc) &
              succeeds r_append(?r2, ?cs, ?abc) =>
              succeeds r_append(?rbs, ?bc, ?abc)) by lemma(append:assoc),
          all [cs, bc, abc]: succeeds r_append(?r1, ?cs, ?bc) &
            succeeds r_append(?r2, ?cs, ?abc) =>
            succeeds r_append(?rbs, ?bc, ?abc),
          succeeds r_append(?r1, [?x], ?ras) &
            succeeds r_append(?r2, [?x], ?rab) =>
            succeeds r_append(?rbs, ?ras, ?rab),
          succeeds r_append(?rbs, ?ras, ?rab)],
         succeeds r_append(?rbs, ?ras, ?rab))],
       succeeds r_append(?rbs, ?ras, ?rab))],
     succeeds r_append(?rbs, ?ras, ?rab))],
   all [ras, rbs, rab]: succeeds r_reverse([?x|?xs], ?ras) &
    succeeds r_reverse(?ys, ?rbs) & succeeds r_reverse([?x|?zs], ?rab) =>
    succeeds r_append(?rbs, ?ras, ?rab))])
).

/* And so reversing twice is the identity: the address trim_trailing/2 hands
   back is read off the same list it was given, not off a copy that has been
   turned round once too often. */

:- lemma(reverse:involution,
all xs: succeeds r_list(?xs) =>
 (all ys: succeeds r_reverse(?xs, ?ys) => succeeds r_reverse(?ys, ?xs)),
induction(
 [all xs: succeeds r_list(?xs) =>
   (all ys: succeeds r_reverse(?xs, ?ys) => succeeds r_reverse(?ys, ?xs))],
 [step([],
   [],
   [assume(succeeds r_reverse([], ?ys),
     [def succeeds r_reverse([], ?ys) by completion,
      ?ys = [],
      succeeds r_reverse([], []),
      succeeds r_reverse(?ys, [])],
     succeeds r_reverse(?ys, []))],
   all ys: succeeds r_reverse([], ?ys) => succeeds r_reverse(?ys, [])),
  step([x, xs],
   [all ys: succeeds r_reverse(?xs, ?ys) => succeeds r_reverse(?ys, ?xs),
    succeeds r_list(?xs)],
   [assume(succeeds r_reverse([?x|?xs], ?ys),
     [def succeeds r_reverse([?x|?xs], ?ys) by completion,
      exist(r,
       succeeds r_reverse(?xs, ?r) & succeeds r_append(?r, [?x], ?ys),
       [succeeds r_reverse(?xs, ?r) => succeeds r_reverse(?r, ?xs),
        succeeds r_reverse(?r, ?xs),
        succeeds r_list([]),
        succeeds r_list([?x]),
        succeeds r_append(?r, [?x], ?ys) =>
          (succeeds r_list([?x]) => succeeds r_list(?ys))
          by lemma(append:list),
        succeeds r_list([?x]) => succeeds r_list(?ys),
        succeeds r_list(?ys),
        succeeds r_list(?ys) => (ex z: succeeds r_reverse(?ys, ?z))
          by lemma(reverse:total),
        ex z: succeeds r_reverse(?ys, ?z),
        exist(rys,
         succeeds r_reverse(?ys, ?rys),
         [succeeds r_reverse([], []),
          succeeds r_append([], [?x], [?x]),
          succeeds r_reverse([?x], [?x]),
          succeeds r_append(?r, [?x], ?ys) =>
            (all [ras, rbs, rab]: succeeds r_reverse(?r, ?ras) &
              succeeds r_reverse([?x], ?rbs) &
              succeeds r_reverse(?ys, ?rab) =>
              succeeds r_append(?rbs, ?ras, ?rab))
            by lemma(reverse:append),
          all [ras, rbs, rab]: succeeds r_reverse(?r, ?ras) &
            succeeds r_reverse([?x], ?rbs) & succeeds r_reverse(?ys, ?rab) =>
            succeeds r_append(?rbs, ?ras, ?rab),
          succeeds r_reverse(?r, ?xs) & succeeds r_reverse([?x], [?x]) &
            succeeds r_reverse(?ys, ?rys) =>
            succeeds r_append([?x], ?xs, ?rys),
          succeeds r_append([?x], ?xs, ?rys),
          succeeds r_append([], ?xs, ?xs),
          succeeds r_append([?x], ?xs, [?x|?xs]),
          succeeds r_append([?x], ?xs, [?x|?xs]) &
            succeeds r_append([?x], ?xs, ?rys) =>
            [?x|?xs] = ?rys by lemma(append:functional),
          [?x|?xs] = ?rys,
          succeeds r_reverse(?ys, [?x|?xs])],
         succeeds r_reverse(?ys, [?x|?xs]))],
       succeeds r_reverse(?ys, [?x|?xs]))],
     succeeds r_reverse(?ys, [?x|?xs]))],
   all ys: succeeds r_reverse([?x|?xs], ?ys) =>
    succeeds r_reverse(?ys, [?x|?xs]))])
).

:- lemma(all_punct:reverse,
all p: succeeds r_all_punct(?p) =>
 (all rp: succeeds r_reverse(?p, ?rp) => succeeds r_all_punct(?rp)),
induction(
 [all p: succeeds r_all_punct(?p) =>
   (all rp: succeeds r_reverse(?p, ?rp) => succeeds r_all_punct(?rp))],
 [step([],
   [],
   [assume(succeeds r_reverse([], ?rp),
     [def succeeds r_reverse([], ?rp) by completion,
      ?rp = [],
      succeeds r_all_punct([]),
      succeeds r_all_punct(?rp)],
     succeeds r_all_punct(?rp))],
   all rp: succeeds r_reverse([], ?rp) => succeeds r_all_punct(?rp)),
  step([c, cs],
   [all rp: succeeds r_reverse(?cs, ?rp) => succeeds r_all_punct(?rp),
    succeeds r_cond_t(punct, ?c, true),
    succeeds r_all_punct(?cs)],
   [assume(succeeds r_reverse([?c|?cs], ?rp),
     [def succeeds r_reverse([?c|?cs], ?rp) by completion,
      exist(rcs,
       succeeds r_reverse(?cs, ?rcs) & succeeds r_append(?rcs, [?c], ?rp),
       [succeeds r_reverse(?cs, ?rcs) => succeeds r_all_punct(?rcs),
        succeeds r_all_punct(?rcs),
        succeeds r_all_punct([]),
        succeeds r_all_punct([?c]),
        succeeds r_append(?rcs, [?c], ?rp) =>
          (succeeds r_all_punct(?rcs) & succeeds r_all_punct([?c]) =>
            succeeds r_all_punct(?rp)) by lemma(all_punct:append),
        succeeds r_all_punct(?rcs) & succeeds r_all_punct([?c]) =>
          succeeds r_all_punct(?rp),
        succeeds r_all_punct(?rcs) & succeeds r_all_punct([?c]),
        succeeds r_all_punct(?rp)],
       succeeds r_all_punct(?rp))],
     succeeds r_all_punct(?rp))],
   all rp: succeeds r_reverse([?c|?cs], ?rp) => succeeds r_all_punct(?rp))])
).

/* What drop_trailing/2 takes off the reversed address: a prefix, and nothing
   in it but punctuation.

   The continuation's half of the statement carries a hypothesis the first
   half does not -- that the verdict it was handed really is the punctuation
   verdict for that character. It has to: the continuation never looks at the
   character, so on its own `drop_trailing_(true, C, Cs, Out)' says nothing
   about C. The hypothesis is discharged where the two meet, in the clause of
   drop_trailing/2 that asks the condition and passes the answer on. */

:- lemma(drop_trailing:punct_prefix:sim,
(all [xs, out]: succeeds r_drop_trailing(?xs, ?out) =>
  (ex p: succeeds r_append(?p, ?out, ?xs) & succeeds r_all_punct(?p))) &
(all [b, c, cs, out]: succeeds r_drop_trailing_(?b, ?c, ?cs, ?out) =>
  (succeeds r_cond_t(punct, ?c, ?b) =>
    (ex p: succeeds r_append(?p, ?out, [?c|?cs]) & succeeds r_all_punct(?p)))),
induction(
 [all [xs, out]: succeeds r_drop_trailing(?xs, ?out) =>
   (ex p: succeeds r_append(?p, ?out, ?xs) & succeeds r_all_punct(?p)),
  all [b, c, cs, out]: succeeds r_drop_trailing_(?b, ?c, ?cs, ?out) =>
   (succeeds r_cond_t(punct, ?c, ?b) =>
     (ex p: succeeds r_append(?p, ?out, [?c|?cs]) &
       succeeds r_all_punct(?p)))],
 [step([],
   [],
   [succeeds r_append([], [], []),
    succeeds r_all_punct([]),
    succeeds r_append([], [], []) & succeeds r_all_punct([]),
    ex p: succeeds r_append(?p, [], []) & succeeds r_all_punct(?p)],
   ex p: succeeds r_append(?p, [], []) & succeeds r_all_punct(?p)),
  step([c, cs, out, truth],
   [succeeds r_cond_t(punct, ?c, ?truth) =>
      (ex p: succeeds r_append(?p, ?out, [?c|?cs]) &
        succeeds r_all_punct(?p)),
    succeeds r_cond_t(punct, ?c, ?truth),
    succeeds r_drop_trailing_(?truth, ?c, ?cs, ?out)],
   [ex p: succeeds r_append(?p, ?out, [?c|?cs]) & succeeds r_all_punct(?p)],
   ex p: succeeds r_append(?p, ?out, [?c|?cs]) & succeeds r_all_punct(?p)),
  step([c, cs, out],
   [ex p: succeeds r_append(?p, ?out, ?cs) & succeeds r_all_punct(?p),
    succeeds r_drop_trailing(?cs, ?out)],
   [assume(succeeds r_cond_t(punct, ?c, true),
     [exist(p,
       succeeds r_append(?p, ?out, ?cs) & succeeds r_all_punct(?p),
       [succeeds r_append([?c|?p], ?out, [?c|?cs]),
        succeeds r_all_punct([?c|?p]),
        succeeds r_append([?c|?p], ?out, [?c|?cs]) &
          succeeds r_all_punct([?c|?p]),
        ex q: succeeds r_append(?q, ?out, [?c|?cs]) & succeeds r_all_punct(?q)],
       ex q: succeeds r_append(?q, ?out, [?c|?cs]) &
        succeeds r_all_punct(?q))],
     ex q: succeeds r_append(?q, ?out, [?c|?cs]) & succeeds r_all_punct(?q))],
   succeeds r_cond_t(punct, ?c, true) =>
    (ex q: succeeds r_append(?q, ?out, [?c|?cs]) & succeeds r_all_punct(?q))),
  step([c, cs],
   [],
   [assume(succeeds r_cond_t(punct, ?c, false),
     [succeeds r_append([], [?c|?cs], [?c|?cs]),
      succeeds r_all_punct([]),
      succeeds r_append([], [?c|?cs], [?c|?cs]) & succeeds r_all_punct([]),
      ex p: succeeds r_append(?p, [?c|?cs], [?c|?cs]) &
       succeeds r_all_punct(?p)],
     ex p: succeeds r_append(?p, [?c|?cs], [?c|?cs]) &
      succeeds r_all_punct(?p))],
   succeeds r_cond_t(punct, ?c, false) =>
    (ex p: succeeds r_append(?p, [?c|?cs], [?c|?cs]) &
      succeeds r_all_punct(?p)))])
).

:- corollary(drop_trailing:punct_prefix,
all [xs, out]: succeeds r_drop_trailing(?xs, ?out) =>
 (ex p: succeeds r_append(?p, ?out, ?xs) & succeeds r_all_punct(?p)),
assume(succeeds r_drop_trailing(?xs, ?out),
 [(all [xs, out]: succeeds r_drop_trailing(?xs, ?out) =>
    (ex p: succeeds r_append(?p, ?out, ?xs) & succeeds r_all_punct(?p)))
    by lemma(drop_trailing:punct_prefix:sim),
  succeeds r_drop_trailing(?xs, ?out) =>
   (ex p: succeeds r_append(?p, ?out, ?xs) & succeeds r_all_punct(?p)),
  ex p: succeeds r_append(?p, ?out, ?xs) & succeeds r_all_punct(?p)],
 ex p: succeeds r_append(?p, ?out, ?xs) & succeeds r_all_punct(?p))
).

/* Obligation A8: trim_trailing/2 removes only a suffix of the address, and
   removes nothing but punctuation. The address it hands back, followed by
   what was dropped, is the address it was given, character for character --
   so the path cannot come back shortened by a character that belonged to it,
   and the reversal cannot come back unundone. With trim_trailing:functional
   above, this is a statement about THE address it answers with. */

:- corollary(trim_trailing:punct_suffix,
all [cs, out]: succeeds r_list(?cs) & succeeds r_trim_trailing(?cs, ?out) =>
 (ex d: succeeds r_append(?out, ?d, ?cs) & succeeds r_all_punct(?d)),
assume(succeeds r_list(?cs) & succeeds r_trim_trailing(?cs, ?out),
 [def succeeds r_trim_trailing(?cs, ?out) by completion,
  exist([r, dropped],
   succeeds r_reverse(?cs, ?r) & succeeds r_drop_trailing(?r, ?dropped) &
    succeeds r_reverse(?dropped, ?out),
   [succeeds r_drop_trailing(?r, ?dropped) =>
      (ex p: succeeds r_append(?p, ?dropped, ?r) & succeeds r_all_punct(?p))
      by corollary(drop_trailing:punct_prefix),
    ex p: succeeds r_append(?p, ?dropped, ?r) & succeeds r_all_punct(?p),
    exist(p,
     succeeds r_append(?p, ?dropped, ?r) & succeeds r_all_punct(?p),
     [succeeds r_all_punct(?p) => succeeds r_list(?p)
        by lemma(all_punct:list),
      succeeds r_list(?p),
      succeeds r_list(?p) => (ex z: succeeds r_reverse(?p, ?z))
        by lemma(reverse:total),
      ex z: succeeds r_reverse(?p, ?z),
      exist(rp,
       succeeds r_reverse(?p, ?rp),
       [succeeds r_all_punct(?p) =>
          (all q: succeeds r_reverse(?p, ?q) => succeeds r_all_punct(?q))
          by lemma(all_punct:reverse),
        all q: succeeds r_reverse(?p, ?q) => succeeds r_all_punct(?q),
        succeeds r_reverse(?p, ?rp) => succeeds r_all_punct(?rp),
        succeeds r_all_punct(?rp),
        succeeds r_list(?cs) =>
          (all y: succeeds r_reverse(?cs, ?y) => succeeds r_reverse(?y, ?cs))
          by lemma(reverse:involution),
        all y: succeeds r_reverse(?cs, ?y) => succeeds r_reverse(?y, ?cs),
        succeeds r_reverse(?cs, ?r) => succeeds r_reverse(?r, ?cs),
        succeeds r_reverse(?r, ?cs),
        succeeds r_append(?p, ?dropped, ?r) =>
          (all [ras, rbs, rab]: succeeds r_reverse(?p, ?ras) &
            succeeds r_reverse(?dropped, ?rbs) &
            succeeds r_reverse(?r, ?rab) =>
            succeeds r_append(?rbs, ?ras, ?rab))
          by lemma(reverse:append),
        all [ras, rbs, rab]: succeeds r_reverse(?p, ?ras) &
          succeeds r_reverse(?dropped, ?rbs) & succeeds r_reverse(?r, ?rab) =>
          succeeds r_append(?rbs, ?ras, ?rab),
        succeeds r_reverse(?p, ?rp) & succeeds r_reverse(?dropped, ?out) &
          succeeds r_reverse(?r, ?cs) => succeeds r_append(?out, ?rp, ?cs),
        succeeds r_append(?out, ?rp, ?cs),
        succeeds r_append(?out, ?rp, ?cs) & succeeds r_all_punct(?rp),
        ex d: succeeds r_append(?out, ?d, ?cs) & succeeds r_all_punct(?d)],
       ex d: succeeds r_append(?out, ?d, ?cs) & succeeds r_all_punct(?d))],
     ex d: succeeds r_append(?out, ?d, ?cs) & succeeds r_all_punct(?d))],
   ex d: succeeds r_append(?out, ?d, ?cs) & succeeds r_all_punct(?d))],
 ex d: succeeds r_append(?out, ?d, ?cs) & succeeds r_all_punct(?d))
).

/* Four more laws about concatenation, and then the last obligation these
   proofs reach. */

:- lemma(append:left:list,
all [as, bs, cs]: succeeds r_append(?as, ?bs, ?cs) => succeeds r_list(?as),
induction(
 [all [as, bs, cs]: succeeds r_append(?as, ?bs, ?cs) => succeeds r_list(?as)],
 [step([ys],
   [],
   [succeeds r_list([])],
   succeeds r_list([])),
  step([x, xs, ys, zs],
   [succeeds r_list(?xs),
    succeeds r_append(?xs, ?ys, ?zs)],
   [succeeds r_list([?x|?xs])],
   succeeds r_list([?x|?xs]))])
).

:- lemma(append:assoc2,
all [as, bs, ab]: succeeds r_append(?as, ?bs, ?ab) =>
 (all [cs, bc, abc]: succeeds r_append(?bs, ?cs, ?bc) &
   succeeds r_append(?as, ?bc, ?abc) => succeeds r_append(?ab, ?cs, ?abc)),
induction(
 [all [as, bs, ab]: succeeds r_append(?as, ?bs, ?ab) =>
   (all [cs, bc, abc]: succeeds r_append(?bs, ?cs, ?bc) &
     succeeds r_append(?as, ?bc, ?abc) => succeeds r_append(?ab, ?cs, ?abc))],
 [step([ys],
   [],
   [assume(succeeds r_append(?ys, ?cs, ?bc) &
      succeeds r_append([], ?bc, ?abc),
     [def succeeds r_append([], ?bc, ?abc) by completion,
      ?abc = ?bc,
      succeeds r_append(?ys, ?cs, ?abc)],
     succeeds r_append(?ys, ?cs, ?abc))],
   all [cs, bc, abc]: succeeds r_append(?ys, ?cs, ?bc) &
    succeeds r_append([], ?bc, ?abc) => succeeds r_append(?ys, ?cs, ?abc)),
  step([x, xs, ys, zs],
   [all [cs, bc, abc]: succeeds r_append(?ys, ?cs, ?bc) &
      succeeds r_append(?xs, ?bc, ?abc) => succeeds r_append(?zs, ?cs, ?abc),
    succeeds r_append(?xs, ?ys, ?zs)],
   [assume(succeeds r_append(?ys, ?cs, ?bc) &
      succeeds r_append([?x|?xs], ?bc, ?abc),
     [def succeeds r_append([?x|?xs], ?bc, ?abc) by completion,
      exist(z2,
       ?abc = [?x|?z2] & succeeds r_append(?xs, ?bc, ?z2),
       [succeeds r_append(?ys, ?cs, ?bc) & succeeds r_append(?xs, ?bc, ?z2) =>
          succeeds r_append(?zs, ?cs, ?z2),
        succeeds r_append(?zs, ?cs, ?z2),
        succeeds r_append([?x|?zs], ?cs, [?x|?z2]),
        succeeds r_append([?x|?zs], ?cs, ?abc)],
       succeeds r_append([?x|?zs], ?cs, ?abc))],
     succeeds r_append([?x|?zs], ?cs, ?abc))],
   all [cs, bc, abc]: succeeds r_append(?ys, ?cs, ?bc) &
    succeeds r_append([?x|?xs], ?bc, ?abc) =>
    succeeds r_append([?x|?zs], ?cs, ?abc))])
).

/* What take_while_not/4 cuts and what it leaves, put back together, is what
   it was given. Nothing is dropped at the cut and nothing is invented. */

:- lemma(take_while_not:append:sim,
(all [tag, xs, taken, rest]:
  succeeds r_take_while_not(?tag, ?xs, ?taken, ?rest) =>
  succeeds r_append(?taken, ?rest, ?xs)) &
(all [b, tag, c, cs, taken, rest]:
  succeeds r_take_while_not_(?b, ?tag, ?c, ?cs, ?taken, ?rest) =>
  succeeds r_append(?taken, ?rest, [?c|?cs])),
induction(
 [all [tag, xs, taken, rest]:
   succeeds r_take_while_not(?tag, ?xs, ?taken, ?rest) =>
   succeeds r_append(?taken, ?rest, ?xs),
  all [b, tag, c, cs, taken, rest]:
   succeeds r_take_while_not_(?b, ?tag, ?c, ?cs, ?taken, ?rest) =>
   succeeds r_append(?taken, ?rest, [?c|?cs])],
 [step([tag],
   [],
   [succeeds r_append([], [], [])],
   succeeds r_append([], [], [])),
  step([tag, c, cs, taken, rest, truth],
   [succeeds r_append(?taken, ?rest, [?c|?cs]),
    succeeds r_cond_t(?tag, ?c, ?truth),
    succeeds r_take_while_not_(?truth, ?tag, ?c, ?cs, ?taken, ?rest)],
   [],
   succeeds r_append(?taken, ?rest, [?c|?cs])),
  step([tag, c, cs],
   [],
   [succeeds r_append([], [?c|?cs], [?c|?cs])],
   succeeds r_append([], [?c|?cs], [?c|?cs])),
  step([tag, c, cs, taken, rest],
   [succeeds r_append(?taken, ?rest, ?cs),
    succeeds r_take_while_not(?tag, ?cs, ?taken, ?rest)],
   [succeeds r_append([?c|?taken], ?rest, [?c|?cs])],
   succeeds r_append([?c|?taken], ?rest, [?c|?cs]))])
).

:- corollary(take_while_not:append,
all [tag, xs, taken, rest]:
 succeeds r_take_while_not(?tag, ?xs, ?taken, ?rest) =>
 succeeds r_append(?taken, ?rest, ?xs),
assume(succeeds r_take_while_not(?tag, ?xs, ?taken, ?rest),
 [(all [tag, xs, taken, rest]:
    succeeds r_take_while_not(?tag, ?xs, ?taken, ?rest) =>
    succeeds r_append(?taken, ?rest, ?xs))
    by lemma(take_while_not:append:sim),
  succeeds r_take_while_not(?tag, ?xs, ?taken, ?rest) =>
   succeeds r_append(?taken, ?rest, ?xs),
  succeeds r_append(?taken, ?rest, ?xs)],
 succeeds r_append(?taken, ?rest, ?xs))
).

/* A contiguous piece of a tail of the text is a contiguous piece of the
   text. This is what carries the law through the recursion of
   urls_in_text/2, which scans a tail once it has cut an address out. */

:- lemma(piece_of:append,
all [u, rest]: succeeds r_piece_of(?u, ?rest) =>
 (all [pre, whole]: succeeds r_append(?pre, ?rest, ?whole) =>
   succeeds r_piece_of(?u, ?whole)),
assume(succeeds r_piece_of(?u, ?rest),
 [def succeeds r_piece_of(?u, ?rest) by completion,
  exist([before, tail, after],
   succeeds r_append(?before, ?tail, ?rest) &
    succeeds r_append(?u, ?after, ?tail),
   [assume(succeeds r_append(?pre, ?rest, ?whole),
     [succeeds r_append(?pre, ?rest, ?whole) => succeeds r_list(?pre)
        by lemma(append:left:list),
      succeeds r_list(?pre),
      succeeds r_list(?pre) =>
        (all ys: (ex zs: succeeds r_append(?pre, ?ys, ?zs)))
        by lemma(append:total),
      all ys: (ex zs: succeeds r_append(?pre, ?ys, ?zs)),
      ex zs: succeeds r_append(?pre, ?before, ?zs),
      exist(pb,
       succeeds r_append(?pre, ?before, ?pb),
       [succeeds r_append(?pre, ?before, ?pb) =>
          (all [cs, bc, abc]: succeeds r_append(?before, ?cs, ?bc) &
            succeeds r_append(?pre, ?bc, ?abc) =>
            succeeds r_append(?pb, ?cs, ?abc)) by lemma(append:assoc2),
        all [cs, bc, abc]: succeeds r_append(?before, ?cs, ?bc) &
          succeeds r_append(?pre, ?bc, ?abc) =>
          succeeds r_append(?pb, ?cs, ?abc),
        succeeds r_append(?before, ?tail, ?rest) &
          succeeds r_append(?pre, ?rest, ?whole) =>
          succeeds r_append(?pb, ?tail, ?whole),
        succeeds r_append(?pb, ?tail, ?whole),
        succeeds r_piece_of(?u, ?whole)],
       succeeds r_piece_of(?u, ?whole))],
     succeeds r_piece_of(?u, ?whole)),
    all [pre, whole]: succeeds r_append(?pre, ?rest, ?whole) =>
     succeeds r_piece_of(?u, ?whole)],
   all [pre, whole]: succeeds r_append(?pre, ?rest, ?whole) =>
    succeeds r_piece_of(?u, ?whole))],
 all [pre, whole]: succeeds r_append(?pre, ?rest, ?whole) =>
  succeeds r_piece_of(?u, ?whole))
).

/* Obligation A5: every address urls_in_text/2 yields is a contiguous piece
   of the post. The scan reads character by character and then trims a
   punctuation suffix, so there are two ways it could hand back something
   nobody wrote: by joining pieces that were not adjacent, and by trimming
   into the path. The first is what this law rules out; the second is A8,
   which this proof uses to place the trimmed address inside the raw run that
   take_while_not/4 cut.

   The empty-text step is vacuous and has to be: there is no clause of
   r_in/2 for the empty list, so its completion is a contradiction, and the
   implication holds for want of an address to speak about. */

:- lemma(urls_in_text:contiguous:sim,
(all [cs, urls]: succeeds r_urls_in_text(?cs, ?urls) =>
  (all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs))) &
(all [b, c, cs, urls]: succeeds r_urls_in_text_(?b, ?c, ?cs, ?urls) =>
  (all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, [?c|?cs]))),
induction(
 [all [cs, urls]: succeeds r_urls_in_text(?cs, ?urls) =>
   (all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs)),
  all [b, c, cs, urls]: succeeds r_urls_in_text_(?b, ?c, ?cs, ?urls) =>
   (all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, [?c|?cs]))],
 [step([],
   [],
   [assume(succeeds r_in(?u, []),
     [def succeeds r_in(?u, []) by completion,
      ff,
      succeeds r_piece_of(?u, [])],
     succeeds r_piece_of(?u, []))],
   all u: succeeds r_in(?u, []) => succeeds r_piece_of(?u, [])),
  step([c, cs, urls, truth],
   [all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, [?c|?cs]),
    succeeds r_url_start_t([?c|?cs], ?truth),
    succeeds r_urls_in_text_(?truth, ?c, ?cs, ?urls)],
   [],
   all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, [?c|?cs])),
  step([c, cs, url, more, raw, rest],
   [all u: succeeds r_in(?u, ?more) => succeeds r_piece_of(?u, ?rest),
    succeeds r_take_while_not(delim, [?c|?cs], ?raw, ?rest),
    succeeds r_trim_trailing(?raw, ?url),
    succeeds r_urls_in_text(?rest, ?more)],
   [succeeds r_take_while_not(delim, [?c|?cs], ?raw, ?rest) =>
      succeeds r_append(?raw, ?rest, [?c|?cs])
      by corollary(take_while_not:append),
    succeeds r_append(?raw, ?rest, [?c|?cs]),
    succeeds r_append(?raw, ?rest, [?c|?cs]) => succeeds r_list(?raw)
      by lemma(append:left:list),
    succeeds r_list(?raw),
    succeeds r_list(?raw) & succeeds r_trim_trailing(?raw, ?url),
    succeeds r_list(?raw) & succeeds r_trim_trailing(?raw, ?url) =>
      (ex d: succeeds r_append(?url, ?d, ?raw) & succeeds r_all_punct(?d))
      by corollary(trim_trailing:punct_suffix),
    ex d: succeeds r_append(?url, ?d, ?raw) & succeeds r_all_punct(?d),
    exist(d,
     succeeds r_append(?url, ?d, ?raw) & succeeds r_all_punct(?d),
     [succeeds r_all_punct(?d) => succeeds r_list(?d)
        by lemma(all_punct:list),
      succeeds r_list(?d),
      succeeds r_list(?d) => (all ys: (ex zs: succeeds r_append(?d, ?ys, ?zs)))
        by lemma(append:total),
      all ys: (ex zs: succeeds r_append(?d, ?ys, ?zs)),
      ex zs: succeeds r_append(?d, ?rest, ?zs),
      exist(dr,
       succeeds r_append(?d, ?rest, ?dr),
       [succeeds r_append(?url, ?d, ?raw) =>
          (all [cs2, bc, abc]: succeeds r_append(?d, ?cs2, ?bc) &
            succeeds r_append(?raw, ?cs2, ?abc) =>
            succeeds r_append(?url, ?bc, ?abc)) by lemma(append:assoc),
        all [cs2, bc, abc]: succeeds r_append(?d, ?cs2, ?bc) &
          succeeds r_append(?raw, ?cs2, ?abc) =>
          succeeds r_append(?url, ?bc, ?abc),
        succeeds r_append(?d, ?rest, ?dr) &
          succeeds r_append(?raw, ?rest, [?c|?cs]) =>
          succeeds r_append(?url, ?dr, [?c|?cs]),
        succeeds r_append(?url, ?dr, [?c|?cs]),
        succeeds r_append([], [?c|?cs], [?c|?cs]),
        succeeds r_piece_of(?url, [?c|?cs]),
        assume(succeeds r_in(?u, [?url|?more]),
         [def succeeds r_in(?u, [?url|?more]) by completion,
          cases(?u = ?url,
           [succeeds r_piece_of(?u, [?c|?cs])],
           succeeds r_in(?u, ?more),
           [succeeds r_in(?u, ?more) => succeeds r_piece_of(?u, ?rest),
            succeeds r_piece_of(?u, ?rest),
            succeeds r_piece_of(?u, ?rest) =>
              (all [pre, whole]: succeeds r_append(?pre, ?rest, ?whole) =>
                succeeds r_piece_of(?u, ?whole)) by lemma(piece_of:append),
            all [pre, whole]: succeeds r_append(?pre, ?rest, ?whole) =>
              succeeds r_piece_of(?u, ?whole),
            succeeds r_append(?raw, ?rest, [?c|?cs]) =>
              succeeds r_piece_of(?u, [?c|?cs]),
            succeeds r_piece_of(?u, [?c|?cs])],
           succeeds r_piece_of(?u, [?c|?cs]))],
         succeeds r_piece_of(?u, [?c|?cs])),
        all u: succeeds r_in(?u, [?url|?more]) =>
         succeeds r_piece_of(?u, [?c|?cs])],
       all u: succeeds r_in(?u, [?url|?more]) =>
        succeeds r_piece_of(?u, [?c|?cs]))],
     all u: succeeds r_in(?u, [?url|?more]) =>
      succeeds r_piece_of(?u, [?c|?cs]))],
   all u: succeeds r_in(?u, [?url|?more]) =>
    succeeds r_piece_of(?u, [?c|?cs])),
  step([c, cs, urls],
   [all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs),
    succeeds r_urls_in_text(?cs, ?urls)],
   [assume(succeeds r_in(?u, ?urls),
     [succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs),
      succeeds r_piece_of(?u, ?cs),
      succeeds r_piece_of(?u, ?cs) =>
        (all [pre, whole]: succeeds r_append(?pre, ?cs, ?whole) =>
          succeeds r_piece_of(?u, ?whole)) by lemma(piece_of:append),
      all [pre, whole]: succeeds r_append(?pre, ?cs, ?whole) =>
        succeeds r_piece_of(?u, ?whole),
      succeeds r_append([], ?cs, ?cs),
      succeeds r_append([?c], ?cs, [?c|?cs]),
      succeeds r_append([?c], ?cs, [?c|?cs]) => succeeds r_piece_of(?u, [?c|?cs]),
      succeeds r_piece_of(?u, [?c|?cs])],
     succeeds r_piece_of(?u, [?c|?cs]))],
   all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, [?c|?cs]))])
).

:- corollary(urls_in_text:contiguous,
all [cs, urls, u]: succeeds r_urls_in_text(?cs, ?urls) &
 succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs),
assume(succeeds r_urls_in_text(?cs, ?urls) & succeeds r_in(?u, ?urls),
 [(all [cs, urls]: succeeds r_urls_in_text(?cs, ?urls) =>
    (all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs)))
    by lemma(urls_in_text:contiguous:sim),
  succeeds r_urls_in_text(?cs, ?urls) =>
   (all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs)),
  all u: succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs),
  succeeds r_in(?u, ?urls) => succeeds r_piece_of(?u, ?cs),
  succeeds r_piece_of(?u, ?cs)],
 succeeds r_piece_of(?u, ?cs))
).

:- bye(recogniser).
