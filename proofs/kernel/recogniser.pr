/* Theorems about the recogniser of src/link_shortener.pl, checked against the
   mirror in recogniser.pl by LPTP:

       make check-proofs

   Two kinds of statement live here. The first kind is that every reified
   condition in the module is a FUNCTION into the two truth values: one
   answer per input, and that answer true or false. That is not decoration.
   if_/3 is sound only on such conditions: one with two answers turns a post
   into several answers on backtracking, and one that can answer anything
   else -- or fail -- makes if_/3 fail where the code reads as a total
   dispatch, which in this collector means a post stored with no expansion at
   all. The second kind is the laws of obligations.tsv, which say what the
   rewriter does to a post rather than merely that it answers.

   The pattern of the functionality proofs is always the same: induct over the
   derivation of the first call, so that each step fixes the clause and the
   SECOND call can be unfolded by completion against that clause alone. The
   direct formulation (induct over one argument) does not work, because the
   two calls would be unfolded independently and the case analysis would be
   quadratic in the number of clauses. */

:- initialize.
:- thm_file($(proofs)/kernel/recogniser).
:- tex_file($(proofs)/latex/kernel_recogniser).

:- needs_gr($(proofs)/kernel/recogniser).

/* Reified membership is the leaf every character condition bottoms out in,
   so it is the leaf these proofs bottom out in too. Nothing here needs the
   list to be proper: the induction is over the derivation, and the clause
   that walks the tail is the only one that recurses. */

:- lemma(memb:boolean,
all [x, xs, b]: succeeds r_memb(?x, ?xs, ?b) => ?b = true \/ ?b = false,
induction(
 [all [x, xs, b]: succeeds r_memb(?x, ?xs, ?b) => ?b = true \/ ?b = false],
 [step([x, ys],
   [],
   [],
   true = true \/ true = false),
  step([x, y, ys, b],
   [?b = true \/ ?b = false,
    ?x <> ?y,
    succeeds r_memb(?x, ?ys, ?b)],
   [],
   ?b = true \/ ?b = false),
  step([x],
   [],
   [],
   false = true \/ false = false)])
).

/* One answer per input, for the same leaf. The induction is over the
   derivation of the FIRST call so that each step pins the clause down, and
   the second call is then unfolded by completion against that one clause --
   where the clause that walks the tail contradicts the clause that matched
   the head, since one needs x and y equal and the other needs them apart. */

:- lemma(memb:functional,
all [x, xs, b1, b2]: succeeds r_memb(?x, ?xs, ?b1) &
 succeeds r_memb(?x, ?xs, ?b2) => ?b1 = ?b2,
[induction(
  [all [x, xs, b1]: succeeds r_memb(?x, ?xs, ?b1) =>
    (all b2: succeeds r_memb(?x, ?xs, ?b2) => ?b1 = ?b2)],
  [step([x, ys],
    [],
    assume(succeeds r_memb(?x, [?x|?ys], ?b2),
     [def succeeds r_memb(?x, [?x|?ys], ?b2) by completion,
      cases(?b2 = true,
       ?b2 = true,
       ?x <> ?x & succeeds r_memb(?x, ?ys, ?b2),
       ff,
       true = ?b2)],
     true = ?b2),
    all b2: succeeds r_memb(?x, [?x|?ys], ?b2) => true = ?b2),
   step([x, y, ys, b1],
    [all b2: succeeds r_memb(?x, ?ys, ?b2) => ?b1 = ?b2,
     ?x <> ?y,
     succeeds r_memb(?x, ?ys, ?b1)],
    assume(succeeds r_memb(?x, [?y|?ys], ?b2),
     [def succeeds r_memb(?x, [?y|?ys], ?b2) by completion,
      cases(?x = ?y & ?b2 = true,
       ff,
       ?x <> ?y & succeeds r_memb(?x, ?ys, ?b2),
       [succeeds r_memb(?x, ?ys, ?b2) => ?b1 = ?b2,
        ?b1 = ?b2],
       ?b1 = ?b2)],
     ?b1 = ?b2),
    all b2: succeeds r_memb(?x, [?y|?ys], ?b2) => ?b1 = ?b2),
   step([x],
    [],
    assume(succeeds r_memb(?x, [], ?b2),
     [def succeeds r_memb(?x, [], ?b2) by completion,
      ?b2 = false],
     false = ?b2),
    all b2: succeeds r_memb(?x, [], ?b2) => false = ?b2)]),
 assume(succeeds r_memb(?x, ?xs, ?b1) & succeeds r_memb(?x, ?xs, ?b2),
  [succeeds r_memb(?x, ?xs, ?b1) =>
    (all b2: succeeds r_memb(?x, ?xs, ?b2) => ?b1 = ?b2),
   all b2: succeeds r_memb(?x, ?xs, ?b2) => ?b1 = ?b2,
   succeeds r_memb(?x, ?xs, ?b2) => ?b1 = ?b2,
   ?b1 = ?b2],
  ?b1 = ?b2)]
).

/* Every character condition of the module answers, and answers true or
   false. This is obligation A9 made about the leaves that obligation's
   subject is built from: a condition that answered something else, or failed
   instead of answering, would make the if_/3 above it fail, and the scan of
   the whole post fails with it -- which is how a post reaches storage with
   no expansion at all. The tags are the conditions of src/link_shortener.pl,
   one for one; the mirror's comment says which. */

:- lemma(cond:boolean,
all [t, c, b]: succeeds r_cond_t(?t, ?c, ?b) => ?b = true \/ ?b = false,
induction(
 [all [t, c, b]: succeeds r_cond_t(?t, ?c, ?b) => ?b = true \/ ?b = false],
 [
  step([c, b],
   [succeeds r_memb(?c,
     [0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6a,0x6b,0x6c,0x6d,0x6e,0x6f,0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,0x4e,0x4f,0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x20,0x0a,0x0d,0x09,0x22,0x3c,0x3e,0xa0], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x2e,0x2c,0x3b,0x3a,0x21,0x3f,0x29,0x22,0x27,0xbb,0x2026], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x3f,0x23], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x22,0x27,0x3b,0x20], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x3e], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x22], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x26], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x2f], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x3f], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false),
  step([c, b],
   [succeeds r_memb(?c,
     [0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6a,0x6b,0x6c,0x6d,
      0x6e,0x6f,0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a,
      0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,
      0x4e,0x4f,0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a,
      0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39,0x2d,0x5f], ?b)],
   [?b = true \/ ?b = false by lemma(memb:boolean)],
   ?b = true \/ ?b = false)])
).

/* And answers once. Together with cond:boolean that is everything if_/3 asks
   of a condition it dispatches on: a second answer would come back on
   backtracking and turn one post into two.

   Why this is an induction and not a case analysis over the thirteen
   clauses: the induction fixes the tag to a constant in each step, so the
   SECOND call unfolds by completion against that step's clause alone.
   Unfolding both calls independently would leave 169 cases, 156 of them
   refuted by the tag. */

:- lemma(cond:functional,
all [t, c, b1, b2]: succeeds r_cond_t(?t, ?c, ?b1) &
 succeeds r_cond_t(?t, ?c, ?b2) => ?b1 = ?b2,
[induction(
  [all [t, c, b1]: succeeds r_cond_t(?t, ?c, ?b1) =>
    (all b2: succeeds r_cond_t(?t, ?c, ?b2) => ?b1 = ?b2)],
  [
  step([c, b1],
   [succeeds r_memb(?c,
     [0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6a,0x6b,0x6c,0x6d,0x6e,0x6f,0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a], ?b1)],
   assume(succeeds r_cond_t(lower, ?c, ?b2),
    [def succeeds r_cond_t(lower, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6a,0x6b,0x6c,0x6d,0x6e,0x6f,0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(lower, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,0x4e,0x4f,0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a], ?b1)],
   assume(succeeds r_cond_t(upper, ?c, ?b2),
    [def succeeds r_cond_t(upper, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,0x4e,0x4f,0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(upper, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39], ?b1)],
   assume(succeeds r_cond_t(digit, ?c, ?b2),
    [def succeeds r_cond_t(digit, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(digit, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x20,0x0a,0x0d,0x09,0x22,0x3c,0x3e,0xa0], ?b1)],
   assume(succeeds r_cond_t(delim, ?c, ?b2),
    [def succeeds r_cond_t(delim, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x20,0x0a,0x0d,0x09,0x22,0x3c,0x3e,0xa0], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(delim, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x2e,0x2c,0x3b,0x3a,0x21,0x3f,0x29,0x22,0x27,0xbb,0x2026], ?b1)],
   assume(succeeds r_cond_t(punct, ?c, ?b2),
    [def succeeds r_cond_t(punct, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x2e,0x2c,0x3b,0x3a,0x21,0x3f,0x29,0x22,0x27,0xbb,0x2026], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(punct, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x3f,0x23], ?b1)],
   assume(succeeds r_cond_t(query, ?c, ?b2),
    [def succeeds r_cond_t(query, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x3f,0x23], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(query, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x22,0x27,0x3b,0x20], ?b1)],
   assume(succeeds r_cond_t(urlend, ?c, ?b2),
    [def succeeds r_cond_t(urlend, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x22,0x27,0x3b,0x20], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(urlend, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x3e], ?b1)],
   assume(succeeds r_cond_t(tagclose, ?c, ?b2),
    [def succeeds r_cond_t(tagclose, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x3e], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(tagclose, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x22], ?b1)],
   assume(succeeds r_cond_t(quote, ?c, ?b2),
    [def succeeds r_cond_t(quote, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x22], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(quote, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x26], ?b1)],
   assume(succeeds r_cond_t(amp, ?c, ?b2),
    [def succeeds r_cond_t(amp, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x26], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(amp, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x2f], ?b1)],
   assume(succeeds r_cond_t(slash, ?c, ?b2),
    [def succeeds r_cond_t(slash, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x2f], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(slash, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x3f], ?b1)],
   assume(succeeds r_cond_t(question, ?c, ?b2),
    [def succeeds r_cond_t(question, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x3f], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(question, ?c, ?b2) => ?b1 = ?b2),
  step([c, b1],
   [succeeds r_memb(?c,
     [0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6a,0x6b,0x6c,0x6d,
      0x6e,0x6f,0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a,
      0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,
      0x4e,0x4f,0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a,
      0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39,0x2d,0x5f], ?b1)],
   assume(succeeds r_cond_t(token, ?c, ?b2),
    [def succeeds r_cond_t(token, ?c, ?b2) by completion,
     succeeds r_memb(?c, [0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6a,0x6b,0x6c,0x6d,
      0x6e,0x6f,0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a,
      0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,
      0x4e,0x4f,0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a,
      0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39,0x2d,0x5f], ?b2),
     ?b1 = ?b2 by lemma(memb:functional)],
    ?b1 = ?b2),
   all b2: succeeds r_cond_t(token, ?c, ?b2) => ?b1 = ?b2)]),
 assume(succeeds r_cond_t(?t, ?c, ?b1) & succeeds r_cond_t(?t, ?c, ?b2),
  [succeeds r_cond_t(?t, ?c, ?b1) =>
    (all b2: succeeds r_cond_t(?t, ?c, ?b2) => ?b1 = ?b2),
   all b2: succeeds r_cond_t(?t, ?c, ?b2) => ?b1 = ?b2,
   succeeds r_cond_t(?t, ?c, ?b2) => ?b1 = ?b2,
   ?b1 = ?b2],
  ?b1 = ?b2)]
).

/* prefix_t/3 answers, and answers once, for EVERY pair of lists -- it is the
   condition the rewriter dispatches on at every character of every post, and
   the one search/3 and first_match/3 are built out of. The fourth clause,
   the one that negates the equality of two characters, is what the shipped
   if_(P = C, ...) becomes here, and it is why the two walking clauses cannot
   both apply: one needs the heads equal, the other needs them apart. */

:- lemma(prefix:boolean,
all [ps, xs, b]: succeeds r_prefix_t(?ps, ?xs, ?b) => ?b = true \/ ?b = false,
induction(
 [all [ps, xs, b]: succeeds r_prefix_t(?ps, ?xs, ?b) => ?b = true \/ ?b = false],
 [step([xs],
   [],
   [],
   true = true \/ true = false),
  step([p, ps],
   [],
   [],
   false = true \/ false = false),
  step([p, ps, cs, b],
   [?b = true \/ ?b = false,
    succeeds r_prefix_t(?ps, ?cs, ?b)],
   [],
   ?b = true \/ ?b = false),
  step([p, ps, c, cs],
   [?p <> ?c],
   [],
   false = true \/ false = false)])
).

:- lemma(prefix:functional,
all [ps, xs, b1, b2]: succeeds r_prefix_t(?ps, ?xs, ?b1) &
 succeeds r_prefix_t(?ps, ?xs, ?b2) => ?b1 = ?b2,
[induction(
  [all [ps, xs, b1]: succeeds r_prefix_t(?ps, ?xs, ?b1) =>
    (all b2: succeeds r_prefix_t(?ps, ?xs, ?b2) => ?b1 = ?b2)],
  [step([xs],
    [],
    assume(succeeds r_prefix_t([], ?xs, ?b2),
     [def succeeds r_prefix_t([], ?xs, ?b2) by completion,
      ?b2 = true],
     true = ?b2),
    all b2: succeeds r_prefix_t([], ?xs, ?b2) => true = ?b2),
   step([p, ps],
    [],
    assume(succeeds r_prefix_t([?p|?ps], [], ?b2),
     [def succeeds r_prefix_t([?p|?ps], [], ?b2) by completion,
      ?b2 = false],
     false = ?b2),
    all b2: succeeds r_prefix_t([?p|?ps], [], ?b2) => false = ?b2),
   step([p, ps, cs, b1],
    [all b2: succeeds r_prefix_t(?ps, ?cs, ?b2) => ?b1 = ?b2,
     succeeds r_prefix_t(?ps, ?cs, ?b1)],
    assume(succeeds r_prefix_t([?p|?ps], [?p|?cs], ?b2),
     [def succeeds r_prefix_t([?p|?ps], [?p|?cs], ?b2) by completion,
      cases(succeeds r_prefix_t(?ps, ?cs, ?b2),
       [succeeds r_prefix_t(?ps, ?cs, ?b2) => ?b1 = ?b2,
        ?b1 = ?b2],
       ?b2 = false & ?p <> ?p,
       ff,
       ?b1 = ?b2)],
     ?b1 = ?b2),
    all b2: succeeds r_prefix_t([?p|?ps], [?p|?cs], ?b2) => ?b1 = ?b2),
   step([p, ps, c, cs],
    [?p <> ?c],
    assume(succeeds r_prefix_t([?p|?ps], [?c|?cs], ?b2),
     [def succeeds r_prefix_t([?p|?ps], [?c|?cs], ?b2) by completion,
      cases(?p = ?c & succeeds r_prefix_t(?ps, ?cs, ?b2),
       ff,
       ?b2 = false & ?p <> ?c,
       ?b2 = false,
       false = ?b2)],
     false = ?b2),
    all b2: succeeds r_prefix_t([?p|?ps], [?c|?cs], ?b2) => false = ?b2)]),
 assume(succeeds r_prefix_t(?ps, ?xs, ?b1) & succeeds r_prefix_t(?ps, ?xs, ?b2),
  [succeeds r_prefix_t(?ps, ?xs, ?b1) =>
    (all b2: succeeds r_prefix_t(?ps, ?xs, ?b2) => ?b1 = ?b2),
   all b2: succeeds r_prefix_t(?ps, ?xs, ?b2) => ?b1 = ?b2,
   succeeds r_prefix_t(?ps, ?xs, ?b2) => ?b1 = ?b2,
   ?b1 = ?b2],
  ?b1 = ?b2)]
).

/* The tagged result of a search read as a truth value. Two clauses over two
   disjoint shapes, which is the whole of it. */

:- lemma(found_truth:boolean,
all [r, b]: succeeds r_found_truth(?r, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_found_truth(?r, ?b),
 [def succeeds r_found_truth(?r, ?b) by completion,
  cases(?r = not_found & ?b = false,
   [?b = true \/ ?b = false],
   ex rest: ?r = found(?rest) & ?b = true,
   [exist(rest, ?r = found(?rest) & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false],
     ?b = true \/ ?b = false)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(found_truth:functional,
all [r, b1, b2]: succeeds r_found_truth(?r, ?b1) &
 succeeds r_found_truth(?r, ?b2) => ?b1 = ?b2,
assume(succeeds r_found_truth(?r, ?b1) & succeeds r_found_truth(?r, ?b2),
 [def succeeds r_found_truth(?r, ?b1) by completion,
  def succeeds r_found_truth(?r, ?b2) by completion,
  cases(?r = not_found & ?b1 = false,
   [cases(?r = not_found & ?b2 = false,
     [?b1 = ?b2],
     ex rest: ?r = found(?rest) & ?b2 = true,
     [exist(rest, ?r = found(?rest) & ?b2 = true,
       [ff],
       ?b1 = ?b2)],
     ?b1 = ?b2)],
   ex rest: ?r = found(?rest) & ?b1 = true,
   [exist(rest1, ?r = found(?rest1) & ?b1 = true,
     [cases(?r = not_found & ?b2 = false,
       [ff],
       ex rest: ?r = found(?rest) & ?b2 = true,
       [exist(rest2, ?r = found(?rest2) & ?b2 = true,
         [?b1 = ?b2],
         ?b1 = ?b2)],
       ?b1 = ?b2)],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* strip_prefix/3 hands back one rest, which is what makes search/3's
   found(Rest) a function of where the needle was found. */

:- lemma(strip_prefix:functional,
all [ps, xs, r1, r2]: succeeds r_strip_prefix(?ps, ?xs, ?r1) &
 succeeds r_strip_prefix(?ps, ?xs, ?r2) => ?r1 = ?r2,
[induction(
  [all [ps, xs, r1]: succeeds r_strip_prefix(?ps, ?xs, ?r1) =>
    (all r2: succeeds r_strip_prefix(?ps, ?xs, ?r2) => ?r1 = ?r2)],
  [step([rest],
    [],
    assume(succeeds r_strip_prefix([], ?rest, ?r2),
     [def succeeds r_strip_prefix([], ?rest, ?r2) by completion,
      ?r2 = ?rest],
     ?rest = ?r2),
    all r2: succeeds r_strip_prefix([], ?rest, ?r2) => ?rest = ?r2),
   step([p, ps, cs, rest],
    [all r2: succeeds r_strip_prefix(?ps, ?cs, ?r2) => ?rest = ?r2,
     succeeds r_strip_prefix(?ps, ?cs, ?rest)],
    assume(succeeds r_strip_prefix([?p|?ps], [?p|?cs], ?r2),
     [def succeeds r_strip_prefix([?p|?ps], [?p|?cs], ?r2) by completion,
      succeeds r_strip_prefix(?ps, ?cs, ?r2),
      succeeds r_strip_prefix(?ps, ?cs, ?r2) => ?rest = ?r2,
      ?rest = ?r2],
     ?rest = ?r2),
    all r2: succeeds r_strip_prefix([?p|?ps], [?p|?cs], ?r2) => ?rest = ?r2)]),
 assume(succeeds r_strip_prefix(?ps, ?xs, ?r1) &
   succeeds r_strip_prefix(?ps, ?xs, ?r2),
  [succeeds r_strip_prefix(?ps, ?xs, ?r1) =>
    (all r2: succeeds r_strip_prefix(?ps, ?xs, ?r2) => ?r1 = ?r2),
   all r2: succeeds r_strip_prefix(?ps, ?xs, ?r2) => ?r1 = ?r2,
   succeeds r_strip_prefix(?ps, ?xs, ?r2) => ?r1 = ?r2,
   ?r1 = ?r2],
  ?r1 = ?r2)]
).

/* search/3 finds one place, and so contains_sub_t/3 has one answer. The
   induction is simultaneous over search/3 and the continuation it hands the
   prefix verdict to, because the two call each other: that is what the
   shipped if_(prefix_t(...), strip, search-on) becomes once if_/3 is gone. */

:- lemma(search:functional:sim,
(all [n, xs, r1]: succeeds r_search(?n, ?xs, ?r1) =>
  (all r2: succeeds r_search(?n, ?xs, ?r2) => ?r1 = ?r2)) &
(all [b, n, c, cs, r1]: succeeds r_search_(?b, ?n, ?c, ?cs, ?r1) =>
  (all r2: succeeds r_search_(?b, ?n, ?c, ?cs, ?r2) => ?r1 = ?r2)),
induction(
 [all [n, xs, r1]: succeeds r_search(?n, ?xs, ?r1) =>
   (all r2: succeeds r_search(?n, ?xs, ?r2) => ?r1 = ?r2),
  all [b, n, c, cs, r1]: succeeds r_search_(?b, ?n, ?c, ?cs, ?r1) =>
   (all r2: succeeds r_search_(?b, ?n, ?c, ?cs, ?r2) => ?r1 = ?r2)],
 [step([n],
   [],
   assume(succeeds r_search(?n, [], ?r2),
    [def succeeds r_search(?n, [], ?r2) by completion,
     ?r2 = not_found],
    not_found = ?r2),
   all r2: succeeds r_search(?n, [], ?r2) => not_found = ?r2),
  step([n, c, cs, r1, truth],
   [all r2: succeeds r_search_(?truth, ?n, ?c, ?cs, ?r2) => ?r1 = ?r2,
    succeeds r_prefix_t(?n, [?c|?cs], ?truth),
    succeeds r_search_(?truth, ?n, ?c, ?cs, ?r1)],
   assume(succeeds r_search(?n, [?c|?cs], ?r2),
    [def succeeds r_search(?n, [?c|?cs], ?r2) by completion,
     exist(t2,
      succeeds r_prefix_t(?n, [?c|?cs], ?t2) &
       succeeds r_search_(?t2, ?n, ?c, ?cs, ?r2),
      [succeeds r_prefix_t(?n, [?c|?cs], ?truth) &
         succeeds r_prefix_t(?n, [?c|?cs], ?t2) =>
         ?truth = ?t2 by lemma(prefix:functional),
       ?truth = ?t2,
       succeeds r_search_(?truth, ?n, ?c, ?cs, ?r2),
       succeeds r_search_(?truth, ?n, ?c, ?cs, ?r2) => ?r1 = ?r2,
       ?r1 = ?r2],
      ?r1 = ?r2)],
    ?r1 = ?r2),
   all r2: succeeds r_search(?n, [?c|?cs], ?r2) => ?r1 = ?r2),
  step([n, c, cs, rest],
   [succeeds r_strip_prefix(?n, [?c|?cs], ?rest)],
   assume(succeeds r_search_(true, ?n, ?c, ?cs, ?r2),
    [def succeeds r_search_(true, ?n, ?c, ?cs, ?r2) by completion,
     exist(rest2,
      ?r2 = found(?rest2) & succeeds r_strip_prefix(?n, [?c|?cs], ?rest2),
      [succeeds r_strip_prefix(?n, [?c|?cs], ?rest) &
         succeeds r_strip_prefix(?n, [?c|?cs], ?rest2) =>
         ?rest = ?rest2 by lemma(strip_prefix:functional),
       ?rest = ?rest2,
       found(?rest) = ?r2],
      found(?rest) = ?r2)],
    found(?rest) = ?r2),
   all r2: succeeds r_search_(true, ?n, ?c, ?cs, ?r2) => found(?rest) = ?r2),
  step([n, c, cs, r1],
   [all r2: succeeds r_search(?n, ?cs, ?r2) => ?r1 = ?r2,
    succeeds r_search(?n, ?cs, ?r1)],
   assume(succeeds r_search_(false, ?n, ?c, ?cs, ?r2),
    [def succeeds r_search_(false, ?n, ?c, ?cs, ?r2) by completion,
     succeeds r_search(?n, ?cs, ?r2),
     succeeds r_search(?n, ?cs, ?r2) => ?r1 = ?r2,
     ?r1 = ?r2],
    ?r1 = ?r2),
   all r2: succeeds r_search_(false, ?n, ?c, ?cs, ?r2) => ?r1 = ?r2)])
).

:- corollary(search:functional,
all [n, xs, r1, r2]: succeeds r_search(?n, ?xs, ?r1) &
 succeeds r_search(?n, ?xs, ?r2) => ?r1 = ?r2,
assume(succeeds r_search(?n, ?xs, ?r1) & succeeds r_search(?n, ?xs, ?r2),
 [(all [n, xs, r1]: succeeds r_search(?n, ?xs, ?r1) =>
    (all r2: succeeds r_search(?n, ?xs, ?r2) => ?r1 = ?r2)) by lemma(search:functional:sim),
  succeeds r_search(?n, ?xs, ?r1) =>
   (all r2: succeeds r_search(?n, ?xs, ?r2) => ?r1 = ?r2),
  all r2: succeeds r_search(?n, ?xs, ?r2) => ?r1 = ?r2,
  succeeds r_search(?n, ?xs, ?r2) => ?r1 = ?r2,
  ?r1 = ?r2],
 ?r1 = ?r2)
).

/* contains_sub_t/3, the condition the tag reader dispatches on and the one
   segment_truth/2 asks before it will call a path opaque. */

:- lemma(contains_sub:boolean,
all [n, h, b]: succeeds r_contains_sub_t(?n, ?h, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_contains_sub_t(?n, ?h, ?b),
 [def succeeds r_contains_sub_t(?n, ?h, ?b) by completion,
  exist(r,
   succeeds r_search(?n, ?h, ?r) & succeeds r_found_truth(?r, ?b),
   [?b = true \/ ?b = false by lemma(found_truth:boolean)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(contains_sub:functional,
all [n, h, b1, b2]: succeeds r_contains_sub_t(?n, ?h, ?b1) &
 succeeds r_contains_sub_t(?n, ?h, ?b2) => ?b1 = ?b2,
assume(succeeds r_contains_sub_t(?n, ?h, ?b1) &
  succeeds r_contains_sub_t(?n, ?h, ?b2),
 [def succeeds r_contains_sub_t(?n, ?h, ?b1) by completion,
  def succeeds r_contains_sub_t(?n, ?h, ?b2) by completion,
  exist(r1,
   succeeds r_search(?n, ?h, ?r1) & succeeds r_found_truth(?r1, ?b1),
   [exist(r2,
     succeeds r_search(?n, ?h, ?r2) & succeeds r_found_truth(?r2, ?b2),
     [succeeds r_search(?n, ?h, ?r1) & succeeds r_search(?n, ?h, ?r2) =>
        ?r1 = ?r2 by corollary(search:functional),
      ?r1 = ?r2,
      succeeds r_found_truth(?r1, ?b2),
      succeeds r_found_truth(?r1, ?b1) & succeeds r_found_truth(?r1, ?b2) =>
        ?b1 = ?b2 by lemma(found_truth:functional),
      ?b1 = ?b2],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* Obligation A4: rewrite_urls/3 leaves the text alone when no pair's short
   form occurs in it. This is the law the day pass needs, because that pass
   rewrites every post of a day from one pair list: a pair meant for another
   post must leave this one untouched, or one article's address is stored
   under another's post and the rewrite is irreversible once the day is
   ranked.

   `no pair occurs in the text' is r_no_match/2: first_match/3 answers none
   at this position and at every tail of it. That is the whole of what
   rewrite_urls/3 ever asks of the text -- it walks positions and their tails
   and nothing else -- so the hypothesis is exactly as strong as the law
   needs and no stronger. It also makes the text a proper list, which is why
   no properness hypothesis appears beside it. */

:- lemma(rewrite:identity,
all [cs, pairs]: succeeds r_no_match(?cs, ?pairs) =>
 succeeds r_rewrite_urls(?cs, ?pairs, ?cs),
induction(
 [all [cs, pairs]: succeeds r_no_match(?cs, ?pairs) =>
   succeeds r_rewrite_urls(?cs, ?pairs, ?cs)],
 [step([pairs],
   [],
   [succeeds r_rewrite_urls([], ?pairs, [])],
   succeeds r_rewrite_urls([], ?pairs, [])),
  step([c, cs, pairs],
   [succeeds r_rewrite_urls(?cs, ?pairs, ?cs),
    succeeds r_first_match([?c|?cs], ?pairs, none),
    succeeds r_no_match(?cs, ?pairs)],
   [succeeds r_rewrite_step(none, ?c, ?cs, ?pairs, [?c|?cs]),
    succeeds r_rewrite_urls([?c|?cs], ?pairs, [?c|?cs])],
   succeeds r_rewrite_urls([?c|?cs], ?pairs, [?c|?cs]))])
).

/* Obligation A3 is A4 at the empty pair list, which is the path taken
   whenever the ledger knows nothing yet -- most of the time, and every time
   a day's first post is read. There is nothing to match against, so
   first_match/3 answers none at every position of any proper list. */

:- lemma(no_match:empty,
all cs: succeeds r_list(?cs) => succeeds r_no_match(?cs, []),
induction(
 [all cs: succeeds r_list(?cs) => succeeds r_no_match(?cs, [])],
 [step([],
   [],
   [succeeds r_no_match([], [])],
   succeeds r_no_match([], [])),
  step([x, xs],
   [succeeds r_no_match(?xs, []),
    succeeds r_list(?xs)],
   [succeeds r_first_match([?x|?xs], [], none),
    succeeds r_no_match([?x|?xs], [])],
   succeeds r_no_match([?x|?xs], []))])
).

:- corollary(rewrite:identity:empty,
all cs: succeeds r_list(?cs) => succeeds r_rewrite_urls(?cs, [], ?cs),
assume(succeeds r_list(?cs),
 [succeeds r_no_match(?cs, []) by lemma(no_match:empty),
  succeeds r_no_match(?cs, []) => succeeds r_rewrite_urls(?cs, [], ?cs)
    by lemma(rewrite:identity),
  succeeds r_rewrite_urls(?cs, [], ?cs)],
 succeeds r_rewrite_urls(?cs, [], ?cs))
).

/* Obligation A7: page_destination/2 prefers the noscript refresh to the
   canonical link. The interstitials these redirectors answer with carry
   their own canonical link, which claims the interstitial; reading it
   instead of the refresh target stores the redirector as the article.

   The statement is unconditional in the page: GIVEN that the first <meta>
   tag mentioning `refresh' carries a content attribute, and that the
   attribute holds a `url=', the answer is that target -- whatever else the
   page says about itself. No hypothesis excludes a canonical link, and that
   is the point: the proof goes through the refresh clause of
   refresh_destination/3 and claimed_destination/2 is never reached. */

:- lemma(destination:prefers:refresh,
all [html, content, after, url, rest]:
 succeeds r_tag_attribute([0x3c,0x6d,0x65,0x74,0x61],
   [0x72,0x65,0x66,0x72,0x65,0x73,0x68],
   [0x63,0x6f,0x6e,0x74,0x65,0x6e,0x74], ?html, attribute(?content)) &
 succeeds r_search([0x75,0x72,0x6c,0x3d], ?content, found(?after)) &
 succeeds r_take_while_not(urlend, ?after, ?url, ?rest) =>
 succeeds r_page_destination(?html, destination(?url)),
assume(succeeds r_tag_attribute([0x3c,0x6d,0x65,0x74,0x61],
    [0x72,0x65,0x66,0x72,0x65,0x73,0x68],
    [0x63,0x6f,0x6e,0x74,0x65,0x6e,0x74], ?html, attribute(?content)) &
  succeeds r_search([0x75,0x72,0x6c,0x3d], ?content, found(?after)) &
  succeeds r_take_while_not(urlend, ?after, ?url, ?rest),
 [succeeds r_refresh_url(found(?after), ?html, destination(?url)),
  succeeds r_refresh_destination(attribute(?content), ?html,
    destination(?url)),
  succeeds r_page_destination(?html, destination(?url))],
 succeeds r_page_destination(?html, destination(?url)))
).

:- corollary(destination_url:prefers:refresh,
all [html, content, after, url, rest]:
 succeeds r_tag_attribute([0x3c,0x6d,0x65,0x74,0x61],
   [0x72,0x65,0x66,0x72,0x65,0x73,0x68],
   [0x63,0x6f,0x6e,0x74,0x65,0x6e,0x74], ?html, attribute(?content)) &
 succeeds r_search([0x75,0x72,0x6c,0x3d], ?content, found(?after)) &
 succeeds r_take_while_not(urlend, ?after, ?url, ?rest) =>
 succeeds r_destination_url(?html, ?url),
assume(succeeds r_tag_attribute([0x3c,0x6d,0x65,0x74,0x61],
    [0x72,0x65,0x66,0x72,0x65,0x73,0x68],
    [0x63,0x6f,0x6e,0x74,0x65,0x6e,0x74], ?html, attribute(?content)) &
  succeeds r_search([0x75,0x72,0x6c,0x3d], ?content, found(?after)) &
  succeeds r_take_while_not(urlend, ?after, ?url, ?rest),
 [succeeds r_page_destination(?html, destination(?url))
    by lemma(destination:prefers:refresh),
  succeeds r_destination_url(?html, ?url)],
 succeeds r_destination_url(?html, ?url))
).

/* Answering the text back is only half of `is the identity': a second answer
   would mean the caller's first answer was not the only one the relation
   admits. The three lemmas below give the rewriter one answer per input, so
   the identity laws above become equations. append/3 first, since the
   rewriter builds its output with it. */

:- lemma(append:functional,
all [xs, ys, z1, z2]: succeeds r_append(?xs, ?ys, ?z1) &
 succeeds r_append(?xs, ?ys, ?z2) => ?z1 = ?z2,
[induction(
  [all [xs, ys, z1]: succeeds r_append(?xs, ?ys, ?z1) =>
    (all z2: succeeds r_append(?xs, ?ys, ?z2) => ?z1 = ?z2)],
  [step([ys],
    [],
    assume(succeeds r_append([], ?ys, ?z2),
     [def succeeds r_append([], ?ys, ?z2) by completion,
      ?z2 = ?ys],
     ?ys = ?z2),
    all z2: succeeds r_append([], ?ys, ?z2) => ?ys = ?z2),
   step([x, xs, ys, zs],
    [all z2: succeeds r_append(?xs, ?ys, ?z2) => ?zs = ?z2,
     succeeds r_append(?xs, ?ys, ?zs)],
    assume(succeeds r_append([?x|?xs], ?ys, ?z2),
     [def succeeds r_append([?x|?xs], ?ys, ?z2) by completion,
      exist(zs2,
       ?z2 = [?x|?zs2] & succeeds r_append(?xs, ?ys, ?zs2),
       [succeeds r_append(?xs, ?ys, ?zs2) => ?zs = ?zs2,
        ?zs = ?zs2,
        [?x|?zs] = ?z2],
       [?x|?zs] = ?z2)],
     [?x|?zs] = ?z2),
    all z2: succeeds r_append([?x|?xs], ?ys, ?z2) => [?x|?zs] = ?z2)]),
 assume(succeeds r_append(?xs, ?ys, ?z1) & succeeds r_append(?xs, ?ys, ?z2),
  [succeeds r_append(?xs, ?ys, ?z1) =>
    (all z2: succeeds r_append(?xs, ?ys, ?z2) => ?z1 = ?z2),
   all z2: succeeds r_append(?xs, ?ys, ?z2) => ?z1 = ?z2,
   succeeds r_append(?xs, ?ys, ?z2) => ?z1 = ?z2,
   ?z1 = ?z2],
  ?z1 = ?z2)]
).

/* first_match/3 picks one pair and one place to resume from. The induction
   is simultaneous over it and its continuation, as with search/3: the pair
   list is walked by one and the verdict dispatched by the other. */

:- lemma(first_match:functional:sim,
(all [chars, pairs, m1]: succeeds r_first_match(?chars, ?pairs, ?m1) =>
  (all m2: succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2)) &
(all [b, short, expanded, chars, pairs, m1]:
  succeeds r_first_match_(?b, ?short, ?expanded, ?chars, ?pairs, ?m1) =>
  (all m2: succeeds r_first_match_(?b, ?short, ?expanded, ?chars, ?pairs, ?m2)
    => ?m1 = ?m2)),
induction(
 [all [chars, pairs, m1]: succeeds r_first_match(?chars, ?pairs, ?m1) =>
   (all m2: succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2),
  all [b, short, expanded, chars, pairs, m1]:
   succeeds r_first_match_(?b, ?short, ?expanded, ?chars, ?pairs, ?m1) =>
   (all m2: succeeds r_first_match_(?b, ?short, ?expanded, ?chars, ?pairs, ?m2)
     => ?m1 = ?m2)],
 [step([chars],
   [],
   assume(succeeds r_first_match(?chars, [], ?m2),
    [def succeeds r_first_match(?chars, [], ?m2) by completion,
     ?m2 = none],
    none = ?m2),
   all m2: succeeds r_first_match(?chars, [], ?m2) => none = ?m2),
  step([chars, short, expanded, pairs, m1, truth],
   [all m2: succeeds r_first_match_(?truth, ?short, ?expanded, ?chars, ?pairs,
      ?m2) => ?m1 = ?m2,
    succeeds r_prefix_t(?short, ?chars, ?truth),
    succeeds r_first_match_(?truth, ?short, ?expanded, ?chars, ?pairs, ?m1)],
   assume(succeeds r_first_match(?chars, [?short - ?expanded|?pairs], ?m2),
    [def succeeds r_first_match(?chars, [?short - ?expanded|?pairs], ?m2)
       by completion,
     exist(t2,
      succeeds r_prefix_t(?short, ?chars, ?t2) &
       succeeds r_first_match_(?t2, ?short, ?expanded, ?chars, ?pairs, ?m2),
      [succeeds r_prefix_t(?short, ?chars, ?truth) &
         succeeds r_prefix_t(?short, ?chars, ?t2) =>
         ?truth = ?t2 by lemma(prefix:functional),
       ?truth = ?t2,
       succeeds r_first_match_(?truth, ?short, ?expanded, ?chars, ?pairs, ?m2),
       succeeds r_first_match_(?truth, ?short, ?expanded, ?chars, ?pairs, ?m2)
         => ?m1 = ?m2,
       ?m1 = ?m2],
      ?m1 = ?m2)],
    ?m1 = ?m2),
   all m2: succeeds r_first_match(?chars, [?short - ?expanded|?pairs], ?m2) =>
    ?m1 = ?m2),
  step([short, expanded, chars, pairs, rest],
   [succeeds r_strip_prefix(?short, ?chars, ?rest)],
   assume(succeeds r_first_match_(true, ?short, ?expanded, ?chars, ?pairs,
     ?m2),
    [def succeeds r_first_match_(true, ?short, ?expanded, ?chars, ?pairs, ?m2)
       by completion,
     exist(rest2,
      ?m2 = match(?expanded, ?rest2) &
       succeeds r_strip_prefix(?short, ?chars, ?rest2),
      [succeeds r_strip_prefix(?short, ?chars, ?rest) &
         succeeds r_strip_prefix(?short, ?chars, ?rest2) =>
         ?rest = ?rest2 by lemma(strip_prefix:functional),
       ?rest = ?rest2,
       match(?expanded, ?rest) = ?m2],
      match(?expanded, ?rest) = ?m2)],
    match(?expanded, ?rest) = ?m2),
   all m2: succeeds r_first_match_(true, ?short, ?expanded, ?chars, ?pairs,
     ?m2) => match(?expanded, ?rest) = ?m2),
  step([short, expanded, chars, pairs, m1],
   [all m2: succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2,
    succeeds r_first_match(?chars, ?pairs, ?m1)],
   assume(succeeds r_first_match_(false, ?short, ?expanded, ?chars, ?pairs,
     ?m2),
    [def succeeds r_first_match_(false, ?short, ?expanded, ?chars, ?pairs, ?m2)
       by completion,
     succeeds r_first_match(?chars, ?pairs, ?m2),
     succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2,
     ?m1 = ?m2],
    ?m1 = ?m2),
   all m2: succeeds r_first_match_(false, ?short, ?expanded, ?chars, ?pairs,
     ?m2) => ?m1 = ?m2)])
).

:- corollary(first_match:functional,
all [chars, pairs, m1, m2]: succeeds r_first_match(?chars, ?pairs, ?m1) &
 succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2,
assume(succeeds r_first_match(?chars, ?pairs, ?m1) &
  succeeds r_first_match(?chars, ?pairs, ?m2),
 [(all [chars, pairs, m1]: succeeds r_first_match(?chars, ?pairs, ?m1) =>
    (all m2: succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2))
    by lemma(first_match:functional:sim),
  succeeds r_first_match(?chars, ?pairs, ?m1) =>
   (all m2: succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2),
  all m2: succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2,
  succeeds r_first_match(?chars, ?pairs, ?m2) => ?m1 = ?m2,
  ?m1 = ?m2],
 ?m1 = ?m2)
).

/* And so the rewriter itself has one answer per text and pair list. */

:- lemma(rewrite:functional:sim,
(all [cs, pairs, o1]: succeeds r_rewrite_urls(?cs, ?pairs, ?o1) =>
  (all o2: succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?o1 = ?o2)) &
(all [m, c, cs, pairs, o1]: succeeds r_rewrite_step(?m, ?c, ?cs, ?pairs, ?o1)
  => (all o2: succeeds r_rewrite_step(?m, ?c, ?cs, ?pairs, ?o2) =>
    ?o1 = ?o2)),
induction(
 [all [cs, pairs, o1]: succeeds r_rewrite_urls(?cs, ?pairs, ?o1) =>
   (all o2: succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?o1 = ?o2),
  all [m, c, cs, pairs, o1]: succeeds r_rewrite_step(?m, ?c, ?cs, ?pairs, ?o1)
   => (all o2: succeeds r_rewrite_step(?m, ?c, ?cs, ?pairs, ?o2) =>
     ?o1 = ?o2)],
 [step([pairs],
   [],
   assume(succeeds r_rewrite_urls([], ?pairs, ?o2),
    [def succeeds r_rewrite_urls([], ?pairs, ?o2) by completion,
     ?o2 = []],
    [] = ?o2),
   all o2: succeeds r_rewrite_urls([], ?pairs, ?o2) => [] = ?o2),
  step([c, cs, pairs, o1, match],
   [all o2: succeeds r_rewrite_step(?match, ?c, ?cs, ?pairs, ?o2) =>
      ?o1 = ?o2,
    succeeds r_first_match([?c|?cs], ?pairs, ?match),
    succeeds r_rewrite_step(?match, ?c, ?cs, ?pairs, ?o1)],
   assume(succeeds r_rewrite_urls([?c|?cs], ?pairs, ?o2),
    [def succeeds r_rewrite_urls([?c|?cs], ?pairs, ?o2) by completion,
     exist(m2,
      succeeds r_first_match([?c|?cs], ?pairs, ?m2) &
       succeeds r_rewrite_step(?m2, ?c, ?cs, ?pairs, ?o2),
      [succeeds r_first_match([?c|?cs], ?pairs, ?match) &
         succeeds r_first_match([?c|?cs], ?pairs, ?m2) =>
         ?match = ?m2 by corollary(first_match:functional),
       ?match = ?m2,
       succeeds r_rewrite_step(?match, ?c, ?cs, ?pairs, ?o2),
       succeeds r_rewrite_step(?match, ?c, ?cs, ?pairs, ?o2) => ?o1 = ?o2,
       ?o1 = ?o2],
      ?o1 = ?o2)],
    ?o1 = ?o2),
   all o2: succeeds r_rewrite_urls([?c|?cs], ?pairs, ?o2) => ?o1 = ?o2),
  step([expanded, rest, c, cs, pairs, o1, tail],
   [all o2: succeeds r_rewrite_urls(?rest, ?pairs, ?o2) => ?tail = ?o2,
    succeeds r_append(?expanded, ?tail, ?o1),
    succeeds r_rewrite_urls(?rest, ?pairs, ?tail)],
   assume(succeeds r_rewrite_step(match(?expanded, ?rest), ?c, ?cs, ?pairs,
     ?o2),
    [def succeeds r_rewrite_step(match(?expanded, ?rest), ?c, ?cs, ?pairs,
       ?o2) by completion,
     exist(tail2,
      succeeds r_append(?expanded, ?tail2, ?o2) &
       succeeds r_rewrite_urls(?rest, ?pairs, ?tail2),
      [succeeds r_rewrite_urls(?rest, ?pairs, ?tail2) => ?tail = ?tail2,
       ?tail = ?tail2,
       succeeds r_append(?expanded, ?tail, ?o2),
       succeeds r_append(?expanded, ?tail, ?o1) &
         succeeds r_append(?expanded, ?tail, ?o2) =>
         ?o1 = ?o2 by lemma(append:functional),
       ?o1 = ?o2],
      ?o1 = ?o2)],
    ?o1 = ?o2),
   all o2: succeeds r_rewrite_step(match(?expanded, ?rest), ?c, ?cs, ?pairs,
     ?o2) => ?o1 = ?o2),
  step([c, cs, pairs, tail],
   [all o2: succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?tail = ?o2,
    succeeds r_rewrite_urls(?cs, ?pairs, ?tail)],
   assume(succeeds r_rewrite_step(none, ?c, ?cs, ?pairs, ?o2),
    [def succeeds r_rewrite_step(none, ?c, ?cs, ?pairs, ?o2) by completion,
     exist(tail2,
      ?o2 = [?c|?tail2] & succeeds r_rewrite_urls(?cs, ?pairs, ?tail2),
      [succeeds r_rewrite_urls(?cs, ?pairs, ?tail2) => ?tail = ?tail2,
       ?tail = ?tail2,
       [?c|?tail] = ?o2],
      [?c|?tail] = ?o2)],
    [?c|?tail] = ?o2),
   all o2: succeeds r_rewrite_step(none, ?c, ?cs, ?pairs, ?o2) =>
    [?c|?tail] = ?o2)])
).

:- corollary(rewrite:functional,
all [cs, pairs, o1, o2]: succeeds r_rewrite_urls(?cs, ?pairs, ?o1) &
 succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?o1 = ?o2,
assume(succeeds r_rewrite_urls(?cs, ?pairs, ?o1) &
  succeeds r_rewrite_urls(?cs, ?pairs, ?o2),
 [(all [cs, pairs, o1]: succeeds r_rewrite_urls(?cs, ?pairs, ?o1) =>
    (all o2: succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?o1 = ?o2))
    by lemma(rewrite:functional:sim),
  succeeds r_rewrite_urls(?cs, ?pairs, ?o1) =>
   (all o2: succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?o1 = ?o2),
  all o2: succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?o1 = ?o2,
  succeeds r_rewrite_urls(?cs, ?pairs, ?o2) => ?o1 = ?o2,
  ?o1 = ?o2],
 ?o1 = ?o2)
).

/* Obligations A4 and A3 as equations: not merely that the text is AN answer
   when no pair occurs in it, but that it is the only one. */

:- corollary(rewrite:identity:exact,
all [cs, pairs, out]: succeeds r_no_match(?cs, ?pairs) &
 succeeds r_rewrite_urls(?cs, ?pairs, ?out) => ?out = ?cs,
assume(succeeds r_no_match(?cs, ?pairs) &
  succeeds r_rewrite_urls(?cs, ?pairs, ?out),
 [succeeds r_no_match(?cs, ?pairs) => succeeds r_rewrite_urls(?cs, ?pairs, ?cs)
    by lemma(rewrite:identity),
  succeeds r_rewrite_urls(?cs, ?pairs, ?cs),
  succeeds r_rewrite_urls(?cs, ?pairs, ?out) &
    succeeds r_rewrite_urls(?cs, ?pairs, ?cs) =>
    ?out = ?cs by corollary(rewrite:functional),
  ?out = ?cs],
 ?out = ?cs)
).

:- corollary(rewrite:identity:empty:exact,
all [cs, out]: succeeds r_list(?cs) & succeeds r_rewrite_urls(?cs, [], ?out) =>
 ?out = ?cs,
assume(succeeds r_list(?cs) & succeeds r_rewrite_urls(?cs, [], ?out),
 [succeeds r_no_match(?cs, []) by lemma(no_match:empty),
  succeeds r_no_match(?cs, []) & succeeds r_rewrite_urls(?cs, [], ?out) =>
    ?out = ?cs by corollary(rewrite:identity:exact),
  ?out = ?cs],
 ?out = ?cs)
).

/* permalink/2 and url_host_path/3 both begin by splitting an address at one
   character, so both rest on split_at/3 having one answer. prepend_split/3
   first: it is what carries the split back out through the recursion. */

:- lemma(prepend_split:functional,
all [c, inner, r1, r2]: succeeds r_prepend_split(?c, ?inner, ?r1) &
 succeeds r_prepend_split(?c, ?inner, ?r2) => ?r1 = ?r2,
assume(succeeds r_prepend_split(?c, ?inner, ?r1) &
  succeeds r_prepend_split(?c, ?inner, ?r2),
 [def succeeds r_prepend_split(?c, ?inner, ?r1) by completion,
  def succeeds r_prepend_split(?c, ?inner, ?r2) by completion,
  cases([
   case(?inner = not_split & ?r1 = not_split,
    [cases([
      case(?inner = not_split & ?r2 = not_split,
       [?r1 = ?r2]),
      case(ex [bf, af]: ?inner = split(?bf, ?af) &
         ?r2 = split([?c|?bf], ?af),
       [exist([bf2, af2], ?inner = split(?bf2, ?af2) &
          ?r2 = split([?c|?bf2], ?af2),
         [ff],
         ?r1 = ?r2)])],
      ?r1 = ?r2)]),
   case(ex [bf, af]: ?inner = split(?bf, ?af) & ?r1 = split([?c|?bf], ?af),
    [exist([bf1, af1], ?inner = split(?bf1, ?af1) &
       ?r1 = split([?c|?bf1], ?af1),
      [cases([
        case(?inner = not_split & ?r2 = not_split,
         [ff]),
        case(ex [bf, af]: ?inner = split(?bf, ?af) &
           ?r2 = split([?c|?bf], ?af),
         [exist([bf2, af2], ?inner = split(?bf2, ?af2) &
            ?r2 = split([?c|?bf2], ?af2),
           [?r1 = ?r2],
           ?r1 = ?r2)])],
        ?r1 = ?r2)],
      ?r1 = ?r2)])],
   ?r1 = ?r2)],
 ?r1 = ?r2)
).

:- lemma(split_at:functional:sim,
(all [tag, xs, r1]: succeeds r_split_at(?tag, ?xs, ?r1) =>
  (all r2: succeeds r_split_at(?tag, ?xs, ?r2) => ?r1 = ?r2)) &
(all [b, tag, c, cs, r1]: succeeds r_split_at_(?b, ?tag, ?c, ?cs, ?r1) =>
  (all r2: succeeds r_split_at_(?b, ?tag, ?c, ?cs, ?r2) => ?r1 = ?r2)),
induction(
 [all [tag, xs, r1]: succeeds r_split_at(?tag, ?xs, ?r1) =>
   (all r2: succeeds r_split_at(?tag, ?xs, ?r2) => ?r1 = ?r2),
  all [b, tag, c, cs, r1]: succeeds r_split_at_(?b, ?tag, ?c, ?cs, ?r1) =>
   (all r2: succeeds r_split_at_(?b, ?tag, ?c, ?cs, ?r2) => ?r1 = ?r2)],
 [step([tag],
   [],
   assume(succeeds r_split_at(?tag, [], ?r2),
    [def succeeds r_split_at(?tag, [], ?r2) by completion,
     ?r2 = not_split],
    not_split = ?r2),
   all r2: succeeds r_split_at(?tag, [], ?r2) => not_split = ?r2),
  step([tag, c, cs, r1, truth],
   [all r2: succeeds r_split_at_(?truth, ?tag, ?c, ?cs, ?r2) => ?r1 = ?r2,
    succeeds r_cond_t(?tag, ?c, ?truth),
    succeeds r_split_at_(?truth, ?tag, ?c, ?cs, ?r1)],
   assume(succeeds r_split_at(?tag, [?c|?cs], ?r2),
    [def succeeds r_split_at(?tag, [?c|?cs], ?r2) by completion,
     exist(t2,
      succeeds r_cond_t(?tag, ?c, ?t2) &
       succeeds r_split_at_(?t2, ?tag, ?c, ?cs, ?r2),
      [succeeds r_cond_t(?tag, ?c, ?truth) & succeeds r_cond_t(?tag, ?c, ?t2)
         => ?truth = ?t2 by lemma(cond:functional),
       ?truth = ?t2,
       succeeds r_split_at_(?truth, ?tag, ?c, ?cs, ?r2),
       succeeds r_split_at_(?truth, ?tag, ?c, ?cs, ?r2) => ?r1 = ?r2,
       ?r1 = ?r2],
      ?r1 = ?r2)],
    ?r1 = ?r2),
   all r2: succeeds r_split_at(?tag, [?c|?cs], ?r2) => ?r1 = ?r2),
  step([tag, c, cs],
   [],
   assume(succeeds r_split_at_(true, ?tag, ?c, ?cs, ?r2),
    [def succeeds r_split_at_(true, ?tag, ?c, ?cs, ?r2) by completion,
     ?r2 = split([], ?cs)],
    split([], ?cs) = ?r2),
   all r2: succeeds r_split_at_(true, ?tag, ?c, ?cs, ?r2) =>
    split([], ?cs) = ?r2),
  step([tag, c, cs, r1, inner],
   [all r2: succeeds r_split_at(?tag, ?cs, ?r2) => ?inner = ?r2,
    succeeds r_split_at(?tag, ?cs, ?inner),
    succeeds r_prepend_split(?c, ?inner, ?r1)],
   assume(succeeds r_split_at_(false, ?tag, ?c, ?cs, ?r2),
    [def succeeds r_split_at_(false, ?tag, ?c, ?cs, ?r2) by completion,
     exist(inner2,
      succeeds r_split_at(?tag, ?cs, ?inner2) &
       succeeds r_prepend_split(?c, ?inner2, ?r2),
      [succeeds r_split_at(?tag, ?cs, ?inner2) => ?inner = ?inner2,
       ?inner = ?inner2,
       succeeds r_prepend_split(?c, ?inner, ?r2),
       succeeds r_prepend_split(?c, ?inner, ?r1) &
         succeeds r_prepend_split(?c, ?inner, ?r2) =>
         ?r1 = ?r2 by lemma(prepend_split:functional),
       ?r1 = ?r2],
      ?r1 = ?r2)],
    ?r1 = ?r2),
   all r2: succeeds r_split_at_(false, ?tag, ?c, ?cs, ?r2) => ?r1 = ?r2)])
).

:- corollary(split_at:functional,
all [tag, xs, r1, r2]: succeeds r_split_at(?tag, ?xs, ?r1) &
 succeeds r_split_at(?tag, ?xs, ?r2) => ?r1 = ?r2,
assume(succeeds r_split_at(?tag, ?xs, ?r1) & succeeds r_split_at(?tag, ?xs, ?r2),
 [(all [tag, xs, r1]: succeeds r_split_at(?tag, ?xs, ?r1) =>
    (all r2: succeeds r_split_at(?tag, ?xs, ?r2) => ?r1 = ?r2))
    by lemma(split_at:functional:sim),
  succeeds r_split_at(?tag, ?xs, ?r1) =>
   (all r2: succeeds r_split_at(?tag, ?xs, ?r2) => ?r1 = ?r2),
  all r2: succeeds r_split_at(?tag, ?xs, ?r2) => ?r1 = ?r2,
  succeeds r_split_at(?tag, ?xs, ?r2) => ?r1 = ?r2,
  ?r1 = ?r2],
 ?r1 = ?r2)
).

/* Obligation A2: permalink/2 changes only the query. Whatever the parameter
   filter drops, the part of the address before the first `?' -- scheme, host
   and path, the part a reader needs -- comes back unchanged, and the only
   thing that can follow it is a `?' and what survived the filter. A mangled
   host is a link nobody can open, and nothing in the shipped code holds the
   two halves apart except the arithmetic of rejoin/3.

   Two cases, because the address may carry no query at all. Both need
   split_at/3 to be a function: the law speaks of THE split of the address,
   and permalink/2 computes its own. */

:- lemma(rejoin:extends:base,
all [base, kept, perm]: succeeds r_rejoin(?base, ?kept, ?perm) =>
 ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)),
assume(succeeds r_rejoin(?base, ?kept, ?perm),
 [def succeeds r_rejoin(?base, ?kept, ?perm) by completion,
  cases(?kept = [] & ?perm = ?base,
   [?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm))],
   ex [p, ps, query, withmark]: ?kept = [?p|?ps] &
     succeeds r_join_params([?p|?ps], ?query) &
     succeeds r_append([0x3f], ?query, ?withmark) &
     succeeds r_append(?base, ?withmark, ?perm),
   [exist([p, ps, query, withmark], ?kept = [?p|?ps] &
      succeeds r_join_params([?p|?ps], ?query) &
      succeeds r_append([0x3f], ?query, ?withmark) &
      succeeds r_append(?base, ?withmark, ?perm),
     [def succeeds r_append([0x3f], ?query, ?withmark) by completion,
      exist(zs,
       ?withmark = [0x3f|?zs] & succeeds r_append([], ?query, ?zs),
       [def succeeds r_append([], ?query, ?zs) by completion,
        ?zs = ?query,
        ?withmark = [0x3f|?query],
        succeeds r_append(?base, [0x3f|?query], ?perm),
        ex q: succeeds r_append(?base, [0x3f|?q], ?perm),
        ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm))],
       ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))],
     ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))],
   ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))],
 ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))
).

:- lemma(permalink:query:only,
all [url, base, query, perm]:
 succeeds r_split_at(question, ?url, split(?base, ?query)) &
 succeeds r_permalink(?url, ?perm) =>
 ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)),
assume(succeeds r_split_at(question, ?url, split(?base, ?query)) &
  succeeds r_permalink(?url, ?perm),
 [def succeeds r_permalink(?url, ?perm) by completion,
  exist(s2,
   succeeds r_split_at(question, ?url, ?s2) &
    succeeds r_permalink_(?s2, ?url, ?perm),
   [succeeds r_split_at(question, ?url, split(?base, ?query)) &
      succeeds r_split_at(question, ?url, ?s2) =>
      split(?base, ?query) = ?s2 by corollary(split_at:functional),
    split(?base, ?query) = ?s2,
    succeeds r_permalink_(split(?base, ?query), ?url, ?perm),
    def succeeds r_permalink_(split(?base, ?query), ?url, ?perm) by completion,
    exist([params, kept],
     succeeds r_split_params(?query, ?params) &
      succeeds r_filter_functional(?params, ?kept) &
      succeeds r_rejoin(?base, ?kept, ?perm),
     [succeeds r_rejoin(?base, ?kept, ?perm) =>
        (?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))
        by lemma(rejoin:extends:base),
      ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm))],
     ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))],
   ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))],
 ?perm = ?base \/ (ex q: succeeds r_append(?base, [0x3f|?q], ?perm)))
).

:- lemma(permalink:nosplit,
all [url, perm]: succeeds r_split_at(question, ?url, not_split) &
 succeeds r_permalink(?url, ?perm) => ?perm = ?url,
assume(succeeds r_split_at(question, ?url, not_split) &
  succeeds r_permalink(?url, ?perm),
 [def succeeds r_permalink(?url, ?perm) by completion,
  exist(s2,
   succeeds r_split_at(question, ?url, ?s2) &
    succeeds r_permalink_(?s2, ?url, ?perm),
   [succeeds r_split_at(question, ?url, not_split) &
      succeeds r_split_at(question, ?url, ?s2) =>
      not_split = ?s2 by corollary(split_at:functional),
    not_split = ?s2,
    succeeds r_permalink_(not_split, ?url, ?perm),
    def succeeds r_permalink_(not_split, ?url, ?perm) by completion,
    ?perm = ?url],
   ?perm = ?url)],
 ?perm = ?url)
).

/* Obligation A1, on the fragment of addresses that carry no query at all.
   There the reduction is the identity, so a second reduction cannot move the
   address, and the ledger cannot key one article under two rows. The
   fragment is not the law: an address WITH a query needs split_params/2 and
   join_params/2 to be inverse on the parameters that survive the filter, and
   that is not proven here. */

:- corollary(permalink:idempotent:nosplit,
all [url, perm, perm2]: succeeds r_split_at(question, ?url, not_split) &
 succeeds r_permalink(?url, ?perm) & succeeds r_permalink(?perm, ?perm2) =>
 ?perm2 = ?perm,
assume(succeeds r_split_at(question, ?url, not_split) &
  succeeds r_permalink(?url, ?perm) & succeeds r_permalink(?perm, ?perm2),
 [succeeds r_split_at(question, ?url, not_split) &
    succeeds r_permalink(?url, ?perm) => ?perm = ?url
    by lemma(permalink:nosplit),
  ?perm = ?url,
  succeeds r_split_at(question, ?perm, not_split),
  succeeds r_split_at(question, ?perm, not_split) &
    succeeds r_permalink(?perm, ?perm2) => ?perm2 = ?perm
    by lemma(permalink:nosplit),
  ?perm2 = ?perm],
 ?perm2 = ?perm)
).

/* take_while_not/4 is where the scan of a post cuts an address out of the
   text, where the query is cut off a path, and where a tag and an attribute
   value are cut out of a page. Both of its outputs are determined, which is
   what lets the lemmas further down speak of THE address at a position. */

:- lemma(take_while_not:functional:sim,
(all [tag, xs, t1, r1]: succeeds r_take_while_not(?tag, ?xs, ?t1, ?r1) =>
  (all [t2, r2]: succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2) =>
    ?t1 = ?t2 & ?r1 = ?r2)) &
(all [b, tag, c, cs, t1, r1]:
  succeeds r_take_while_not_(?b, ?tag, ?c, ?cs, ?t1, ?r1) =>
  (all [t2, r2]: succeeds r_take_while_not_(?b, ?tag, ?c, ?cs, ?t2, ?r2) =>
    ?t1 = ?t2 & ?r1 = ?r2)),
induction(
 [all [tag, xs, t1, r1]: succeeds r_take_while_not(?tag, ?xs, ?t1, ?r1) =>
   (all [t2, r2]: succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2) =>
     ?t1 = ?t2 & ?r1 = ?r2),
  all [b, tag, c, cs, t1, r1]:
   succeeds r_take_while_not_(?b, ?tag, ?c, ?cs, ?t1, ?r1) =>
   (all [t2, r2]: succeeds r_take_while_not_(?b, ?tag, ?c, ?cs, ?t2, ?r2) =>
     ?t1 = ?t2 & ?r1 = ?r2)],
 [step([tag],
   [],
   assume(succeeds r_take_while_not(?tag, [], ?t2, ?r2),
    [def succeeds r_take_while_not(?tag, [], ?t2, ?r2) by completion,
     ?t2 = [] & ?r2 = [],
     [] = ?t2 & [] = ?r2],
    [] = ?t2 & [] = ?r2),
   all [t2, r2]: succeeds r_take_while_not(?tag, [], ?t2, ?r2) =>
    [] = ?t2 & [] = ?r2),
  step([tag, c, cs, t1, r1, truth],
   [all [t2, r2]: succeeds r_take_while_not_(?truth, ?tag, ?c, ?cs, ?t2, ?r2)
      => ?t1 = ?t2 & ?r1 = ?r2,
    succeeds r_cond_t(?tag, ?c, ?truth),
    succeeds r_take_while_not_(?truth, ?tag, ?c, ?cs, ?t1, ?r1)],
   assume(succeeds r_take_while_not(?tag, [?c|?cs], ?t2, ?r2),
    [def succeeds r_take_while_not(?tag, [?c|?cs], ?t2, ?r2) by completion,
     exist(v2,
      succeeds r_cond_t(?tag, ?c, ?v2) &
       succeeds r_take_while_not_(?v2, ?tag, ?c, ?cs, ?t2, ?r2),
      [succeeds r_cond_t(?tag, ?c, ?truth) & succeeds r_cond_t(?tag, ?c, ?v2)
         => ?truth = ?v2 by lemma(cond:functional),
       ?truth = ?v2,
       succeeds r_take_while_not_(?truth, ?tag, ?c, ?cs, ?t2, ?r2),
       succeeds r_take_while_not_(?truth, ?tag, ?c, ?cs, ?t2, ?r2) =>
         ?t1 = ?t2 & ?r1 = ?r2,
       ?t1 = ?t2 & ?r1 = ?r2],
      ?t1 = ?t2 & ?r1 = ?r2)],
    ?t1 = ?t2 & ?r1 = ?r2),
   all [t2, r2]: succeeds r_take_while_not(?tag, [?c|?cs], ?t2, ?r2) =>
    ?t1 = ?t2 & ?r1 = ?r2),
  step([tag, c, cs],
   [],
   assume(succeeds r_take_while_not_(true, ?tag, ?c, ?cs, ?t2, ?r2),
    [def succeeds r_take_while_not_(true, ?tag, ?c, ?cs, ?t2, ?r2)
       by completion,
     ?t2 = [] & ?r2 = [?c|?cs],
     [] = ?t2 & [?c|?cs] = ?r2],
    [] = ?t2 & [?c|?cs] = ?r2),
   all [t2, r2]: succeeds r_take_while_not_(true, ?tag, ?c, ?cs, ?t2, ?r2) =>
    [] = ?t2 & [?c|?cs] = ?r2),
  step([tag, c, cs, taken, rest],
   [all [t2, r2]: succeeds r_take_while_not(?tag, ?cs, ?t2, ?r2) =>
      ?taken = ?t2 & ?rest = ?r2,
    succeeds r_take_while_not(?tag, ?cs, ?taken, ?rest)],
   assume(succeeds r_take_while_not_(false, ?tag, ?c, ?cs, ?t2, ?r2),
    [def succeeds r_take_while_not_(false, ?tag, ?c, ?cs, ?t2, ?r2)
       by completion,
     exist(taken2,
      ?t2 = [?c|?taken2] &
       succeeds r_take_while_not(?tag, ?cs, ?taken2, ?r2),
      [succeeds r_take_while_not(?tag, ?cs, ?taken2, ?r2) =>
         ?taken = ?taken2 & ?rest = ?r2,
       ?taken = ?taken2 & ?rest = ?r2,
       [?c|?taken] = ?t2 & ?rest = ?r2],
      [?c|?taken] = ?t2 & ?rest = ?r2)],
    [?c|?taken] = ?t2 & ?rest = ?r2),
   all [t2, r2]: succeeds r_take_while_not_(false, ?tag, ?c, ?cs, ?t2, ?r2) =>
    [?c|?taken] = ?t2 & ?rest = ?r2)])
).

:- corollary(take_while_not:functional,
all [tag, xs, t1, r1, t2, r2]: succeeds r_take_while_not(?tag, ?xs, ?t1, ?r1) &
 succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2) => ?t1 = ?t2 & ?r1 = ?r2,
assume(succeeds r_take_while_not(?tag, ?xs, ?t1, ?r1) &
  succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2),
 [(all [tag, xs, t1, r1]: succeeds r_take_while_not(?tag, ?xs, ?t1, ?r1) =>
    (all [t2, r2]: succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2) =>
      ?t1 = ?t2 & ?r1 = ?r2)) by lemma(take_while_not:functional:sim),
  succeeds r_take_while_not(?tag, ?xs, ?t1, ?r1) =>
   (all [t2, r2]: succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2) =>
     ?t1 = ?t2 & ?r1 = ?r2),
  all [t2, r2]: succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2) =>
   ?t1 = ?t2 & ?r1 = ?r2,
  succeeds r_take_while_not(?tag, ?xs, ?t2, ?r2) => ?t1 = ?t2 & ?r1 = ?r2,
  ?t1 = ?t2 & ?r1 = ?r2],
 ?t1 = ?t2 & ?r1 = ?r2)
).

/* reverse/2 and the punctuation drop, which trim_trailing/2 is made of. */

:- lemma(reverse:functional,
all [xs, y1, y2]: succeeds r_reverse(?xs, ?y1) & succeeds r_reverse(?xs, ?y2)
 => ?y1 = ?y2,
[induction(
  [all [xs, y1]: succeeds r_reverse(?xs, ?y1) =>
    (all y2: succeeds r_reverse(?xs, ?y2) => ?y1 = ?y2)],
  [step([],
    [],
    assume(succeeds r_reverse([], ?y2),
     [def succeeds r_reverse([], ?y2) by completion,
      ?y2 = []],
     [] = ?y2),
    all y2: succeeds r_reverse([], ?y2) => [] = ?y2),
   step([x, xs, ys, rs],
    [all y2: succeeds r_reverse(?xs, ?y2) => ?rs = ?y2,
     succeeds r_reverse(?xs, ?rs),
     succeeds r_append(?rs, [?x], ?ys)],
    assume(succeeds r_reverse([?x|?xs], ?y2),
     [def succeeds r_reverse([?x|?xs], ?y2) by completion,
      exist(rs2,
       succeeds r_reverse(?xs, ?rs2) & succeeds r_append(?rs2, [?x], ?y2),
       [succeeds r_reverse(?xs, ?rs2) => ?rs = ?rs2,
        ?rs = ?rs2,
        succeeds r_append(?rs, [?x], ?y2),
        succeeds r_append(?rs, [?x], ?ys) &
          succeeds r_append(?rs, [?x], ?y2) =>
          ?ys = ?y2 by lemma(append:functional),
        ?ys = ?y2],
       ?ys = ?y2)],
     ?ys = ?y2),
    all y2: succeeds r_reverse([?x|?xs], ?y2) => ?ys = ?y2)]),
 assume(succeeds r_reverse(?xs, ?y1) & succeeds r_reverse(?xs, ?y2),
  [succeeds r_reverse(?xs, ?y1) =>
    (all y2: succeeds r_reverse(?xs, ?y2) => ?y1 = ?y2),
   all y2: succeeds r_reverse(?xs, ?y2) => ?y1 = ?y2,
   succeeds r_reverse(?xs, ?y2) => ?y1 = ?y2,
   ?y1 = ?y2],
  ?y1 = ?y2)]
).

:- lemma(drop_trailing:functional:sim,
(all [xs, o1]: succeeds r_drop_trailing(?xs, ?o1) =>
  (all o2: succeeds r_drop_trailing(?xs, ?o2) => ?o1 = ?o2)) &
(all [b, c, cs, o1]: succeeds r_drop_trailing_(?b, ?c, ?cs, ?o1) =>
  (all o2: succeeds r_drop_trailing_(?b, ?c, ?cs, ?o2) => ?o1 = ?o2)),
induction(
 [all [xs, o1]: succeeds r_drop_trailing(?xs, ?o1) =>
   (all o2: succeeds r_drop_trailing(?xs, ?o2) => ?o1 = ?o2),
  all [b, c, cs, o1]: succeeds r_drop_trailing_(?b, ?c, ?cs, ?o1) =>
   (all o2: succeeds r_drop_trailing_(?b, ?c, ?cs, ?o2) => ?o1 = ?o2)],
 [step([],
   [],
   assume(succeeds r_drop_trailing([], ?o2),
    [def succeeds r_drop_trailing([], ?o2) by completion,
     ?o2 = []],
    [] = ?o2),
   all o2: succeeds r_drop_trailing([], ?o2) => [] = ?o2),
  step([c, cs, o1, truth],
   [all o2: succeeds r_drop_trailing_(?truth, ?c, ?cs, ?o2) => ?o1 = ?o2,
    succeeds r_cond_t(punct, ?c, ?truth),
    succeeds r_drop_trailing_(?truth, ?c, ?cs, ?o1)],
   assume(succeeds r_drop_trailing([?c|?cs], ?o2),
    [def succeeds r_drop_trailing([?c|?cs], ?o2) by completion,
     exist(v2,
      succeeds r_cond_t(punct, ?c, ?v2) &
       succeeds r_drop_trailing_(?v2, ?c, ?cs, ?o2),
      [succeeds r_cond_t(punct, ?c, ?truth) &
         succeeds r_cond_t(punct, ?c, ?v2) =>
         ?truth = ?v2 by lemma(cond:functional),
       ?truth = ?v2,
       succeeds r_drop_trailing_(?truth, ?c, ?cs, ?o2),
       succeeds r_drop_trailing_(?truth, ?c, ?cs, ?o2) => ?o1 = ?o2,
       ?o1 = ?o2],
      ?o1 = ?o2)],
    ?o1 = ?o2),
   all o2: succeeds r_drop_trailing([?c|?cs], ?o2) => ?o1 = ?o2),
  step([c, cs, o1],
   [all o2: succeeds r_drop_trailing(?cs, ?o2) => ?o1 = ?o2,
    succeeds r_drop_trailing(?cs, ?o1)],
   assume(succeeds r_drop_trailing_(true, ?c, ?cs, ?o2),
    [def succeeds r_drop_trailing_(true, ?c, ?cs, ?o2) by completion,
     succeeds r_drop_trailing(?cs, ?o2),
     succeeds r_drop_trailing(?cs, ?o2) => ?o1 = ?o2,
     ?o1 = ?o2],
    ?o1 = ?o2),
   all o2: succeeds r_drop_trailing_(true, ?c, ?cs, ?o2) => ?o1 = ?o2),
  step([c, cs],
   [],
   assume(succeeds r_drop_trailing_(false, ?c, ?cs, ?o2),
    [def succeeds r_drop_trailing_(false, ?c, ?cs, ?o2) by completion,
     ?o2 = [?c|?cs]],
    [?c|?cs] = ?o2),
   all o2: succeeds r_drop_trailing_(false, ?c, ?cs, ?o2) => [?c|?cs] = ?o2)])
).

:- corollary(drop_trailing:functional,
all [xs, o1, o2]: succeeds r_drop_trailing(?xs, ?o1) &
 succeeds r_drop_trailing(?xs, ?o2) => ?o1 = ?o2,
assume(succeeds r_drop_trailing(?xs, ?o1) & succeeds r_drop_trailing(?xs, ?o2),
 [(all [xs, o1]: succeeds r_drop_trailing(?xs, ?o1) =>
    (all o2: succeeds r_drop_trailing(?xs, ?o2) => ?o1 = ?o2))
    by lemma(drop_trailing:functional:sim),
  succeeds r_drop_trailing(?xs, ?o1) =>
   (all o2: succeeds r_drop_trailing(?xs, ?o2) => ?o1 = ?o2),
  all o2: succeeds r_drop_trailing(?xs, ?o2) => ?o1 = ?o2,
  succeeds r_drop_trailing(?xs, ?o2) => ?o1 = ?o2,
  ?o1 = ?o2],
 ?o1 = ?o2)
).

:- lemma(trim_trailing:functional,
all [cs, t1, t2]: succeeds r_trim_trailing(?cs, ?t1) &
 succeeds r_trim_trailing(?cs, ?t2) => ?t1 = ?t2,
assume(succeeds r_trim_trailing(?cs, ?t1) & succeeds r_trim_trailing(?cs, ?t2),
 [def succeeds r_trim_trailing(?cs, ?t1) by completion,
  def succeeds r_trim_trailing(?cs, ?t2) by completion,
  exist([rev1, dropped1],
   succeeds r_reverse(?cs, ?rev1) &
    succeeds r_drop_trailing(?rev1, ?dropped1) &
    succeeds r_reverse(?dropped1, ?t1),
   [exist([rev2, dropped2],
     succeeds r_reverse(?cs, ?rev2) &
      succeeds r_drop_trailing(?rev2, ?dropped2) &
      succeeds r_reverse(?dropped2, ?t2),
     [succeeds r_reverse(?cs, ?rev1) & succeeds r_reverse(?cs, ?rev2) =>
        ?rev1 = ?rev2 by lemma(reverse:functional),
      ?rev1 = ?rev2,
      succeeds r_drop_trailing(?rev1, ?dropped2),
      succeeds r_drop_trailing(?rev1, ?dropped1) &
        succeeds r_drop_trailing(?rev1, ?dropped2) =>
        ?dropped1 = ?dropped2 by corollary(drop_trailing:functional),
      ?dropped1 = ?dropped2,
      succeeds r_reverse(?dropped1, ?t2),
      succeeds r_reverse(?dropped1, ?t1) &
        succeeds r_reverse(?dropped1, ?t2) =>
        ?t1 = ?t2 by lemma(reverse:functional),
      ?t1 = ?t2],
     ?t1 = ?t2)],
   ?t1 = ?t2)],
 ?t1 = ?t2)
).

/* url_start_t/2: the two schemes, tried in turn. */

:- lemma(url_start_t_:boolean,
all [b0, chars, b]: succeeds r_url_start_t_(?b0, ?chars, ?b) =>
 ?b = true \/ ?b = false,
assume(succeeds r_url_start_t_(?b0, ?chars, ?b),
 [def succeeds r_url_start_t_(?b0, ?chars, ?b) by completion,
  cases(?b0 = true & ?b = true,
   [?b = true \/ ?b = false],
   ?b0 = false &
     succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?chars, ?b),
   [?b = true \/ ?b = false by lemma(prefix:boolean)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(url_start_t_:functional,
all [b0, chars, b1, b2]: succeeds r_url_start_t_(?b0, ?chars, ?b1) &
 succeeds r_url_start_t_(?b0, ?chars, ?b2) => ?b1 = ?b2,
assume(succeeds r_url_start_t_(?b0, ?chars, ?b1) &
  succeeds r_url_start_t_(?b0, ?chars, ?b2),
 [def succeeds r_url_start_t_(?b0, ?chars, ?b1) by completion,
  def succeeds r_url_start_t_(?b0, ?chars, ?b2) by completion,
  cases(?b0 = true & ?b1 = true,
   [cases(?b0 = true & ?b2 = true,
     [?b1 = ?b2],
     ?b0 = false &
       succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?chars, ?b2),
     [ff],
     ?b1 = ?b2)],
   ?b0 = false &
     succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?chars, ?b1),
   [cases(?b0 = true & ?b2 = true,
     [ff],
     ?b0 = false &
       succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?chars, ?b2),
     [succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?chars, ?b1) &
        succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x3a,0x2f,0x2f], ?chars, ?b2)
        => ?b1 = ?b2 by lemma(prefix:functional),
      ?b1 = ?b2],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(url_start:boolean,
all [chars, b]: succeeds r_url_start_t(?chars, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_url_start_t(?chars, ?b),
 [def succeeds r_url_start_t(?chars, ?b) by completion,
  exist(https,
   succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?chars,
     ?https) & succeeds r_url_start_t_(?https, ?chars, ?b),
   [?b = true \/ ?b = false by lemma(url_start_t_:boolean)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(url_start:functional,
all [chars, b1, b2]: succeeds r_url_start_t(?chars, ?b1) &
 succeeds r_url_start_t(?chars, ?b2) => ?b1 = ?b2,
assume(succeeds r_url_start_t(?chars, ?b1) &
  succeeds r_url_start_t(?chars, ?b2),
 [def succeeds r_url_start_t(?chars, ?b1) by completion,
  def succeeds r_url_start_t(?chars, ?b2) by completion,
  exist(h1,
   succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?chars, ?h1)
    & succeeds r_url_start_t_(?h1, ?chars, ?b1),
   [exist(h2,
     succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?chars,
       ?h2) & succeeds r_url_start_t_(?h2, ?chars, ?b2),
     [succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?chars,
        ?h1) &
        succeeds r_prefix_t([0x68,0x74,0x74,0x70,0x73,0x3a,0x2f,0x2f], ?chars,
        ?h2) => ?h1 = ?h2 by lemma(prefix:functional),
      ?h1 = ?h2,
      succeeds r_url_start_t_(?h1, ?chars, ?b2),
      succeeds r_url_start_t_(?h1, ?chars, ?b1) &
        succeeds r_url_start_t_(?h1, ?chars, ?b2) =>
        ?b1 = ?b2 by lemma(url_start_t_:functional),
      ?b1 = ?b2],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

/* urls_in_text/2 has one answer per post, which is what lets the laws below
   speak of THE addresses a post carries. */

:- lemma(urls_in_text:functional:sim,
(all [cs, u1]: succeeds r_urls_in_text(?cs, ?u1) =>
  (all u2: succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2)) &
(all [b, c, cs, u1]: succeeds r_urls_in_text_(?b, ?c, ?cs, ?u1) =>
  (all u2: succeeds r_urls_in_text_(?b, ?c, ?cs, ?u2) => ?u1 = ?u2)),
induction(
 [all [cs, u1]: succeeds r_urls_in_text(?cs, ?u1) =>
   (all u2: succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2),
  all [b, c, cs, u1]: succeeds r_urls_in_text_(?b, ?c, ?cs, ?u1) =>
   (all u2: succeeds r_urls_in_text_(?b, ?c, ?cs, ?u2) => ?u1 = ?u2)],
 [step([],
   [],
   assume(succeeds r_urls_in_text([], ?u2),
    [def succeeds r_urls_in_text([], ?u2) by completion,
     ?u2 = []],
    [] = ?u2),
   all u2: succeeds r_urls_in_text([], ?u2) => [] = ?u2),
  step([c, cs, u1, truth],
   [all u2: succeeds r_urls_in_text_(?truth, ?c, ?cs, ?u2) => ?u1 = ?u2,
    succeeds r_url_start_t([?c|?cs], ?truth),
    succeeds r_urls_in_text_(?truth, ?c, ?cs, ?u1)],
   assume(succeeds r_urls_in_text([?c|?cs], ?u2),
    [def succeeds r_urls_in_text([?c|?cs], ?u2) by completion,
     exist(v2,
      succeeds r_url_start_t([?c|?cs], ?v2) &
       succeeds r_urls_in_text_(?v2, ?c, ?cs, ?u2),
      [succeeds r_url_start_t([?c|?cs], ?truth) &
         succeeds r_url_start_t([?c|?cs], ?v2) =>
         ?truth = ?v2 by lemma(url_start:functional),
       ?truth = ?v2,
       succeeds r_urls_in_text_(?truth, ?c, ?cs, ?u2),
       succeeds r_urls_in_text_(?truth, ?c, ?cs, ?u2) => ?u1 = ?u2,
       ?u1 = ?u2],
      ?u1 = ?u2)],
    ?u1 = ?u2),
   all u2: succeeds r_urls_in_text([?c|?cs], ?u2) => ?u1 = ?u2),
  step([c, cs, url, more, raw, rest],
   [all u2: succeeds r_urls_in_text(?rest, ?u2) => ?more = ?u2,
    succeeds r_take_while_not(delim, [?c|?cs], ?raw, ?rest),
    succeeds r_trim_trailing(?raw, ?url),
    succeeds r_urls_in_text(?rest, ?more)],
   assume(succeeds r_urls_in_text_(true, ?c, ?cs, ?u2),
    [def succeeds r_urls_in_text_(true, ?c, ?cs, ?u2) by completion,
     exist([url2, more2, raw2, rest2],
      ?u2 = [?url2|?more2] &
       succeeds r_take_while_not(delim, [?c|?cs], ?raw2, ?rest2) &
       succeeds r_trim_trailing(?raw2, ?url2) &
       succeeds r_urls_in_text(?rest2, ?more2),
      [succeeds r_take_while_not(delim, [?c|?cs], ?raw, ?rest) &
         succeeds r_take_while_not(delim, [?c|?cs], ?raw2, ?rest2) =>
         ?raw = ?raw2 & ?rest = ?rest2
         by corollary(take_while_not:functional),
       ?raw = ?raw2 & ?rest = ?rest2,
       succeeds r_trim_trailing(?raw, ?url2),
       succeeds r_trim_trailing(?raw, ?url) &
         succeeds r_trim_trailing(?raw, ?url2) =>
         ?url = ?url2 by lemma(trim_trailing:functional),
       ?url = ?url2,
       succeeds r_urls_in_text(?rest, ?more2),
       succeeds r_urls_in_text(?rest, ?more2) => ?more = ?more2,
       ?more = ?more2,
       [?url|?more] = ?u2],
      [?url|?more] = ?u2)],
    [?url|?more] = ?u2),
   all u2: succeeds r_urls_in_text_(true, ?c, ?cs, ?u2) => [?url|?more] = ?u2),
  step([c, cs, u1],
   [all u2: succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2,
    succeeds r_urls_in_text(?cs, ?u1)],
   assume(succeeds r_urls_in_text_(false, ?c, ?cs, ?u2),
    [def succeeds r_urls_in_text_(false, ?c, ?cs, ?u2) by completion,
     succeeds r_urls_in_text(?cs, ?u2),
     succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2,
     ?u1 = ?u2],
    ?u1 = ?u2),
   all u2: succeeds r_urls_in_text_(false, ?c, ?cs, ?u2) => ?u1 = ?u2)])
).

:- corollary(urls_in_text:functional,
all [cs, u1, u2]: succeeds r_urls_in_text(?cs, ?u1) &
 succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2,
assume(succeeds r_urls_in_text(?cs, ?u1) & succeeds r_urls_in_text(?cs, ?u2),
 [(all [cs, u1]: succeeds r_urls_in_text(?cs, ?u1) =>
    (all u2: succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2))
    by lemma(urls_in_text:functional:sim),
  succeeds r_urls_in_text(?cs, ?u1) =>
   (all u2: succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2),
  all u2: succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2,
  succeeds r_urls_in_text(?cs, ?u2) => ?u1 = ?u2,
  ?u1 = ?u2],
 ?u1 = ?u2)
).

/* What the duplicate filter does, in three laws about the one predicate that
   does the work: tfilter(dif_t(X), ...), which is r_without/3 here. The
   first is what makes unique/2 duplicate-free at all -- the element just
   emitted is gone from what remains. */

:- lemma(without:notin,
all [x, xs, kept]: succeeds r_without(?x, ?xs, ?kept) =>
 succeeds r_notin(?x, ?kept),
induction(
 [all [x, xs, kept]: succeeds r_without(?x, ?xs, ?kept) =>
   succeeds r_notin(?x, ?kept)],
 [step([x],
   [],
   [succeeds r_notin(?x, [])],
   succeeds r_notin(?x, [])),
  step([x, ys, kept],
   [succeeds r_notin(?x, ?kept),
    succeeds r_without(?x, ?ys, ?kept)],
   [],
   succeeds r_notin(?x, ?kept)),
  step([x, y, ys, kept],
   [succeeds r_notin(?x, ?kept),
    ?x <> ?y,
    succeeds r_without(?x, ?ys, ?kept)],
   [succeeds r_notin(?x, [?y|?kept])],
   succeeds r_notin(?x, [?y|?kept]))])
).

:- lemma(without:preserves:notin,
all [x, xs, kept]: succeeds r_without(?x, ?xs, ?kept) =>
 (all w: succeeds r_notin(?w, ?xs) => succeeds r_notin(?w, ?kept)),
induction(
 [all [x, xs, kept]: succeeds r_without(?x, ?xs, ?kept) =>
   (all w: succeeds r_notin(?w, ?xs) => succeeds r_notin(?w, ?kept))],
 [step([x],
   [],
   [assume(succeeds r_notin(?w, []),
     [succeeds r_notin(?w, [])],
     succeeds r_notin(?w, []))],
   all w: succeeds r_notin(?w, []) => succeeds r_notin(?w, [])),
  step([x, ys, kept],
   [all w: succeeds r_notin(?w, ?ys) => succeeds r_notin(?w, ?kept),
    succeeds r_without(?x, ?ys, ?kept)],
   [assume(succeeds r_notin(?w, [?x|?ys]),
     [def succeeds r_notin(?w, [?x|?ys]) by completion,
      succeeds r_notin(?w, ?ys),
      succeeds r_notin(?w, ?ys) => succeeds r_notin(?w, ?kept),
      succeeds r_notin(?w, ?kept)],
     succeeds r_notin(?w, ?kept))],
   all w: succeeds r_notin(?w, [?x|?ys]) => succeeds r_notin(?w, ?kept)),
  step([x, y, ys, kept],
   [all w: succeeds r_notin(?w, ?ys) => succeeds r_notin(?w, ?kept),
    ?x <> ?y,
    succeeds r_without(?x, ?ys, ?kept)],
   [assume(succeeds r_notin(?w, [?y|?ys]),
     [def succeeds r_notin(?w, [?y|?ys]) by completion,
      succeeds r_notin(?w, ?ys),
      succeeds r_notin(?w, ?ys) => succeeds r_notin(?w, ?kept),
      succeeds r_notin(?w, ?kept),
      succeeds r_notin(?w, [?y|?kept])],
     succeeds r_notin(?w, [?y|?kept]))],
   all w: succeeds r_notin(?w, [?y|?ys]) => succeeds r_notin(?w, [?y|?kept]))])
).

:- lemma(without:subset,
all [x, xs, kept]: succeeds r_without(?x, ?xs, ?kept) =>
 (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?xs)),
induction(
 [all [x, xs, kept]: succeeds r_without(?x, ?xs, ?kept) =>
   (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?xs))],
 [step([x],
   [],
   [assume(succeeds r_in(?w, []),
     [],
     succeeds r_in(?w, []))],
   all w: succeeds r_in(?w, []) => succeeds r_in(?w, [])),
  step([x, ys, kept],
   [all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?ys),
    succeeds r_without(?x, ?ys, ?kept)],
   [assume(succeeds r_in(?w, ?kept),
     [succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?ys),
      succeeds r_in(?w, ?ys),
      succeeds r_in(?w, [?x|?ys])],
     succeeds r_in(?w, [?x|?ys]))],
   all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, [?x|?ys])),
  step([x, y, ys, kept],
   [all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?ys),
    ?x <> ?y,
    succeeds r_without(?x, ?ys, ?kept)],
   [assume(succeeds r_in(?w, [?y|?kept]),
     [def succeeds r_in(?w, [?y|?kept]) by completion,
      cases(?w = ?y,
       [succeeds r_in(?y, [?y|?ys]),
        succeeds r_in(?w, [?y|?ys])],
       succeeds r_in(?w, ?kept),
       [succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?ys),
        succeeds r_in(?w, ?ys),
        succeeds r_in(?w, [?y|?ys])],
       succeeds r_in(?w, [?y|?ys]))],
     succeeds r_in(?w, [?y|?ys]))],
   all w: succeeds r_in(?w, [?y|?kept]) => succeeds r_in(?w, [?y|?ys]))])
).

/* unique/2 keeps what is not there already out of its output, and so is
   duplicate-free. This is the law that makes one token shared by many posts
   cost one question of the redirector rather than one per post. */

:- lemma(unique:preserves:notin,
all [xs, out]: succeeds r_unique(?xs, ?out) =>
 (all w: succeeds r_notin(?w, ?xs) => succeeds r_notin(?w, ?out)),
induction(
 [all [xs, out]: succeeds r_unique(?xs, ?out) =>
   (all w: succeeds r_notin(?w, ?xs) => succeeds r_notin(?w, ?out))],
 [step([],
   [],
   [assume(succeeds r_notin(?w, []),
     [succeeds r_notin(?w, [])],
     succeeds r_notin(?w, []))],
   all w: succeeds r_notin(?w, []) => succeeds r_notin(?w, [])),
  step([x, xs, rest, remaining],
   [all w: succeeds r_notin(?w, ?remaining) => succeeds r_notin(?w, ?rest),
    succeeds r_without(?x, ?xs, ?remaining),
    succeeds r_unique(?remaining, ?rest)],
   [assume(succeeds r_notin(?w, [?x|?xs]),
     [def succeeds r_notin(?w, [?x|?xs]) by completion,
      succeeds r_notin(?w, ?xs),
      succeeds r_without(?x, ?xs, ?remaining) =>
        (all z: succeeds r_notin(?z, ?xs) => succeeds r_notin(?z, ?remaining))
        by lemma(without:preserves:notin),
      all z: succeeds r_notin(?z, ?xs) => succeeds r_notin(?z, ?remaining),
      succeeds r_notin(?w, ?xs) => succeeds r_notin(?w, ?remaining),
      succeeds r_notin(?w, ?remaining),
      succeeds r_notin(?w, ?remaining) => succeeds r_notin(?w, ?rest),
      succeeds r_notin(?w, ?rest),
      succeeds r_notin(?w, [?x|?rest])],
     succeeds r_notin(?w, [?x|?rest]))],
   all w: succeeds r_notin(?w, [?x|?xs]) =>
    succeeds r_notin(?w, [?x|?rest]))])
).

:- lemma(unique:nodup,
all [xs, out]: succeeds r_unique(?xs, ?out) => succeeds r_nodup(?out),
induction(
 [all [xs, out]: succeeds r_unique(?xs, ?out) => succeeds r_nodup(?out)],
 [step([],
   [],
   [succeeds r_nodup([])],
   succeeds r_nodup([])),
  step([x, xs, rest, remaining],
   [succeeds r_nodup(?rest),
    succeeds r_without(?x, ?xs, ?remaining),
    succeeds r_unique(?remaining, ?rest)],
   [succeeds r_without(?x, ?xs, ?remaining) =>
      succeeds r_notin(?x, ?remaining) by lemma(without:notin),
    succeeds r_notin(?x, ?remaining),
    succeeds r_unique(?remaining, ?rest) =>
      (all w: succeeds r_notin(?w, ?remaining) => succeeds r_notin(?w, ?rest))
      by lemma(unique:preserves:notin),
    all w: succeeds r_notin(?w, ?remaining) => succeeds r_notin(?w, ?rest),
    succeeds r_notin(?x, ?remaining) => succeeds r_notin(?x, ?rest),
    succeeds r_notin(?x, ?rest),
    succeeds r_nodup([?x|?rest])],
   succeeds r_nodup([?x|?rest]))])
).

:- lemma(unique:subset,
all [xs, out]: succeeds r_unique(?xs, ?out) =>
 (all w: succeeds r_in(?w, ?out) => succeeds r_in(?w, ?xs)),
induction(
 [all [xs, out]: succeeds r_unique(?xs, ?out) =>
   (all w: succeeds r_in(?w, ?out) => succeeds r_in(?w, ?xs))],
 [step([],
   [],
   [assume(succeeds r_in(?w, []),
     [],
     succeeds r_in(?w, []))],
   all w: succeeds r_in(?w, []) => succeeds r_in(?w, [])),
  step([x, xs, rest, remaining],
   [all w: succeeds r_in(?w, ?rest) => succeeds r_in(?w, ?remaining),
    succeeds r_without(?x, ?xs, ?remaining),
    succeeds r_unique(?remaining, ?rest)],
   [assume(succeeds r_in(?w, [?x|?rest]),
     [def succeeds r_in(?w, [?x|?rest]) by completion,
      cases(?w = ?x,
       [succeeds r_in(?x, [?x|?xs]),
        succeeds r_in(?w, [?x|?xs])],
       succeeds r_in(?w, ?rest),
       [succeeds r_in(?w, ?rest) => succeeds r_in(?w, ?remaining),
        succeeds r_in(?w, ?remaining),
        succeeds r_without(?x, ?xs, ?remaining) =>
          (all z: succeeds r_in(?z, ?remaining) => succeeds r_in(?z, ?xs))
          by lemma(without:subset),
        all z: succeeds r_in(?z, ?remaining) => succeeds r_in(?z, ?xs),
        succeeds r_in(?w, ?remaining) => succeeds r_in(?w, ?xs),
        succeeds r_in(?w, ?xs),
        succeeds r_in(?w, [?x|?xs])],
       succeeds r_in(?w, [?x|?xs]))],
     succeeds r_in(?w, [?x|?xs]))],
   all w: succeeds r_in(?w, [?x|?rest]) => succeeds r_in(?w, [?x|?xs]))])
).

/* And the shortened-only filter keeps a subset of what it was given --
   tfilter(shortened_url_t, ...) here, with the verdict dispatched by the
   continuation, so the induction is simultaneous over the two. */

:- lemma(filter_shortened:subset:sim,
(all [us, kept]: succeeds r_filter_shortened(?us, ?kept) =>
  (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us))) &
(all [b, u, us, kept]: succeeds r_filter_shortened_(?b, ?u, ?us, ?kept) =>
  (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, [?u|?us]))),
induction(
 [all [us, kept]: succeeds r_filter_shortened(?us, ?kept) =>
   (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us)),
  all [b, u, us, kept]: succeeds r_filter_shortened_(?b, ?u, ?us, ?kept) =>
   (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, [?u|?us]))],
 [step([],
   [],
   [assume(succeeds r_in(?w, []),
     [],
     succeeds r_in(?w, []))],
   all w: succeeds r_in(?w, []) => succeeds r_in(?w, [])),
  step([u, us, kept, truth],
   [all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, [?u|?us]),
    succeeds r_shortened_url_t(?u, ?truth),
    succeeds r_filter_shortened_(?truth, ?u, ?us, ?kept)],
   [],
   all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, [?u|?us])),
  step([u, us, kept],
   [all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us),
    succeeds r_filter_shortened(?us, ?kept)],
   [assume(succeeds r_in(?w, [?u|?kept]),
     [def succeeds r_in(?w, [?u|?kept]) by completion,
      cases(?w = ?u,
       [succeeds r_in(?u, [?u|?us]),
        succeeds r_in(?w, [?u|?us])],
       succeeds r_in(?w, ?kept),
       [succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us),
        succeeds r_in(?w, ?us),
        succeeds r_in(?w, [?u|?us])],
       succeeds r_in(?w, [?u|?us]))],
     succeeds r_in(?w, [?u|?us]))],
   all w: succeeds r_in(?w, [?u|?kept]) => succeeds r_in(?w, [?u|?us])),
  step([u, us, kept],
   [all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us),
    succeeds r_filter_shortened(?us, ?kept)],
   [assume(succeeds r_in(?w, ?kept),
     [succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us),
      succeeds r_in(?w, ?us),
      succeeds r_in(?w, [?u|?us])],
     succeeds r_in(?w, [?u|?us]))],
   all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, [?u|?us]))])
).

:- corollary(filter_shortened:subset,
all [us, kept]: succeeds r_filter_shortened(?us, ?kept) =>
 (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us)),
assume(succeeds r_filter_shortened(?us, ?kept),
 [(all [us, kept]: succeeds r_filter_shortened(?us, ?kept) =>
    (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us)))
    by lemma(filter_shortened:subset:sim),
  succeeds r_filter_shortened(?us, ?kept) =>
   (all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us)),
  all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us)],
 all w: succeeds r_in(?w, ?kept) => succeeds r_in(?w, ?us))
).

/* Obligation A6: what the scan hands the expander is a subset of the
   addresses the post carries, and carries no address twice. The second half
   is what keeps the budget honest -- a duplicate spends it twice on one
   link -- and the first is what says the expander is never asked about an
   address the post does not contain. */

:- corollary(shortened:subset:nodup,
all [cs, urls, shortened]: succeeds r_urls_in_text(?cs, ?urls) &
 succeeds r_shortened_urls_in_text(?cs, ?shortened) =>
 (all w: succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?urls)) &
 succeeds r_nodup(?shortened),
assume(succeeds r_urls_in_text(?cs, ?urls) &
  succeeds r_shortened_urls_in_text(?cs, ?shortened),
 [def succeeds r_shortened_urls_in_text(?cs, ?shortened) by completion,
  exist([urls2, withdup],
   succeeds r_urls_in_text(?cs, ?urls2) &
    succeeds r_filter_shortened(?urls2, ?withdup) &
    succeeds r_unique(?withdup, ?shortened),
   [succeeds r_urls_in_text(?cs, ?urls) &
      succeeds r_urls_in_text(?cs, ?urls2) =>
      ?urls = ?urls2 by corollary(urls_in_text:functional),
    ?urls = ?urls2,
    succeeds r_filter_shortened(?urls, ?withdup),
    succeeds r_unique(?withdup, ?shortened) =>
      (all w: succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?withdup))
      by lemma(unique:subset),
    all w: succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?withdup),
    succeeds r_filter_shortened(?urls, ?withdup) =>
      (all w: succeeds r_in(?w, ?withdup) => succeeds r_in(?w, ?urls))
      by corollary(filter_shortened:subset),
    all w: succeeds r_in(?w, ?withdup) => succeeds r_in(?w, ?urls),
    assume(succeeds r_in(?w, ?shortened),
     [succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?withdup),
      succeeds r_in(?w, ?withdup),
      succeeds r_in(?w, ?withdup) => succeeds r_in(?w, ?urls),
      succeeds r_in(?w, ?urls)],
     succeeds r_in(?w, ?urls)),
    all w: succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?urls),
    succeeds r_unique(?withdup, ?shortened) => succeeds r_nodup(?shortened)
      by lemma(unique:nodup),
    succeeds r_nodup(?shortened),
    (all w: succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?urls)) &
      succeeds r_nodup(?shortened)],
   (all w: succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?urls)) &
    succeeds r_nodup(?shortened))],
 (all w: succeeds r_in(?w, ?shortened) => succeeds r_in(?w, ?urls)) &
  succeeds r_nodup(?shortened))
).

/* The two counters that stand in for length/2 and the range test over it:
   `at least two characters' and `at most fourteen'. They answer for every
   list, proper or not -- the induction is over the derivation -- and they
   answer once. */

:- lemma(at_least:boolean,
all [n, xs, b]: succeeds r_at_least(?n, ?xs, ?b) => ?b = true \/ ?b = false,
induction(
 [all [n, xs, b]: succeeds r_at_least(?n, ?xs, ?b) => ?b = true \/ ?b = false],
 [step([xs],
   [],
   [],
   true = true \/ true = false),
  step([n],
   [],
   [],
   false = true \/ false = false),
  step([n, x, xs, b],
   [?b = true \/ ?b = false,
    succeeds r_at_least(?n, ?xs, ?b)],
   [],
   ?b = true \/ ?b = false)])
).

:- lemma(at_least:functional,
all [n, xs, b1, b2]: succeeds r_at_least(?n, ?xs, ?b1) &
 succeeds r_at_least(?n, ?xs, ?b2) => ?b1 = ?b2,
[induction(
  [all [n, xs, b1]: succeeds r_at_least(?n, ?xs, ?b1) =>
    (all b2: succeeds r_at_least(?n, ?xs, ?b2) => ?b1 = ?b2)],
  [step([xs],
    [],
    assume(succeeds r_at_least(z, ?xs, ?b2),
     [def succeeds r_at_least(z, ?xs, ?b2) by completion,
      ?b2 = true],
     true = ?b2),
    all b2: succeeds r_at_least(z, ?xs, ?b2) => true = ?b2),
   step([n],
    [],
    assume(succeeds r_at_least(s(?n), [], ?b2),
     [def succeeds r_at_least(s(?n), [], ?b2) by completion,
      ?b2 = false],
     false = ?b2),
    all b2: succeeds r_at_least(s(?n), [], ?b2) => false = ?b2),
   step([n, x, xs, b1],
    [all b2: succeeds r_at_least(?n, ?xs, ?b2) => ?b1 = ?b2,
     succeeds r_at_least(?n, ?xs, ?b1)],
    assume(succeeds r_at_least(s(?n), [?x|?xs], ?b2),
     [def succeeds r_at_least(s(?n), [?x|?xs], ?b2) by completion,
      succeeds r_at_least(?n, ?xs, ?b2),
      succeeds r_at_least(?n, ?xs, ?b2) => ?b1 = ?b2,
      ?b1 = ?b2],
     ?b1 = ?b2),
    all b2: succeeds r_at_least(s(?n), [?x|?xs], ?b2) => ?b1 = ?b2)]),
 assume(succeeds r_at_least(?n, ?xs, ?b1) & succeeds r_at_least(?n, ?xs, ?b2),
  [succeeds r_at_least(?n, ?xs, ?b1) =>
    (all b2: succeeds r_at_least(?n, ?xs, ?b2) => ?b1 = ?b2),
   all b2: succeeds r_at_least(?n, ?xs, ?b2) => ?b1 = ?b2,
   succeeds r_at_least(?n, ?xs, ?b2) => ?b1 = ?b2,
   ?b1 = ?b2],
  ?b1 = ?b2)]
).

:- lemma(at_most:boolean,
all [n, xs, b]: succeeds r_at_most(?n, ?xs, ?b) => ?b = true \/ ?b = false,
induction(
 [all [n, xs, b]: succeeds r_at_most(?n, ?xs, ?b) => ?b = true \/ ?b = false],
 [step([n],
   [],
   [],
   true = true \/ true = false),
  step([x, xs],
   [],
   [],
   false = true \/ false = false),
  step([n, x, xs, b],
   [?b = true \/ ?b = false,
    succeeds r_at_most(?n, ?xs, ?b)],
   [],
   ?b = true \/ ?b = false)])
).

:- lemma(at_most:functional,
all [n, xs, b1, b2]: succeeds r_at_most(?n, ?xs, ?b1) &
 succeeds r_at_most(?n, ?xs, ?b2) => ?b1 = ?b2,
[induction(
  [all [n, xs, b1]: succeeds r_at_most(?n, ?xs, ?b1) =>
    (all b2: succeeds r_at_most(?n, ?xs, ?b2) => ?b1 = ?b2)],
  [step([n],
    [],
    assume(succeeds r_at_most(?n, [], ?b2),
     [def succeeds r_at_most(?n, [], ?b2) by completion,
      ?b2 = true],
     true = ?b2),
    all b2: succeeds r_at_most(?n, [], ?b2) => true = ?b2),
   step([x, xs],
    [],
    assume(succeeds r_at_most(z, [?x|?xs], ?b2),
     [def succeeds r_at_most(z, [?x|?xs], ?b2) by completion,
      ?b2 = false],
     false = ?b2),
    all b2: succeeds r_at_most(z, [?x|?xs], ?b2) => false = ?b2),
   step([n, x, xs, b1],
    [all b2: succeeds r_at_most(?n, ?xs, ?b2) => ?b1 = ?b2,
     succeeds r_at_most(?n, ?xs, ?b1)],
    assume(succeeds r_at_most(s(?n), [?x|?xs], ?b2),
     [def succeeds r_at_most(s(?n), [?x|?xs], ?b2) by completion,
      succeeds r_at_most(?n, ?xs, ?b2),
      succeeds r_at_most(?n, ?xs, ?b2) => ?b1 = ?b2,
      ?b1 = ?b2],
     ?b1 = ?b2),
    all b2: succeeds r_at_most(s(?n), [?x|?xs], ?b2) => ?b1 = ?b2)]),
 assume(succeeds r_at_most(?n, ?xs, ?b1) & succeeds r_at_most(?n, ?xs, ?b2),
  [succeeds r_at_most(?n, ?xs, ?b1) =>
    (all b2: succeeds r_at_most(?n, ?xs, ?b2) => ?b1 = ?b2),
   all b2: succeeds r_at_most(?n, ?xs, ?b2) => ?b1 = ?b2,
   succeeds r_at_most(?n, ?xs, ?b2) => ?b1 = ?b2,
   ?b1 = ?b2],
  ?b1 = ?b2)]
).

:- lemma(len_in_t_:boolean,
all [b0, xs, b]: succeeds r_len_in_t_(?b0, ?xs, ?b) =>
 ?b = true \/ ?b = false,
assume(succeeds r_len_in_t_(?b0, ?xs, ?b),
 [def succeeds r_len_in_t_(?b0, ?xs, ?b) by completion,
  cases(?b0 = false & ?b = false,
   [?b = true \/ ?b = false],
   ?b0 = true & succeeds r_at_most(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z)))))))))))))), ?xs, ?b),
   [?b = true \/ ?b = false by lemma(at_most:boolean)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(len_in_t_:functional,
all [b0, xs, b1, b2]: succeeds r_len_in_t_(?b0, ?xs, ?b1) &
 succeeds r_len_in_t_(?b0, ?xs, ?b2) => ?b1 = ?b2,
assume(succeeds r_len_in_t_(?b0, ?xs, ?b1) &
  succeeds r_len_in_t_(?b0, ?xs, ?b2),
 [def succeeds r_len_in_t_(?b0, ?xs, ?b1) by completion,
  def succeeds r_len_in_t_(?b0, ?xs, ?b2) by completion,
  cases(?b0 = false & ?b1 = false,
   [cases(?b0 = false & ?b2 = false,
     [?b1 = ?b2],
     ?b0 = true & succeeds r_at_most(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z)))))))))))))), ?xs, ?b2),
     [ff],
     ?b1 = ?b2)],
   ?b0 = true & succeeds r_at_most(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z)))))))))))))), ?xs, ?b1),
   [cases(?b0 = false & ?b2 = false,
     [ff],
     ?b0 = true & succeeds r_at_most(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z)))))))))))))), ?xs, ?b2),
     [succeeds r_at_most(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z)))))))))))))), ?xs, ?b1) &
        succeeds r_at_most(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z)))))))))))))), ?xs, ?b2) =>
        ?b1 = ?b2 by lemma(at_most:functional),
      ?b1 = ?b2],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(len_in:boolean,
all [xs, b]: succeeds r_len_in_t(?xs, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_len_in_t(?xs, ?b),
 [def succeeds r_len_in_t(?xs, ?b) by completion,
  exist(two,
   succeeds r_at_least(s(s(z)), ?xs, ?two) &
    succeeds r_len_in_t_(?two, ?xs, ?b),
   [?b = true \/ ?b = false by lemma(len_in_t_:boolean)],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(len_in:functional,
all [xs, b1, b2]: succeeds r_len_in_t(?xs, ?b1) &
 succeeds r_len_in_t(?xs, ?b2) => ?b1 = ?b2,
assume(succeeds r_len_in_t(?xs, ?b1) & succeeds r_len_in_t(?xs, ?b2),
 [def succeeds r_len_in_t(?xs, ?b1) by completion,
  def succeeds r_len_in_t(?xs, ?b2) by completion,
  exist(t1,
   succeeds r_at_least(s(s(z)), ?xs, ?t1) &
    succeeds r_len_in_t_(?t1, ?xs, ?b1),
   [exist(t2,
     succeeds r_at_least(s(s(z)), ?xs, ?t2) &
      succeeds r_len_in_t_(?t2, ?xs, ?b2),
     [succeeds r_at_least(s(s(z)), ?xs, ?t1) &
        succeeds r_at_least(s(s(z)), ?xs, ?t2) =>
        ?t1 = ?t2 by lemma(at_least:functional),
      ?t1 = ?t2,
      succeeds r_len_in_t_(?t1, ?xs, ?b2),
      succeeds r_len_in_t_(?t1, ?xs, ?b1) &
        succeeds r_len_in_t_(?t1, ?xs, ?b2) =>
        ?b1 = ?b2 by lemma(len_in_t_:functional),
      ?b1 = ?b2],
     ?b1 = ?b2)],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(short_enough:boolean,
all [chars, b]: succeeds r_short_enough_t(?chars, ?b) =>
 ?b = true \/ ?b = false,
assume(succeeds r_short_enough_t(?chars, ?b),
 [def succeeds r_short_enough_t(?chars, ?b) by completion,
  succeeds r_at_most(s(s(s(s(z)))), ?chars, ?b),
  ?b = true \/ ?b = false by lemma(at_most:boolean)],
 ?b = true \/ ?b = false)
).

:- lemma(short_enough:functional,
all [chars, b1, b2]: succeeds r_short_enough_t(?chars, ?b1) &
 succeeds r_short_enough_t(?chars, ?b2) => ?b1 = ?b2,
assume(succeeds r_short_enough_t(?chars, ?b1) &
  succeeds r_short_enough_t(?chars, ?b2),
 [def succeeds r_short_enough_t(?chars, ?b1) by completion,
  def succeeds r_short_enough_t(?chars, ?b2) by completion,
  succeeds r_at_most(s(s(s(s(z)))), ?chars, ?b1) &
    succeeds r_at_most(s(s(s(s(z)))), ?chars, ?b2) =>
    ?b1 = ?b2 by lemma(at_most:functional),
  ?b1 = ?b2],
 ?b1 = ?b2)
).

/* `every character of this path segment is a token character', and `some
   character of it is in this class' -- the two folds opaque_short_path_t/2
   is decided by. Both walk a list carrying a verdict, so both are a
   simultaneous induction with the continuation that dispatches on it. */

:- lemma(all_token_chars:boolean:sim,
(all [xs, b]: succeeds r_all_token_chars_t(?xs, ?b) =>
  ?b = true \/ ?b = false) &
(all [b0, cs, b]: succeeds r_all_token_chars_t_(?b0, ?cs, ?b) =>
  ?b = true \/ ?b = false),
induction(
 [all [xs, b]: succeeds r_all_token_chars_t(?xs, ?b) =>
   ?b = true \/ ?b = false,
  all [b0, cs, b]: succeeds r_all_token_chars_t_(?b0, ?cs, ?b) =>
   ?b = true \/ ?b = false],
 [step([],
   [],
   [],
   true = true \/ true = false),
  step([c, cs, b, token],
   [?b = true \/ ?b = false,
    succeeds r_cond_t(token, ?c, ?token),
    succeeds r_all_token_chars_t_(?token, ?cs, ?b)],
   [],
   ?b = true \/ ?b = false),
  step([cs, b],
   [?b = true \/ ?b = false,
    succeeds r_all_token_chars_t(?cs, ?b)],
   [],
   ?b = true \/ ?b = false),
  step([cs],
   [],
   [],
   false = true \/ false = false)])
).

:- lemma(all_token_chars:functional:sim,
(all [xs, b1]: succeeds r_all_token_chars_t(?xs, ?b1) =>
  (all b2: succeeds r_all_token_chars_t(?xs, ?b2) => ?b1 = ?b2)) &
(all [b0, cs, b1]: succeeds r_all_token_chars_t_(?b0, ?cs, ?b1) =>
  (all b2: succeeds r_all_token_chars_t_(?b0, ?cs, ?b2) => ?b1 = ?b2)),
induction(
 [all [xs, b1]: succeeds r_all_token_chars_t(?xs, ?b1) =>
   (all b2: succeeds r_all_token_chars_t(?xs, ?b2) => ?b1 = ?b2),
  all [b0, cs, b1]: succeeds r_all_token_chars_t_(?b0, ?cs, ?b1) =>
   (all b2: succeeds r_all_token_chars_t_(?b0, ?cs, ?b2) => ?b1 = ?b2)],
 [step([],
   [],
   assume(succeeds r_all_token_chars_t([], ?b2),
    [def succeeds r_all_token_chars_t([], ?b2) by completion,
     ?b2 = true],
    true = ?b2),
   all b2: succeeds r_all_token_chars_t([], ?b2) => true = ?b2),
  step([c, cs, b1, token],
   [all b2: succeeds r_all_token_chars_t_(?token, ?cs, ?b2) => ?b1 = ?b2,
    succeeds r_cond_t(token, ?c, ?token),
    succeeds r_all_token_chars_t_(?token, ?cs, ?b1)],
   assume(succeeds r_all_token_chars_t([?c|?cs], ?b2),
    [def succeeds r_all_token_chars_t([?c|?cs], ?b2) by completion,
     exist(v2,
      succeeds r_cond_t(token, ?c, ?v2) &
       succeeds r_all_token_chars_t_(?v2, ?cs, ?b2),
      [succeeds r_cond_t(token, ?c, ?token) &
         succeeds r_cond_t(token, ?c, ?v2) =>
         ?token = ?v2 by lemma(cond:functional),
       ?token = ?v2,
       succeeds r_all_token_chars_t_(?token, ?cs, ?b2),
       succeeds r_all_token_chars_t_(?token, ?cs, ?b2) => ?b1 = ?b2,
       ?b1 = ?b2],
      ?b1 = ?b2)],
    ?b1 = ?b2),
   all b2: succeeds r_all_token_chars_t([?c|?cs], ?b2) => ?b1 = ?b2),
  step([cs, b1],
   [all b2: succeeds r_all_token_chars_t(?cs, ?b2) => ?b1 = ?b2,
    succeeds r_all_token_chars_t(?cs, ?b1)],
   assume(succeeds r_all_token_chars_t_(true, ?cs, ?b2),
    [def succeeds r_all_token_chars_t_(true, ?cs, ?b2) by completion,
     succeeds r_all_token_chars_t(?cs, ?b2),
     succeeds r_all_token_chars_t(?cs, ?b2) => ?b1 = ?b2,
     ?b1 = ?b2],
    ?b1 = ?b2),
   all b2: succeeds r_all_token_chars_t_(true, ?cs, ?b2) => ?b1 = ?b2),
  step([cs],
   [],
   assume(succeeds r_all_token_chars_t_(false, ?cs, ?b2),
    [def succeeds r_all_token_chars_t_(false, ?cs, ?b2) by completion,
     ?b2 = false],
    false = ?b2),
   all b2: succeeds r_all_token_chars_t_(false, ?cs, ?b2) => false = ?b2)])
).

:- corollary(all_token_chars:boolean,
all [xs, b]: succeeds r_all_token_chars_t(?xs, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_all_token_chars_t(?xs, ?b),
 [(all [xs, b]: succeeds r_all_token_chars_t(?xs, ?b) =>
    ?b = true \/ ?b = false) by lemma(all_token_chars:boolean:sim),
  succeeds r_all_token_chars_t(?xs, ?b) => ?b = true \/ ?b = false,
  ?b = true \/ ?b = false],
 ?b = true \/ ?b = false)
).

:- corollary(all_token_chars:functional,
all [xs, b1, b2]: succeeds r_all_token_chars_t(?xs, ?b1) &
 succeeds r_all_token_chars_t(?xs, ?b2) => ?b1 = ?b2,
assume(succeeds r_all_token_chars_t(?xs, ?b1) &
  succeeds r_all_token_chars_t(?xs, ?b2),
 [(all [xs, b1]: succeeds r_all_token_chars_t(?xs, ?b1) =>
    (all b2: succeeds r_all_token_chars_t(?xs, ?b2) => ?b1 = ?b2))
    by lemma(all_token_chars:functional:sim),
  succeeds r_all_token_chars_t(?xs, ?b1) =>
   (all b2: succeeds r_all_token_chars_t(?xs, ?b2) => ?b1 = ?b2),
  all b2: succeeds r_all_token_chars_t(?xs, ?b2) => ?b1 = ?b2,
  succeeds r_all_token_chars_t(?xs, ?b2) => ?b1 = ?b2,
  ?b1 = ?b2],
 ?b1 = ?b2)
).

:- lemma(any:boolean:sim,
(all [tag, xs, b]: succeeds r_any_t(?tag, ?xs, ?b) =>
  ?b = true \/ ?b = false) &
(all [b0, tag, cs, b]: succeeds r_any_t_(?b0, ?tag, ?cs, ?b) =>
  ?b = true \/ ?b = false),
induction(
 [all [tag, xs, b]: succeeds r_any_t(?tag, ?xs, ?b) =>
   ?b = true \/ ?b = false,
  all [b0, tag, cs, b]: succeeds r_any_t_(?b0, ?tag, ?cs, ?b) =>
   ?b = true \/ ?b = false],
 [step([tag],
   [],
   [],
   false = true \/ false = false),
  step([tag, c, cs, b, here],
   [?b = true \/ ?b = false,
    succeeds r_cond_t(?tag, ?c, ?here),
    succeeds r_any_t_(?here, ?tag, ?cs, ?b)],
   [],
   ?b = true \/ ?b = false),
  step([tag, cs],
   [],
   [],
   true = true \/ true = false),
  step([tag, cs, b],
   [?b = true \/ ?b = false,
    succeeds r_any_t(?tag, ?cs, ?b)],
   [],
   ?b = true \/ ?b = false)])
).

:- lemma(any:functional:sim,
(all [tag, xs, b1]: succeeds r_any_t(?tag, ?xs, ?b1) =>
  (all b2: succeeds r_any_t(?tag, ?xs, ?b2) => ?b1 = ?b2)) &
(all [b0, tag, cs, b1]: succeeds r_any_t_(?b0, ?tag, ?cs, ?b1) =>
  (all b2: succeeds r_any_t_(?b0, ?tag, ?cs, ?b2) => ?b1 = ?b2)),
induction(
 [all [tag, xs, b1]: succeeds r_any_t(?tag, ?xs, ?b1) =>
   (all b2: succeeds r_any_t(?tag, ?xs, ?b2) => ?b1 = ?b2),
  all [b0, tag, cs, b1]: succeeds r_any_t_(?b0, ?tag, ?cs, ?b1) =>
   (all b2: succeeds r_any_t_(?b0, ?tag, ?cs, ?b2) => ?b1 = ?b2)],
 [step([tag],
   [],
   assume(succeeds r_any_t(?tag, [], ?b2),
    [def succeeds r_any_t(?tag, [], ?b2) by completion,
     ?b2 = false],
    false = ?b2),
   all b2: succeeds r_any_t(?tag, [], ?b2) => false = ?b2),
  step([tag, c, cs, b1, here],
   [all b2: succeeds r_any_t_(?here, ?tag, ?cs, ?b2) => ?b1 = ?b2,
    succeeds r_cond_t(?tag, ?c, ?here),
    succeeds r_any_t_(?here, ?tag, ?cs, ?b1)],
   assume(succeeds r_any_t(?tag, [?c|?cs], ?b2),
    [def succeeds r_any_t(?tag, [?c|?cs], ?b2) by completion,
     exist(v2,
      succeeds r_cond_t(?tag, ?c, ?v2) &
       succeeds r_any_t_(?v2, ?tag, ?cs, ?b2),
      [succeeds r_cond_t(?tag, ?c, ?here) & succeeds r_cond_t(?tag, ?c, ?v2)
         => ?here = ?v2 by lemma(cond:functional),
       ?here = ?v2,
       succeeds r_any_t_(?here, ?tag, ?cs, ?b2),
       succeeds r_any_t_(?here, ?tag, ?cs, ?b2) => ?b1 = ?b2,
       ?b1 = ?b2],
      ?b1 = ?b2)],
    ?b1 = ?b2),
   all b2: succeeds r_any_t(?tag, [?c|?cs], ?b2) => ?b1 = ?b2),
  step([tag, cs],
   [],
   assume(succeeds r_any_t_(true, ?tag, ?cs, ?b2),
    [def succeeds r_any_t_(true, ?tag, ?cs, ?b2) by completion,
     ?b2 = true],
    true = ?b2),
   all b2: succeeds r_any_t_(true, ?tag, ?cs, ?b2) => true = ?b2),
  step([tag, cs, b1],
   [all b2: succeeds r_any_t(?tag, ?cs, ?b2) => ?b1 = ?b2,
    succeeds r_any_t(?tag, ?cs, ?b1)],
   assume(succeeds r_any_t_(false, ?tag, ?cs, ?b2),
    [def succeeds r_any_t_(false, ?tag, ?cs, ?b2) by completion,
     succeeds r_any_t(?tag, ?cs, ?b2),
     succeeds r_any_t(?tag, ?cs, ?b2) => ?b1 = ?b2,
     ?b1 = ?b2],
    ?b1 = ?b2),
   all b2: succeeds r_any_t_(false, ?tag, ?cs, ?b2) => ?b1 = ?b2)])
).

:- corollary(any:boolean,
all [tag, xs, b]: succeeds r_any_t(?tag, ?xs, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_any_t(?tag, ?xs, ?b),
 [(all [tag, xs, b]: succeeds r_any_t(?tag, ?xs, ?b) =>
    ?b = true \/ ?b = false) by lemma(any:boolean:sim),
  succeeds r_any_t(?tag, ?xs, ?b) => ?b = true \/ ?b = false,
  ?b = true \/ ?b = false],
 ?b = true \/ ?b = false)
).

:- corollary(any:functional,
all [tag, xs, b1, b2]: succeeds r_any_t(?tag, ?xs, ?b1) &
 succeeds r_any_t(?tag, ?xs, ?b2) => ?b1 = ?b2,
assume(succeeds r_any_t(?tag, ?xs, ?b1) & succeeds r_any_t(?tag, ?xs, ?b2),
 [(all [tag, xs, b1]: succeeds r_any_t(?tag, ?xs, ?b1) =>
    (all b2: succeeds r_any_t(?tag, ?xs, ?b2) => ?b1 = ?b2))
    by lemma(any:functional:sim),
  succeeds r_any_t(?tag, ?xs, ?b1) =>
   (all b2: succeeds r_any_t(?tag, ?xs, ?b2) => ?b1 = ?b2),
  all b2: succeeds r_any_t(?tag, ?xs, ?b2) => ?b1 = ?b2,
  succeeds r_any_t(?tag, ?xs, ?b2) => ?b1 = ?b2,
  ?b1 = ?b2],
 ?b1 = ?b2)
).

/* The shape test and the segment test, one continuation at a time, from the
   leaves up. Each is two clauses: answer, or ask one more condition and hand
   its verdict on. Together they are what makes `www.altereco.media/0BF' a
   redirector token and an article slug not one, and they are the part of
   shortened_url_t/2 that decides for a host nobody has listed.

   Where a clause asks a condition, its case below is existential -- the
   verdict it asked for is a variable the call does not determine -- so even
   the contradictory cases have to introduce that witness on both sides
   before the two verdicts can be seen to disagree. */

:- lemma(opaque_shape2:boolean,
all [b0, chars, b]: succeeds r_opaque_shape2(?b0, ?chars, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_opaque_shape2(?b0, ?chars, ?b),
 [def succeeds r_opaque_shape2(?b0, ?chars, ?b) by completion,
  cases([
   case(?b0 = true & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false]),
   case(?b0 = false & succeeds r_any_t(upper, ?chars, ?b),
     [?b = true \/ ?b = false by corollary(any:boolean)])],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(opaque_shape2:functional,
all [b0, chars, b1, b2]: succeeds r_opaque_shape2(?b0, ?chars, ?b1) &
 succeeds r_opaque_shape2(?b0, ?chars, ?b2) => ?b1 = ?b2,
assume(succeeds r_opaque_shape2(?b0, ?chars, ?b1) &
  succeeds r_opaque_shape2(?b0, ?chars, ?b2),
 [def succeeds r_opaque_shape2(?b0, ?chars, ?b1) by completion,
  def succeeds r_opaque_shape2(?b0, ?chars, ?b2) by completion,
  cases([
   case(?b0 = true & ?b1 = true,
     [cases([
      case(?b0 = true & ?b2 = true,
        [?b1 = ?b2]),
      case(?b0 = false & succeeds r_any_t(upper, ?chars, ?b2),
        [ff])],
      ?b1 = ?b2)]),
   case(?b0 = false & succeeds r_any_t(upper, ?chars, ?b1),
     [cases([
      case(?b0 = true & ?b2 = true,
        [ff]),
      case(?b0 = false & succeeds r_any_t(upper, ?chars, ?b2),
        [succeeds r_any_t(upper, ?chars, ?b1) &
        succeeds r_any_t(upper, ?chars, ?b2) =>
        ?b1 = ?b2 by corollary(any:functional),
         ?b1 = ?b2])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(opaque_shape4:boolean,
all [b0, chars, b]: succeeds r_opaque_shape4(?b0, ?chars, ?b) => ?b = true \/ ?b = false,
assume(succeeds r_opaque_shape4(?b0, ?chars, ?b),
 [def succeeds r_opaque_shape4(?b0, ?chars, ?b) by completion,
  cases([
   case(?b0 = true & ?b = true,
     [?b = true,
      ?b = true \/ ?b = false]),
   case(?b0 = false & succeeds r_short_enough_t(?chars, ?b),
     [?b = true \/ ?b = false by lemma(short_enough:boolean)])],
   ?b = true \/ ?b = false)],
 ?b = true \/ ?b = false)
).

:- lemma(opaque_shape4:functional,
all [b0, chars, b1, b2]: succeeds r_opaque_shape4(?b0, ?chars, ?b1) &
 succeeds r_opaque_shape4(?b0, ?chars, ?b2) => ?b1 = ?b2,
assume(succeeds r_opaque_shape4(?b0, ?chars, ?b1) &
  succeeds r_opaque_shape4(?b0, ?chars, ?b2),
 [def succeeds r_opaque_shape4(?b0, ?chars, ?b1) by completion,
  def succeeds r_opaque_shape4(?b0, ?chars, ?b2) by completion,
  cases([
   case(?b0 = true & ?b1 = true,
     [cases([
      case(?b0 = true & ?b2 = true,
        [?b1 = ?b2]),
      case(?b0 = false & succeeds r_short_enough_t(?chars, ?b2),
        [ff])],
      ?b1 = ?b2)]),
   case(?b0 = false & succeeds r_short_enough_t(?chars, ?b1),
     [cases([
      case(?b0 = true & ?b2 = true,
        [ff]),
      case(?b0 = false & succeeds r_short_enough_t(?chars, ?b2),
        [succeeds r_short_enough_t(?chars, ?b1) &
        succeeds r_short_enough_t(?chars, ?b2) =>
        ?b1 = ?b2 by lemma(short_enough:functional),
         ?b1 = ?b2])],
      ?b1 = ?b2)])],
   ?b1 = ?b2)],
 ?b1 = ?b2)
).

:- lemma(opaque_shape3:boolean,
